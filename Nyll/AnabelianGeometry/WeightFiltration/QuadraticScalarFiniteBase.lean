import Nyll.EtaleFundamentalGroups.Cohomology.ArithmeticKernelTorsorScalar
import Nyll.EtaleFundamentalGroups.GeometricFiber.ArithmeticFieldExtensionPointedConjugacy
import Nyll.EtaleFundamentalGroups.FiniteEtale.FiniteField.ConstantFieldTower
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.NumberTheory.NumberField.Basic

/-! # Killing the original quadratic scalar on an actual finite base change

The field is chosen before the coefficient-comparison conjugator. Every
conjugate of the chosen quadratic radical lies in this same field, so the
actual pointed field-extension comparison suffices despite its inner correction.
-/
noncomputable section
open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open CategoryTheory.PreGaloisCategory EtaleFundamentalGroups

namespace AnabelianGeometry.WeightFiltration

variable (k κ : Type) [Field k] [Field κ] [Algebra k κ]

/-- The actual finite field generated by the already selected scalar radical. -/
def quadraticScalarField (β : κˣ) : IntermediateField k κ :=
  IntermediateField.adjoin k ({(β : κ)} : Set κ)

theorem quadraticScalarField_finiteDimensional [IsAlgClosure k κ] (β : κˣ) :
    FiniteDimensional k (quadraticScalarField k κ β) :=
  IntermediateField.adjoin.finiteDimensional
    (Algebra.IsIntegral.isIntegral (R := k) (β : κ))

theorem quadraticScalarField_numberField [NumberField k] [IsAlgClosure k κ] (β : κˣ) :
    NumberField (quadraticScalarField k κ β) := by
  let : FiniteDimensional k (quadraticScalarField k κ β) :=
    quadraticScalarField_finiteDimensional k κ β
  exact NumberField.of_module_finite k (quadraticScalarField k κ β)

/-- Any coefficient-comparison conjugator preserves the selected quadratic
field: the image of the original radical is that radical or its negative. -/
theorem quadraticScalarField_conjugate_mem (a : kˣ) (β : κˣ)
    (hβ : β ^ 2 = Units.map (algebraMap k κ).toMonoidHom a)
    (α : Gal(κ/k)) : α (β : κ) ∈ quadraticScalarField k κ β := by
  have hb : (β : κ) ^ 2 = algebraMap k κ (a : k) :=
    congrArg (fun z : κˣ => (z : κ)) hβ
  have he : (α (β : κ)) ^ 2 = (β : κ) ^ 2 := by
    rw [← map_pow, hb, α.commutes]
  have hm : (β : κ) ∈ quadraticScalarField k κ β :=
    IntermediateField.subset_adjoin k _ (Set.mem_singleton _)
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp he with h | h
  · rw [h]
    exact hm
  · rw [h]
    exact (quadraticScalarField k κ β).neg_mem hm

/-- The actual intermediate-base point obtained from the original κ-point. -/
def scalarFiniteBasePoint (E : IntermediateField k κ)
    (X : Scheme) (f : X ⟶ Spec (.of k))
    {Ω : Type} [Field Ω]
    (xi : Spec (.of Ω) ⟶ Limits.pullback
      (Spec.map (CommRingCat.ofHom (algebraMap k κ))) f) :
    Spec (.of Ω) ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k E))) f :=
  xi ≫ (constantFieldTowerIso k κ E X f).inv ≫
    Limits.pullback.snd (Spec.map (CommRingCat.ofHom E.val.toRingHom))
      (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k E))) f)

theorem scalarFiniteBasePoint_comp_snd (E : IntermediateField k κ)
    (X : Scheme) (f : X ⟶ Spec (.of k))
    {Ω : Type} [Field Ω]
    (xi : Spec (.of Ω) ⟶ Limits.pullback
      (Spec.map (CommRingCat.ofHom (algebraMap k κ))) f) :
    scalarFiniteBasePoint k κ E X f xi ≫
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k E))) f =
      xi ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k κ))) f := by
  dsimp only [scalarFiniteBasePoint]
  rw [Category.assoc, Category.assoc,
    ← constantFieldTowerIso_hom_snd k κ E X f]
  exact congrArg (fun g => xi ≫ g)
    ((constantFieldTowerIso k κ E X f).inv_hom_id_assoc _)

/-- On the original pointed arithmetic group, the actual finite base-change
image fixes the same scalar radical. No normalizer or quotient-label equality
is assumed: the single comparison conjugator is supplied by the existing owner. -/
theorem quadraticScalar_rootQuotient_actual_finiteBase_eq_one
    [NumberField k] [IsAlgClosure k κ]
    (a : kˣ) (β : κˣ)
    (hβ : β ^ 2 = Units.map (algebraMap k κ).toMonoidHom a)
    (X : Scheme) (f : X ⟶ Spec (.of k))
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (xi : Spec (.of Ω) ⟶ Limits.pullback
      (Spec.map (CommRingCat.ofHom (algebraMap k κ))) f) :
    let E := quadraticScalarField k κ β
    let b := Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k E))) f
    let xiE := scalarFiniteBasePoint k κ E X f xi
    let xiX := xi ≫ Limits.pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap k κ))) f
    let hp := scalarFiniteBasePoint_comp_snd k κ E X f xi
    ∀ γ : π₁ᵉᵗ(xiE),
      _root_.KummerTheory.rootQuotient (K := k) β
        (arithmeticFundamentalGroupHom k κ f xiX
          (pointedFundamentalGroupHom b xiE xiX hp γ)) = 1 := by
  intro E b xiE xiX hp γ
  let : IsAlgClosed κ := IsAlgClosure.isAlgClosed k
  let : IsSepClosure k κ := inferInstance
  let : IsSepClosure E κ := ⟨inferInstance, inferInstance⟩
  let c := Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k E))) f
  have hbase : b ≫ f = c ≫ Spec.map (CommRingCat.ofHom (algebraMap k E)) :=
    Limits.pullback.condition.symm
  obtain ⟨α, hα⟩ := arithmeticFundamentalGroupHom_fieldExtension_pointed_conjugate
    k E κ f c b hbase xiE xiX hp
  let p := arithmeticFundamentalGroupHom k κ f xiX
    (pointedFundamentalGroupHom b xiE xiX hp γ)
  have hmem : α (β : κ) ∈ E := quadraticScalarField_conjugate_mem k κ a β hβ α
  have hfix : (arithmeticFundamentalGroupHom E κ c xiE γ).restrictScalars k
      (α (β : κ)) = α (β : κ) :=
    (arithmeticFundamentalGroupHom E κ c xiE γ).commutes ⟨α (β : κ), hmem⟩
  rw [hα γ] at hfix
  change α (p (α.symm (α (β : κ)))) = α (β : κ) at hfix
  rw [α.symm_apply_apply] at hfix
  apply (_root_.KummerTheory.rootQuotient_eq_one_iff β p).mpr
  apply Units.ext
  exact α.injective hfix

end AnabelianGeometry.WeightFiltration
