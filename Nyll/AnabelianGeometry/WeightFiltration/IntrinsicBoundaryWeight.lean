import Nyll.AnabelianGeometry.WeightFiltration.CyclotomicBoundaryKernel
import Nyll.AnabelianGeometry.CuspidalInertia.PrimeToRootsOpenBoundary

/-!
# Intrinsic recognition of the actual boundary weight subgroup

The compactification kernel equals the subgroup generated by cyclotomic
homomorphisms equivariant on open Galois subgroups. The forward containment
uses number-field Jacobian Hom vanishing; the converse uses the actual
boundary sequence and finite-character detection of its permutation witnesses.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits AlgebraicCurve
open AlgebraicGeometry.FiniteEtale AlgebraicGeometry.SmoothProperCurve
open AlgebraicGeometry.RelPicard NeronModelInfra GoodReductionJacobian
open SchemeTheory EtaleFundamentalGroups.Inertia ProCGroups.Abelian

namespace AnabelianGeometry.WeightFiltration

/-- The subgroup generated by cyclotomic images equivariant on some open
subgroup of the arithmetic acting group. -/
def openCyclotomicSpan
    {Γ R A : Type*} [Group Γ] [TopologicalSpace Γ] [Group R] [Group A]
    (a : Γ → R → R) (ρ : Γ → A → A) : Subgroup A :=
  ⨆ H : OpenSubgroup Γ, ⨆ φ : R →* A,
    ⨆ (_ : ∀ σ ∈ H, ∀ t, φ (a σ t) = ρ σ (φ t)), φ.range

/-- Equivariant homomorphisms preserve the intrinsic cyclotomic span. -/
theorem openCyclotomicSpan_map_le
    {Γ R A B : Type*} [Group Γ] [TopologicalSpace Γ]
    [Group R] [Group A] [Group B]
    (a : Γ → R → R) (ρ : Γ → A → A) (ρ' : Γ → B → B)
    (f : A →* B) (hf : ∀ σ x, f (ρ σ x) = ρ' σ (f x)) :
    (openCyclotomicSpan a ρ).map f ≤ openCyclotomicSpan a ρ' := by
  apply Subgroup.map_le_iff_le_comap.mpr
  apply iSup_le
  intro H
  apply iSup_le
  intro φ
  apply iSup_le
  intro hφ
  have hcomp : ∀ σ ∈ H, ∀ t,
      (f.comp φ) (a σ t) = ρ' σ ((f.comp φ) t) := by
    intro σ hσ t
    change f (φ (a σ t)) = ρ' σ (f (φ t))
    rw [hφ σ hσ]
    exact hf σ (φ t)
  have hr : (f.comp φ).range ≤ openCyclotomicSpan a ρ' :=
    le_iSup_of_le H (le_iSup_of_le (f.comp φ) (le_iSup_of_le hcomp le_rfl))
  rintro x ⟨t, rfl⟩
  exact hr ⟨t, rfl⟩

/-- An equivariant group isomorphism identifies the intrinsic spans. -/
theorem openCyclotomicSpan_map_equiv
    {Γ R A B : Type*} [Group Γ] [TopologicalSpace Γ]
    [Group R] [Group A] [Group B]
    (a : Γ → R → R) (ρ : Γ → A → A) (ρ' : Γ → B → B)
    (e : A ≃* B) (he : ∀ σ x, e (ρ σ x) = ρ' σ (e x)) :
    (openCyclotomicSpan a ρ).map e.toMonoidHom = openCyclotomicSpan a ρ' := by
  have hinv : ∀ σ y, e.symm (ρ' σ y) = ρ σ (e.symm y) := by
    intro σ y
    apply e.injective
    rw [e.apply_symm_apply, he, e.apply_symm_apply]
  have hle := openCyclotomicSpan_map_le a ρ' ρ e.symm.toMonoidHom hinv
  apply le_antisymm (openCyclotomicSpan_map_le a ρ ρ' e.toMonoidHom he)
  intro y hy
  exact ⟨e.symm y, hle ⟨y, hy, rfl⟩, e.apply_symm_apply y⟩

variable
    (k K : Type) [Field k] [NumberField k] [Field K] [CharZero K] [IsAlgClosed K]
    [Algebra k K] [IsSepClosure k K]
    {C U : Scheme} [CompactSpace U] [QuasiSeparatedSpace U]
    (c : C ⟶ Spec (.of k)) (i : U ⟶ C)


variable
    [IsIntegral (Limits.pullback (specMap k K) (i ≫ c))] [CompactSpace ↑(Limits.pullback (specMap
      k K) (i ≫ c))]
    {F : Type} [Field F] [Algebra K F]
    (M : CurveModel K F)
    (eC : M.C ≅ pullback c (specMap k K))
    (heC : eC.hom ≫ pullback.snd c (specMap k K) = M.toBase)
    (j : (Limits.pullback (specMap k K) (i ≫ c)) ⟶ M.C) [IsOpenImmersion j] (hj : DenseRange j)
    (hproj : j ≫ eC.hom ≫ pullback.fst c (specMap k K) = pullback.snd (specMap k K) (i ≫ c) ≫ i)
    (hbase : j ≫ M.toBase = pullback.fst (specMap k K) (i ≫ c))
    [Algebra F (Limits.pullback (specMap k K) (i ≫ c)).functionField]
    (hfield : algebraMap F (Limits.pullback (specMap k K) (i ≫ c)).functionField =
      (j.functionFieldMap hj).comp M.ffEquiv.toRingHom)
    {Ω : Type} [Field Ω] [Algebra (Limits.pullback (specMap k K) (i ≫ c)).functionField Ω]
      [Algebra F Ω]
    [IsScalarTower F (Limits.pullback (specMap k K) (i ≫ c)).functionField Ω]
    [IsSepClosed Ω] [IsSepClosure (Limits.pullback (specMap k K) (i ≫ c)).functionField Ω]
      [IsSepClosure F Ω]
    [∀ p : M.openBoundaryPlaces j, Algebra p.val.toValuationSubring Ω]
    [∀ p : M.openBoundaryPlaces j, IsScalarTower p.val.toValuationSubring F Ω]
    [Algebra K Ω]
    [∀ p : M.openBoundaryPlaces j, IsScalarTower K p.val.toValuationSubring Ω]
    (Q : ∀ p : M.openBoundaryPlaces j,
      Ideal (normalizationCommAlgCat p.val.toValuationSubring Ω))
    [∀ p, (Q p).IsMaximal]

variable
    [CompactSpace C] [QuasiSeparatedSpace C]
    [IsProper c] [SmoothOfRelativeDimension 1 c] [GeometricallyIntegral c]
    [Algebra.EssFiniteType K F] [IsCurveOver K F] [IsAlgClosed Ω]
    [hfin : Finite (M.openBoundaryPlaces j)]


include eC heC hj hproj hbase hfield Q hfin in
/-- The actual boundary kernel is exactly the subgroup intrinsically
generated by cyclotomic images on open arithmetic subgroups. -/
theorem compactification_kernel_eq_openCyclotomicSpan
    (ε : SchemeHomOver (𝟙 (Spec (.of k))) c)
    (D : RelativePic0Designation k c)
    (hD : RepresentsRelSubPic c ε (algEquivZeroCut c ε) D)
    [Smooth D.toBase] [IsProper D.toBase] [GeometricallyConnected D.toBase] :
    let : IsIntegral (pullback c (specMap k K)) :=
      isIntegral_pullback_Spec_field k c (specMap k K)
    let : IsIntegral (pullback (specMap k K) c) :=
      IsIntegral.of_isIso (pullbackSymmetry c (specMap k K)).hom
    let J := EtaleFundamentalGroups.coefficientModelMap (specMap k K) c i
    let η := Spec.map (CommRingCat.ofHom
      (algebraMap (pullback (specMap k K) (i ≫ c)).functionField Ω))
    let xi := η ≫ (pullback (specMap k K) (i ≫ c)).fromSpecStalk
      (genericPoint (↑(pullback (specMap k K) (i ≫ c)) : Type))
    (compactificationAbelianizationMap J xi).toMonoidHom.ker =
      openCyclotomicSpan
        (fun σ : K ≃ₐ[k] K => primeToRootsCoefficientMap K K σ.toRingHom)
        (fun σ => geometricAbelianGaloisAction k K U (i ≫ c) xi σ) := by
  intro hY hYL J η xi
  classical
  let := Fintype.ofFinite (M.openBoundaryPlaces j)
  have : IsAlgClosure k K := ⟨inferInstance, inferInstance⟩
  let S := M.openBoundaryPlaces j
  let R := (primeToRootsSystem K K).inverseLimit
  let A := TopologicalAbelianization (Aut (fiber xi))
  let a : (K ≃ₐ[k] K) → R → R :=
    fun σ => primeToRootsCoefficientMap K K σ.toRingHom
  let act := geometricAbelianGaloisAction k K U (i ≫ c) xi
  let W : Subgroup A := openCyclotomicSpan a (fun σ => act σ)
  let q := compactificationAbelianizationMap J xi
  change q.toMonoidHom.ker = W
  apply le_antisymm
  · obtain ⟨E, α, ρ, ι, hi, _, hir, hbker, _, hρcont, _, hιeq, hιcorr, hactual⟩ :=
      exists_arithmetic_boundary_Galois_sequence
        k K c i M eC heC j hj hproj hbase hfield Q ε D hD
    let b := boundaryInertiaMap M j hj hfield Q
    let τ := (ContinuousMonoidHom.toContinuousMonoidHom E).comp q
    have hτker : τ.toMonoidHom.ker = q.toMonoidHom.ker :=
      MonoidHom.ker_comp_of_injective q.toMonoidHom E.toMonoidHom E.injective
    have hsingle (p : S) (t : R) :
        b (fun s : S => if s = p then t else 1) =
          boundaryPlaceInertiaHom M j hj hfield Q p t := by
      have hs : (fun s : S => if s = p then t else 1) = Pi.mulSingle p t := by
        funext s
        by_cases h : s = p <;> simp [h]
      rw [hs]
      change MonoidHom.noncommPiCoprod
        (fun p => (boundaryPlaceInertiaHom M j hj hfield Q p).toMonoidHom)
        (fun _ _ _ _ _ => Commute.all _ _) (Pi.mulSingle p t) = _
      exact MonoidHom.noncommPiCoprod_mulSingle
        (fun p : S => (boundaryPlaceInertiaHom M j hj hfield Q p).toMonoidHom) p t
    let corr := (act α⁻¹).toMonoidHom
    let bp := fun p : S => (boundaryPlaceInertiaHom M j hj hfield Q p).toMonoidHom
    let ψ := fun p : S => corr.comp (bp p)
    have hcorrect (p : S) (t : R) :
        ι (QuotientGroup.mk (fun s : S => if s = p then t else 1)) = ψ p t :=
      (hιcorr _).trans (congrArg (act α⁻¹) (hsingle p t))
    have hperm : ∀ σ : K ≃ₐ[k] K, ∃ f : S → S, ∀ (p : S) (t : R),
        ρ σ (QuotientGroup.mk (fun s : S => if s = p then t else 1)) =
          QuotientGroup.mk (fun s : S => if s = f p then a σ t else 1) := by
      intro σ
      obtain ⟨g, _, hS, hgcoord⟩ := hactual σ
      let f : S → S := fun p => ⟨g • p.val, (hS p.val).mp p.property⟩
      refine ⟨f, ?_⟩
      intro p t
      apply hi
      calc
        ι (ρ σ (QuotientGroup.mk (fun s : S => if s = p then t else 1))) =
            act σ (ι (QuotientGroup.mk (fun s : S => if s = p then t else 1))) :=
          hιeq σ _
        _ = act σ (ψ p t) := congrArg (act σ) (hcorrect p t)
        _ = ψ (f p) (a σ t) := by
          simpa only [ψ, corr, bp, act, a, f, xi, η, MonoidHom.comp_apply,
            MulEquiv.coe_toMonoidHom, ContinuousMonoidHom.coe_toMonoidHom,
            MonoidHom.coe_ofClass] using hgcoord p t
        _ = ι (QuotientGroup.mk (fun s : S => if s = f p then a σ t else 1)) :=
          (hcorrect (f p) (a σ t)).symm
    have hopen : ∃ H : OpenSubgroup (K ≃ₐ[k] K), ∀ σ ∈ H, ∀ (p : S) (t : R),
        ρ σ (QuotientGroup.mk (fun s : S => if s = p then t else 1)) =
          QuotientGroup.mk (fun s : S => if s = p then a σ t else 1) := by
      by_cases hS : Nonempty S
      · exact CuspidalInertia.exists_open_actual_roots_boundary_equivariance_of_diagonal_relation
          k K S (Classical.choice hS) b.toMonoidHom.ker hbker ρ
          (fun z => hρcont.comp (continuous_id.prodMk continuous_const)) hperm
      · refine ⟨⊤, ?_⟩
        intro σ hσ p t
        exact False.elim (hS ⟨p⟩)
    obtain ⟨H, hH⟩ := hopen
    have hψ (p : S) : ∀ σ ∈ H, ∀ t, ψ p (a σ t) = act σ (ψ p t) := by
      intro σ hσ t
      calc
        ψ p (a σ t) =
            ι (QuotientGroup.mk (fun s : S => if s = p then a σ t else 1)) :=
          (hcorrect p (a σ t)).symm
        _ = ι (ρ σ (QuotientGroup.mk (fun s : S => if s = p then t else 1))) :=
          (congrArg ι (hH σ hσ p t)).symm
        _ = act σ (ι (QuotientGroup.mk (fun s : S => if s = p then t else 1))) :=
          hιeq σ _
        _ = act σ (ψ p t) := congrArg (act σ) (hcorrect p t)
    have hψrange (p : S) : (ψ p).range ≤ W :=
      le_iSup_of_le H (le_iSup_of_le (ψ p) (le_iSup_of_le (hψ p) le_rfl))
    have hbRange : b.toMonoidHom.range = ⨆ p : S, (bp p).range :=
      MonoidHom.noncommPiCoprod_range
        (fun p => (boundaryPlaceInertiaHom M j hj hfield Q p).toMonoidHom)
        (hcomm := fun _ _ _ _ _ => Commute.all _ _)
    let qB := QuotientGroup.mk' b.toMonoidHom.ker
    have hcomp : ι.toMonoidHom.comp qB = corr.comp b.toMonoidHom := by
      apply MonoidHom.ext
      intro t
      exact hιcorr t
    have hcorrectedRange : (corr.comp b.toMonoidHom).range = τ.toMonoidHom.ker := by
      rw [← hcomp, MonoidHom.range_comp,
        MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective b.toMonoidHom.ker),
        Subgroup.map_top]
      exact hir
    have hrange : (⨆ p : S, (ψ p).range) = q.toMonoidHom.ker := by
      calc
        (⨆ p : S, (ψ p).range) = (⨆ p : S, (bp p).range).map corr := by
          simp only [ψ, MonoidHom.range_comp, Subgroup.map_iSup]
        _ = b.toMonoidHom.range.map corr := by rw [hbRange]
        _ = (corr.comp b.toMonoidHom).range := (MonoidHom.range_comp _ _).symm
        _ = τ.toMonoidHom.ker := hcorrectedRange
        _ = q.toMonoidHom.ker := hτker
    rw [← hrange]
    exact iSup_le hψrange
  · apply iSup_le
    intro H
    apply iSup_le
    intro φ
    apply iSup_le
    intro hφ
    exact cyclotomicHom_range_le_compactification_kernel_of_open_subgroup
      k K c i M eC heC j hj hproj hbase hfield Q ε D hD H φ hφ


include eC heC hj hproj hbase hfield Q hfin in
/-- The same intrinsic subgroup is the kernel of the original CurveModel
compactification map used by finite residues. -/
theorem curveModel_kernel_eq_openCyclotomicSpan
    (ε : SchemeHomOver (𝟙 (Spec (.of k))) c)
    (D : RelativePic0Designation k c)
    (hD : RepresentsRelSubPic c ε (algEquivZeroCut c ε) D)
    [Smooth D.toBase] [IsProper D.toBase] [GeometricallyConnected D.toBase] :
    let η := Spec.map (CommRingCat.ofHom
      (algebraMap (pullback (specMap k K) (i ≫ c)).functionField Ω))
    let xi := η ≫ (pullback (specMap k K) (i ≫ c)).fromSpecStalk
      (genericPoint (↑(pullback (specMap k K) (i ≫ c)) : Type))
    (compactificationAbelianizationMap j xi).toMonoidHom.ker =
      openCyclotomicSpan
        (fun σ : K ≃ₐ[k] K => primeToRootsCoefficientMap K K σ.toRingHom)
        (fun σ => geometricAbelianGaloisAction k K U (i ≫ c) xi σ) := by
  intro η xi
  let := Fintype.ofFinite (M.openBoundaryPlaces j)
  have : IsIntegral (pullback c (specMap k K)) :=
    isIntegral_pullback_Spec_field k c (specMap k K)
  have : IsIntegral (pullback (specMap k K) c) :=
    IsIntegral.of_isIso (pullbackSymmetry c (specMap k K)).hom
  let J := EtaleFundamentalGroups.coefficientModelMap (specMap k K) c i
  let q := compactificationAbelianizationMap J xi
  obtain ⟨E, _, hbrange, _, _, _⟩ := exists_arithmetic_boundary_Tate_map
    k K c i M eC heC j hj hproj hbase hfield Q ε D hD
  calc
    (compactificationAbelianizationMap j xi).toMonoidHom.ker =
        (boundaryInertiaMap M j hj hfield Q).toMonoidHom.range :=
      (boundaryInertiaMap_range M j hj hfield Q).symm
    _ = ((ContinuousMonoidHom.toContinuousMonoidHom E).comp q).toMonoidHom.ker := hbrange
    _ = q.toMonoidHom.ker :=
      MonoidHom.ker_comp_of_injective q.toMonoidHom E.toMonoidHom E.injective
    _ = _ := compactification_kernel_eq_openCyclotomicSpan
      k K c i M eC heC j hj hproj hbase hfield Q ε D hD

end AnabelianGeometry.WeightFiltration
