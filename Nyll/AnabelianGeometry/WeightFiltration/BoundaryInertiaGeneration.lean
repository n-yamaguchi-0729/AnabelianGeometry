/-!
# Boundary inertia generates the actual abelian compactification kernel

Finite residue characters identify the closed subgroup generated by the
original place-inertia images with the actual compactification kernel.
Finite Kummer character separation and open-normal quotient separation are
reused directly. No circle-valued coefficient comparison is constructed.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory AlgebraicCurve
open SchemeTheory EtaleFundamentalGroups.Inertia EtaleFundamentalGroups.Cohomology
open ProCGroups.Abelian ProCGroups.ProC

namespace AnabelianGeometry.WeightFiltration

/-- Finite root characters detect membership in a closed profinite subgroup. -/
theorem mem_closedSubgroup_of_rootCharacters
    (K : Type*) [Field K] [IsSepClosed K] [CharZero K]
    {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [TotallyDisconnectedSpace G]
    (H : ClosedSubgroup G) (y : G)
    (h : ∀ n : ℕ+, let _ : TopologicalSpace (rootsOfUnity (n : ℕ) K) := ⊥;
      ∀ χ : G →ₜ* rootsOfUnity (n : ℕ) K,
        (H : Subgroup G) ≤ χ.toMonoidHom.ker → χ y = 1) :
    y ∈ (H : Subgroup G) := by
  apply mem_closedSubgroup_of_forall_openNormal_sup H
  intro U
  by_contra hnot
  let V := openNormalSubgroup_sup_normal (H : Subgroup G) U
  let Q := G ⧸ (V : Subgroup G)
  let q := ProCGroups.ProC.OpenNormalSubgroup.quotientProj V
  have hq : q y ≠ 1 := by
    intro he
    exact hnot (ProCGroups.ProC.OpenNormalSubgroup.quotientProj_eq_one_iff.mp he)
  let n : ℕ+ := ⟨Nat.card Q, Nat.card_pos⟩
  let : NeZero ((n : ℕ) : K) := ⟨Nat.cast_ne_zero.mpr n.ne_zero⟩
  obtain ⟨z, hz⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K (n : ℕ)
  have hmu : (primitiveRoots (n : ℕ) K).Nonempty :=
    ⟨z, (mem_primitiveRoots n.pos).mpr hz⟩
  obtain ⟨ψ, hψ⟩ := KummerTheory.exists_nthRoots_character_apply_ne_one
    (G := Q) (K := K) n hmu (fun a => pow_card_eq_one' (x := a)) hq
  let e := KummerTheory.nthRootsSubgroupEquivRootsOfUnity K (n : ℕ)
  let : TopologicalSpace (rootsOfUnity (n : ℕ) K) := ⊥
  let ψc : Q →ₜ* rootsOfUnity (n : ℕ) K :=
    ⟨e.toMonoidHom.comp ψ, continuous_of_discreteTopology⟩
  let χ := ψc.comp q
  have hH : (H : Subgroup G) ≤ χ.toMonoidHom.ker := by
    intro a ha
    have hle : (H : Subgroup G) ≤ (H : Subgroup G) ⊔ (U : Subgroup G) :=
      le_sup_left
    have haV : a ∈ (V : Subgroup G) := hle ha
    have ha0 : q a = 1 :=
      ProCGroups.ProC.OpenNormalSubgroup.quotientProj_eq_one_iff.mpr haV
    change ψc (q a) = 1
    rw [ha0, map_one]
  have hv := h n χ hH
  change e (ψ (q y)) = 1 at hv
  apply hψ
  apply e.injective
  change e (ψ (q y)) = e 1
  simpa only [map_one] using hv

/-- Finite root characters detect inclusion of closed profinite subgroups. -/
theorem closedSubgroup_le_of_rootCharacters
    (K : Type*) [Field K] [IsSepClosed K] [CharZero K]
    {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [TotallyDisconnectedSpace G]
    (H J : ClosedSubgroup G)
    (h : ∀ n : ℕ+, let _ : TopologicalSpace (rootsOfUnity (n : ℕ) K) := ⊥;
      ∀ χ : G →ₜ* rootsOfUnity (n : ℕ) K,
        (H : Subgroup G) ≤ χ.toMonoidHom.ker → (J : Subgroup G) ≤ χ.toMonoidHom.ker) :
    (J : Subgroup G) ≤ (H : Subgroup G) := by
  intro y hy
  apply mem_closedSubgroup_of_rootCharacters K H y
  intro n topology χ hH
  exact h n χ hH hy

/-- The actual abelian compactification kernel is the closed span of boundary inertia images. -/
theorem compactificationAbelianization_ker_eq_boundaryInertia_closure
    {K F : Type} [Field K] [CharZero K] [IsAlgClosed K] [Field F] [Algebra K F]
    [Algebra.EssFiniteType K F] [IsCurveOver K F]
    (M : CurveModel K F)
    {X : Scheme} [IsIntegral X] [CompactSpace X]
    (j : X ⟶ M.C) [IsOpenImmersion j] (hj : DenseRange j)
    [Algebra F X.functionField]
    (hfield : algebraMap F X.functionField = (j.functionFieldMap hj).comp M.ffEquiv.toRingHom)
    {Ω : Type} [Field Ω] [Algebra X.functionField Ω] [Algebra F Ω]
    [IsScalarTower F X.functionField Ω]
    [IsSepClosed Ω] [IsSepClosure X.functionField Ω] [IsSepClosure F Ω]
    [∀ p : M.openBoundaryPlaces j, Algebra p.val.toValuationSubring Ω]
    [∀ p : M.openBoundaryPlaces j, IsScalarTower p.val.toValuationSubring F Ω]
    [Algebra K Ω]
    [∀ p : M.openBoundaryPlaces j, IsScalarTower K p.val.toValuationSubring Ω]
    (Q : ∀ p : M.openBoundaryPlaces j,
      Ideal (normalizationCommAlgCat p.val.toValuationSubring Ω))
    [∀ p, (Q p).IsMaximal] :
    let η := Spec.map (CommRingCat.ofHom (algebraMap X.functionField Ω))
    let ξ := η ≫ X.fromSpecStalk (genericPoint X)
    (compactificationAbelianizationMap j ξ).toMonoidHom.ker =
      (⨆ p : M.openBoundaryPlaces j,
        (genericPlaceInertia X p.val (Q p)).map
          (TopologicalAbelianization.mk (Aut (FiniteEtale.fiber ξ)))).topologicalClosure := by
  intro η ξ
  let G := Aut (FiniteEtale.fiber ξ)
  let P := TopologicalAbelianization G
  let : TotallyDisconnectedSpace P :=
    ProCGroups.totallyDisconnectedSpace_quotient_closedNormal
      (Subgroup.closedCommutator G) (Subgroup.isClosed_closedCommutator G)
  let mk : G →* P := TopologicalAbelianization.mk G
  let I : Subgroup P := ⨆ p : M.openBoundaryPlaces j,
    (genericPlaceInertia X p.val (Q p)).map mk
  let W : ClosedSubgroup P := ⟨I.topologicalClosure, I.isClosed_topologicalClosure⟩
  let f := compactificationAbelianizationMap j ξ
  let V : ClosedSubgroup P := ⟨f.toMonoidHom.ker,
    ProCGroups.ContinuousMonoidHom.isClosed_ker f⟩
  have : Smooth M.toBase := SmoothOfRelativeDimension.smooth 1 M.toBase
  have : IsIntegrallyClosed Γ(Spec (.of K), ⊤) := IsIntegrallyClosed.of_equiv
    (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv
  have : IsNormalIntegral M.C := IsNormalIntegral.of_stalks M.C
    (fun z => (Smooth.isDomain_and_isIntegrallyClosed_stalk M.toBase z).2)
  have : IsLocallyNoetherian M.C := LocallyOfFiniteType.isLocallyNoetherian M.toBase
  have hc (n : ℕ+) : let _ : TopologicalSpace (rootsOfUnity (n : ℕ) K) := ⊥;
      ∀ χ : P →ₜ* rootsOfUnity (n : ℕ) K,
        (W : Subgroup P) ≤ χ.toMonoidHom.ker ↔
          (V : Subgroup P) ≤ χ.toMonoidHom.ker := by
    intro topology χ
    let : DiscreteTopology (rootsOfUnity (n : ℕ) K) := ⟨rfl⟩
    let : NeZero (n : ℕ) := ⟨n.ne_zero⟩
    let A := AddCommGrpCat.of (Additive (rootsOfUnity (n : ℕ) K))
    have hn : IsUnit ((n : ℕ) : K) := isUnit_iff_ne_zero.mpr
      (Nat.cast_ne_zero.mpr n.ne_zero)
    obtain ⟨a, ha⟩ := h1Character_surjective A ξ
      (χ.comp (TopologicalAbelianization.mkₜ G))
    have he : (h1Character A ξ a).toMonoidHom = χ.toMonoidHom.comp mk :=
      congrArg ContinuousMonoidHom.toMonoidHom ha
    have hW : (W : Subgroup P) ≤ χ.toMonoidHom.ker ↔
        ∀ p : M.openBoundaryPlaces j,
          genericPlaceInertia X p.val (Q p) ≤ (h1Character A ξ a).toMonoidHom.ker := by
      rw [he]
      constructor
      · intro h p g hg
        exact h (I.le_topologicalClosure
          ((le_iSup (fun p : M.openBoundaryPlaces j =>
            (genericPlaceInertia X p.val (Q p)).map mk) p) ⟨g, hg, rfl⟩))
      · intro h
        apply I.topologicalClosure_minimal ?_
          (ProCGroups.ContinuousMonoidHom.isClosed_ker χ)
        apply iSup_le
        intro p g hg
        obtain ⟨x, hx, rfl⟩ := hg
        exact h p hx
    have hV : (V : Subgroup P) ≤ χ.toMonoidHom.ker ↔
        (FiniteEtale.fundamentalGroupHom j ξ).toMonoidHom.ker ≤
          (h1Character A ξ a).toMonoidHom.ker := by
      change (compactificationAbelianizationMap j ξ).toMonoidHom.ker ≤ _ ↔ _
      rw [compactificationAbelianizationMap_ker, he]
      exact Subgroup.map_le_iff_le_comap
    rw [hW, hV]
    constructor
    · intro h
      apply (finiteResidue_eq_zero_iff_character_ker_le M n j hj hn ξ a).mp
      ext p
      exact (finiteResidue_apply_eq_zero_iff_inertia_le_ker
        M n j hj hn hfield p (Q p) a).mpr (h p)
    · intro h p
      apply (finiteResidue_apply_eq_zero_iff_inertia_le_ker
        M n j hj hn hfield p (Q p) a).mp
      exact congrFun ((finiteResidue_eq_zero_iff_character_ker_le
        M n j hj hn ξ a).mpr h) p
  apply le_antisymm
  · exact closedSubgroup_le_of_rootCharacters K W V (fun n => by
      intro topology χ hχ
      exact (hc n χ).mp hχ)
  · exact closedSubgroup_le_of_rootCharacters K V W (fun n => by
      intro topology χ hχ
      exact (hc n χ).mpr hχ)

end AnabelianGeometry.WeightFiltration
