import Nyll.AnabelianGeometry.WeightFiltration.BareRationalArithmeticSquareFiniteBase
import Nyll.AnabelianGeometry.WeightFiltration.BareRationalMatchedFiniteBaseTransport
import Nyll.AnabelianGeometry.WeightFiltration.NamedSquareFiniteBaseFiberTransport
import Nyll.AnabelianGeometry.WeightFiltration.QuadraticScalarCanonicalBaseEquivariance
import Nyll.AnabelianGeometry.WeightFiltration.QuadraticBoundaryFieldInvariance

/-! # Transport over the common field generated by the boundary roots -/

noncomputable section
open CategoryTheory AlgebraicGeometry AlgebraicCurve
open AlgebraicGeometry.FiniteEtale AlgebraicGeometry.ProjSpace
open CategoryTheory.PreGaloisCategory EtaleFundamentalGroups.Cohomology
open scoped FintypeCatDiscrete
namespace AnabelianGeometry.WeightFiltration
attribute [local instance] MvPolynomial.gradedAlgebra Polynomial.algebra

local instance commonPointedRootOverCategory (S : Scheme) :
    Category (MorphismProperty.Over (@IsFiniteEtale : MorphismProperty Scheme) ⊤ S) :=
  AlgebraicGeometry.FiniteEtale.instCategory S
local instance commonPointedRootHasPullbacksAlong {S T : Scheme} (f : S ⟶ T) :
    MorphismProperty.HasPullbacksAlong (@IsFiniteEtale : MorphismProperty Scheme) f :=
  ⟨fun _ _ ↦ inferInstance⟩
local instance commonPointedRootStableUnderBaseChangeAlong {S T : Scheme} (f : S ⟶ T) :
    MorphismProperty.IsStableUnderBaseChangeAlong (@IsFiniteEtale : MorphismProperty Scheme) f :=
  ⟨fun h hf ↦ MorphismProperty.of_isPullback
    (P := (@IsFiniteEtale : MorphismProperty Scheme)) h hf⟩

local instance commonPointedRootChart_isOpenImmersion
    (k : Type) [Field k] (s : Finset (Projectivization k (k × k))) :
    IsOpenImmersion (show (rationalConfigurationOpen s : Scheme) ⟶
      (projectiveLineRatFuncModel k).C from (rationalConfigurationOpen s).ι) := by
  change IsOpenImmersion (rationalConfigurationOpen s).ι
  infer_instance

theorem namedSquare_originalScalar_exists_commonRootField_pointed_transport
    (k κ : Type) [Field k] [NumberField k] [Field κ] [CharZero κ]
    [Algebra k κ] [IsAlgClosed κ] [IsAlgClosure k κ]
    (s t : Finset (Projectivization k (k × k)))
    (Ωs Ωt : Type) [Field Ωs] [Field Ωt] [IsAlgClosed Ωs] [IsAlgClosed Ωt]
    [Algebra (rationalConfigurationGeometricScheme k κ s).functionField Ωs]
    [Algebra (rationalConfigurationGeometricScheme k κ t).functionField Ωt]
    [IsAlgClosure (rationalConfigurationGeometricScheme k κ s).functionField Ωs]
    [IsAlgClosure (rationalConfigurationGeometricScheme k κ t).functionField Ωt]
    (us : Pic0.openKummerUnits k (RatFunc k)
      ((projectiveLineRatFuncModel k).openBoundaryPlaces (rationalConfigurationOpen s).ι)
      (2 : ℕ+))
    (ut : Pic0.openKummerUnits k (RatFunc k)
      ((projectiveLineRatFuncModel k).openBoundaryPlaces (rationalConfigurationOpen t).ι)
      (2 : ℕ+))
    (α : rationalConfigurationArithmeticGroup k κ s Ωs ≃ₜ*
      rationalConfigurationArithmeticGroup k κ t Ωt)
    (hα : ∀ g, arithmeticFundamentalGroupHom k κ ((rationalConfigurationOpen t).ι ≫ π k 1)
        (rationalConfigurationArithmeticBasePoint k κ t Ωt) (α g) =
      arithmeticFundamentalGroupHom k κ ((rationalConfigurationOpen s).ι ≫ π k 1)
        (rationalConfigurationArithmeticBasePoint k κ s Ωs) g)
    (H : RationalConfigurationArithmeticSquareTransportWithFiniteBase k κ s t Ωs Ωt us ut α)
    (ρS : s → κ) (ρT : t → κ)
    (hρS : ∀ x : s, ρS x ^ 2 = algebraMap k κ
      ((literalRationalPuncturePlace k x.val.rep x.val.rep_nonzero).evalAt
        (us.val : RatFunc k)))
    (hρT : ∀ x : t, ρT x ^ 2 = algebraMap k κ
      ((literalRationalPuncturePlace k x.val.rep x.val.rep_nonzero).evalAt
        (ut.val : RatFunc k))) :
    let fs := (rationalConfigurationOpen s).ι ≫ π k 1
    let ft := (rationalConfigurationOpen t).ι ≫ π k 1
    let xs := rationalConfigurationArithmeticBasePoint k κ s Ωs
    let xt := rationalConfigurationArithmeticBasePoint k κ t Ωt
    let hn : IsUnit ((2 : ℕ) : k) :=
      isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr (show (2 : ℕ) ≠ 0 from by decide))
    let M := projectiveLineRatFuncModel k
    let AS := M.openKummerCover (M.openBoundaryPlaces (rationalConfigurationOpen s).ι)
      (2 : ℕ+) hn us (rationalConfigurationOpen s).ι
      (rationalConfigurationOpen_denseRange k s)
      (M.place_not_mem_openBoundaryPlaces (rationalConfigurationOpen s).ι)
    let AT := M.openKummerCover (M.openBoundaryPlaces (rationalConfigurationOpen t).ι)
      (2 : ℕ+) hn ut (rationalConfigurationOpen t).ι
      (rationalConfigurationOpen_denseRange k t)
      (M.place_not_mem_openBoundaryPlaces (rationalConfigurationOpen t).ι)
    ∃ (a : kˣ) (β : κˣ), β ^ 2 = Units.map (algebraMap k κ).toMonoidHom a ∧
      let E := quadraticBoundaryCoordinateField k κ β (Sum.elim ρS ρT)
      let _hFD : FiniteDimensional k E :=
        quadraticBoundaryCoordinateField_finiteDimensional k κ β (Sum.elim ρS ρT)
      let _hsep : Algebra.IsSeparable k E := inferInstance
      let _hFE : IsFiniteEtale (Spec.map (CommRingCat.ofHom (algebraMap k E))) :=
        constantField_specMap_isFiniteEtale k E
      let _hEC : IsSepClosure E κ :=
        ⟨IsSepClosure.sep_closed k, Algebra.isSeparable_tower_top_of_isSeparable k E κ⟩
      let ys : Spec (.of Ωs) ⟶ Limits.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap k E))) fs :=
        arithmeticConstantFieldLift k E κ fs xs
      let yt : Spec (.of Ωt) ⟶ Limits.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap k E))) ft :=
        arithmeticConstantFieldLift k E κ ft xt
      let bs : Limits.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap k E))) fs ⟶
          (rationalConfigurationOpen s : Scheme) :=
        ((pullback fs).obj (originalConstantFieldCover k E)).hom
      let bt : Limits.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap k E))) ft ⟶
          (rationalConfigurationOpen t : Scheme) :=
        ((pullback ft).obj (originalConstantFieldCover k E)).hom
      let hs := arithmeticConstantFieldLift_comp k E κ fs xs
      let ht := arithmeticConstantFieldLift_comp k E κ ft xt
      let αE : π₁ᵉᵗ(ys) ≃ₜ* π₁ᵉᵗ(yt) :=
        arithmeticConstantFieldCoverGroupTransport k E κ fs ft xs xt α hα
      ∃ (rS : s → E) (rT : t → E),
        (∀ x : s, (rS x : κ) = ρS x) ∧ (∀ x : t, (rT x : κ) = ρT x) ∧
        (∀ x : s, rS x ^ 2 = algebraMap k E
          ((literalRationalPuncturePlace k x.val.rep x.val.rep_nonzero).evalAt
            (us.val : RatFunc k))) ∧
        (∀ x : t, rT x ^ 2 = algebraMap k E
          ((literalRationalPuncturePlace k x.val.rep x.val.rep_nonzero).evalAt
            (ut.val : RatFunc k))) ∧
      ∃ (θ : (fiber xt).obj
          ((coverTransportOfAutEquiv (fiber xs) (fiber xt) α).functor.obj AS) ≃
        (fiber xt).obj AT)
        (x₀ : (fiber xt).obj
          ((coverTransportOfAutEquiv (fiber xs) (fiber xt) α).functor.obj AS)),
        let wE : (fiber ys).obj ((pullback bs).obj AS) :=
          (pointedPullbackFiberEquiv bs ys xs hs AS).symm
            (coverTransportFiberEquiv (fiber xs) (fiber xt) α AS x₀)
        let cs := Limits.pullback.fst (originalConstantFieldCover k E).hom fs
        let ct := Limits.pullback.fst (originalConstantFieldCover k E).hom ft
        let GS := Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap E κ))) cs
        let GT := Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap E κ))) ct
        let _hGS : IsIntegral GS := rationalConfiguration_coefficientTower_isIntegral k E κ s
        let _hGT : IsIntegral GT := rationalConfiguration_coefficientTower_isIntegral k E κ t
        ∃ (jS : κ →+* Ωs) (aS : GS.functionField →+* Ωs)
          (jT : κ →+* Ωt) (aT : GT.functionField →+* Ωt),
          jS.comp (algebraMap E κ) = (Spec.preimage (ys ≫ cs)).hom ∧
          jT.comp (algebraMap E κ) = (Spec.preimage (yt ≫ ct)).hom ∧
          let _A_S : Algebra GS.functionField Ωs := aS.toAlgebra
          let _A_T : Algebra GT.functionField Ωt := aT.toAlgebra
          IsAlgClosure GS.functionField Ωs ∧ IsAlgClosure GT.functionField Ωt ∧
          GS.genericExtensionMorphism Ωs ≫ Limits.pullback.fst _ cs =
            Spec.map (CommRingCat.ofHom jS) ∧
          GT.genericExtensionMorphism Ωt ≫ Limits.pullback.fst _ ct =
            Spec.map (CommRingCat.ofHom jT) ∧
          GS.genericExtensionMorphism Ωs ≫ Limits.pullback.snd _ cs = ys ∧
          GT.genericExtensionMorphism Ωt ≫ Limits.pullback.snd _ ct = yt ∧
        ∃ c : π₁ᵉᵗ(yt),
        let eE := namedSquareFiniteBaseFiberEquiv bs bt ys yt xs xt hs ht α AS AT θ
        (∀ g, arithmeticFundamentalGroupHom E κ
          (Limits.pullback.fst (originalConstantFieldCover k E).hom ft) yt
          (ProCGroups.innerCorrectedGroupEquiv αE c g) =
            arithmeticFundamentalGroupHom E κ
              (Limits.pullback.fst (originalConstantFieldCover k E).hom fs) ys g) ∧
        fiberEquivariant ys yt ((pullback bs).obj AS) ((pullback bt).obj AT)
          (ProCGroups.innerCorrectedGroupEquiv αE c)
          (ProCGroups.innerCorrectedFiberEquiv eE c) ∧
        pointedPullbackFiberEquiv bs ys xs hs AS wE =
          coverTransportFiberEquiv (fiber xs) (fiber xt) α AS x₀ := by
  intro fs ft xs xt hn M AS AT
  let : Algebra (rationalConfigurationOpen s : Scheme).functionField Ωs :=
    rationalConfigurationOriginalAmbientAlgebra k κ s Ωs
  let : Algebra (rationalConfigurationOpen t : Scheme).functionField Ωt :=
    rationalConfigurationOriginalAmbientAlgebra k κ t Ωt
  let : Algebra (RatFunc k) Ωs := rationalConfigurationArithmeticAmbientAlgebra k κ s Ωs
  let : Algebra (RatFunc k) Ωt := rationalConfigurationArithmeticAmbientAlgebra k κ t Ωt
  let : Algebra κ Ωs := rationalConfigurationConstantAmbientAlgebra k κ s Ωs
  let : Algebra κ Ωt := rationalConfigurationConstantAmbientAlgebra k κ t Ωt
  let : IsSepClosure (rationalConfigurationOpen s : Scheme).functionField Ωs :=
    (rationalConfigurationOriginalField_suppliers k κ s Ωs).2.2.2.2.1
  let : IsSepClosure (rationalConfigurationOpen t : Scheme).functionField Ωt :=
    (rationalConfigurationOriginalField_suppliers k κ t Ωt).2.2.2.2.1
  obtain ⟨ts, tt, _hrootS, _hrootT, _hSsemi, hTsemi, hEsemi,
    θ, hθμ, _hθgeom, x₀, a, β, hβ, hdisp, _hscalarIso⟩ := H
  let : Torsor (rootsOfUnity 2 κ) ((fiber xs).obj AS) := ts
  let : Torsor (rootsOfUnity 2 κ) ((fiber xt).obj AT) := tt
  let : Torsor (rootsOfUnity 2 κ) ((fiber xt).obj
      ((coverTransportOfAutEquiv (fiber xs) (fiber xt) α).functor.obj AS)) :=
    transportedFiberTorsor (coverTransportFiberEquiv (fiber xs) (fiber xt) α AS)
  refine ⟨a, β, hβ, ?_⟩
  intro E hFD hsep hFE hEC ys yt bs bt hs ht αE
  let v : Sum s t → k := Sum.elim
    (fun x : s => (literalRationalPuncturePlace k x.val.rep x.val.rep_nonzero).evalAt
      (us.val : RatFunc k))
    (fun x : t => (literalRationalPuncturePlace k x.val.rep x.val.rep_nonzero).evalAt
      (ut.val : RatFunc k))
  have hρ : ∀ x : Sum s t, Sum.elim ρS ρT x ^ 2 = algebraMap k κ (v x) := by
    intro x
    cases x with
    | inl x => exact hρS x
    | inr x => exact hρT x
  let r := quadraticBoundaryRoot k κ β (Sum.elim ρS ρT)
  refine ⟨(fun x => r (Sum.inl x)), (fun x => r (Sum.inr x)), ?_, ?_, ?_, ?_, θ, x₀, ?_⟩
  · intro x
    rfl
  · intro x
    rfl
  · intro x
    exact quadraticBoundaryRoot_sq k κ β (Sum.elim ρS ρT) v hρ (Sum.inl x)
  · intro x
    exact quadraticBoundaryRoot_sq k κ β (Sum.elim ρS ρT) v hρ (Sum.inr x)
  intro wE cs ct GS GT hGS hGT
  obtain ⟨jS, aS, jT, aT, hjS, hjT, hambient⟩ :=
    bare_rationalConfiguration_exists_matched_finiteBase_strict_transport
      k E κ s t Ωs Ωt α hα
  refine ⟨jS, aS, jT, aT, hjS, hjT, ?_⟩
  intro A_S A_T
  obtain ⟨hclS, hclT, hcoefS, hcoefT, hpointS, hpointT, c, _hcvalue, hc⟩ := hambient
  refine ⟨hclS, hclT, hcoefS, hcoefT, hpointS, hpointT, c, hc, ?_, ?_⟩
  · have hθ := quadraticScalar_originalEquiv_actual_canonicalBase k κ E ft xt
      ((coverTransportOfAutEquiv (fiber xs) (fiber xt) α).functor.obj AS)
      AT hEsemi hTsemi θ hθμ x₀ β
      (scalar_mem_quadraticBoundaryCoordinateField k κ β (Sum.elim ρS ρT)) hdisp
    intro g x
    exact namedSquareFiniteBaseFiberEquiv_innerCorrected_smul
      bs bt ys yt xs xt hs ht α AS AT θ αE
      (arithmeticConstantFieldCoverGroupTransport_inclusion k E κ fs ft xs xt α hα)
      hθ c g x
  · exact Equiv.apply_symm_apply _ _

end AnabelianGeometry.WeightFiltration
