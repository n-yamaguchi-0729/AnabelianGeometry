import Nyll.AnabelianGeometry.GeometricFundamentalGroup.LaurentKummerFiberGalois
import Nyll.AnabelianGeometry.KummerTheory.RootField

/-!
# Recovering root fields from the whole Kummer fibre

The pointwise stabilizer of all algebra points of a Laurent Kummer fibre
fixes precisely its full root field. After choosing one fibre point this
is the field generated by its coordinate and the corresponding roots of
unity. Thus the field is recovered from the actual Galois action on the
fibre rather than from an assumed character comparison.
-/

noncomputable section

namespace AnabelianGeometry.GeometricFundamentalGroup

open Polynomial
open AnabelianGeometry.KummerTheory

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]

/-- Fixing all fibre points is exactly fixing all roots of the Kummer equation. -/
theorem mem_laurentKummerFiber_pointwise_stabilizer_iff
    (n : ℕ) (a : Kˣ) (σ : L ≃ₐ[K] L) :
    σ ∈ (⨅ f : LaurentKummerFiberHom (L := L) n a,
      MulAction.stabilizer (L ≃ₐ[K] L) f) ↔
        ∀ r : L, r ^ n = algebraMap K L (a : K) → σ r = r := by
  rw [Subgroup.mem_iInf]
  constructor
  · intro h r hr
    have hf := (mem_laurentKummerFiber_stabilizer_iff n a
      (laurentKummerFiberHomOfRoot n a r hr) σ).mp
        (h (laurentKummerFiberHomOfRoot n a r hr))
    simpa only [laurentKummerFiberHomOfRoot, AdjoinRoot.lift_root] using hf
  · intro h f
    apply (mem_laurentKummerFiber_stabilizer_iff n a f σ).mpr
    exact h _ (laurentKummerFiberHom_root_pow n a f)

/-- The pointwise stabilizer of the fibre is the fixing subgroup of its root field. -/
theorem laurentKummerFiber_pointwise_stabilizer (n : ℕ) (a : Kˣ) :
    (⨅ f : LaurentKummerFiberHom (L := L) n a,
      MulAction.stabilizer (L ≃ₐ[K] L) f) =
        (rootField (L := L) n (a : K)).fixingSubgroup := by
  ext σ
  rw [mem_laurentKummerFiber_pointwise_stabilizer_iff,
    IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h x hx
    change x ∈ IntermediateField.adjoin K
      {r : L | r ^ n = algebraMap K L (a : K)} at hx
    induction hx using IntermediateField.adjoin_induction K with
    | mem x hx => exact h x hx
    | algebraMap x => exact σ.commutes x
    | add x y _ _ hx hy => rw [map_add, hx, hy]
    | inv x _ hx => rw [map_inv₀, hx]
    | mul x y _ _ hx hy => rw [map_mul, hx, hy]
  · intro h r hr
    exact h r (IntermediateField.subset_adjoin K _ hr)

/-- Recover the full Kummer root field from the action on the entire fibre. -/
theorem fixedField_laurentKummerFiber_pointwise_stabilizer [IsGalois K L]
    (n : ℕ) (a : Kˣ) :
    IntermediateField.fixedField
      (⨅ f : LaurentKummerFiberHom (L := L) n a,
        MulAction.stabilizer (L ≃ₐ[K] L) f) = rootField (L := L) n (a : K) := by
  rw [laurentKummerFiber_pointwise_stabilizer, InfiniteGalois.fixedField_fixingSubgroup]

/-- The field detected by the whole fibre is generated by one point's
coordinate and the roots of unity, without assuming those roots lie in the base. -/
theorem fixedField_laurentKummerFiber_eq_adjoin [IsGalois K L]
    {n : ℕ} (hn : n ≠ 0) (a : Kˣ) (f : LaurentKummerFiberHom (L := L) n a) :
    IntermediateField.fixedField
      (⨅ g : LaurentKummerFiberHom (L := L) n a,
        MulAction.stabilizer (L ≃ₐ[K] L) g) =
      IntermediateField.adjoin K
        (insert (f.val (AdjoinRoot.root _)) {ξ : L | ξ ^ n = 1}) := by
  rw [fixedField_laurentKummerFiber_pointwise_stabilizer]
  exact rootField_eq_adjoin_root_rootsOfUnity n (a : K) _
    (laurentKummerFiber_root_ne_zero hn a f) (laurentKummerFiberHom_root_pow n a f)

end AnabelianGeometry.GeometricFundamentalGroup
