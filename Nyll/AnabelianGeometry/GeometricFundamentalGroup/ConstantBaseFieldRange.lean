import Nyll.AlgebraicCurves.Models.ConstantExtension.BaseTower
import Nyll.AlgebraicCurves.Models.ConstantExtension.BaseGeneration
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-! # The image of an actual constant base change

The actual function field of a curve after extending constants embeds into its
geometric function field. Its image is exactly the compositum of the new
constants and the original function field; this is proved from the actual
projection maps and the generation theorem for base change.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicCurve
open AlgebraicGeometry.SmoothProperCurve

namespace AnabelianGeometry.GeometricFundamentalGroup

variable {k Ω F : Type} [Field k] [Field Ω] [Algebra k Ω]
    [Field F] [Algebra Ω F]
    (M : CurveModel Ω F) {C : Scheme} [IsIntegral C]
    (c : C ⟶ Spec (CommRingCat.of k)) [IsProper c]
    [SmoothOfRelativeDimension 1 c] [GeometricallyIntegral c]
    (e : M.C ≅ pullback c (specMap k Ω))
    (he : e.hom ≫ pullback.snd c (specMap k Ω) = M.toBase)
    (E : Type) [Field E] [Algebra k E] [Algebra E Ω] [IsScalarTower k E Ω]
    [Algebra E F] [IsScalarTower E Ω F]

local notation "CE" => pullback c (specMap k E)
local notation "cE" => pullback.snd c (specMap k E)

/-- The embedding induced by the actual projection in the tower of constants,
with its compatibility with the intermediate constants retained. -/
def constantTowerFieldEmbedding :
    let _ : Algebra E (CE).functionField := (baseToFunctionField cE).toAlgebra
    (CE).functionField →ₐ[E] F := by
  intro algE
  exact
    { M.constantBaseEmbedding cE (M.constantTowerModelIso k E Ω c e) with
      commutes' := fun a =>
        (M.constantBaseEmbedding_constants cE (M.constantTowerModelIso k E Ω c e)
          (M.constantTowerModelIso_base k E Ω c e he) a).trans
          (IsScalarTower.algebraMap_apply E Ω F a).symm }

variable [Algebra k F] [IsScalarTower k E F]

/-- No field-image comparison is assumed: the image of the actual finite
constant base change is generated by the original field and the new constants. -/
theorem constantTowerFieldEmbedding_fieldRange :
    let _ : Algebra E (CE).functionField := (baseToFunctionField cE).toAlgebra
    (constantTowerFieldEmbedding M c e he E).fieldRange.restrictScalars k =
      IntermediateField.adjoin k (Set.range (M.constantBaseEmbedding c e)) ⊔
        (IsScalarTower.toAlgHom k E F).fieldRange := by
  intro algE
  let ME : CurveModel E (CE).functionField := CurveModel.ofSmoothProperCurve cE
  let j : (CE).functionField →ₐ[E] F := constantTowerFieldEmbedding M c e he E
  let A : IntermediateField k F :=
    IntermediateField.adjoin k (Set.range (M.constantBaseEmbedding c e))
  let B : IntermediateField k F := (IsScalarTower.toAlgHom k E F).fieldRange
  have hj (x : C.functionField) :
      j (ME.constantBaseEmbedding c (Iso.refl _) x) = M.constantBaseEmbedding c e x :=
    M.constantBaseEmbedding_tower c e E x
  have hgen : IntermediateField.adjoin E
      (Set.range (ME.constantBaseEmbedding c (Iso.refl _))) = ⊤ :=
    ME.adjoin_constantBaseEmbedding_eq_top c (Iso.refl _) (Category.id_comp _)
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    have hx : x ∈ IntermediateField.adjoin E
        (Set.range (ME.constantBaseEmbedding c (Iso.refl _))) := by
      rw [hgen]
      exact IntermediateField.mem_top
    refine IntermediateField.adjoin_induction E (p := fun x _ => j x ∈ A ⊔ B)
      ?_ ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨a, rfl⟩
      rw [hj]
      have ha : M.constantBaseEmbedding c e a ∈ A :=
        IntermediateField.subset_adjoin k _ ⟨a, rfl⟩
      exact (show A ≤ A ⊔ B from le_sup_left) ha
    · intro a
      rw [j.commutes]
      have ha : algebraMap E F a ∈ B := ⟨a, rfl⟩
      exact (show B ≤ A ⊔ B from le_sup_right) ha
    · intro x y _hx _hy hx hy
      rw [map_add]
      exact IntermediateField.add_mem _ hx hy
    · intro x _hx hx
      rw [map_inv₀]
      exact IntermediateField.inv_mem _ hx
    · intro x y _hx _hy hx hy
      rw [map_mul]
      exact IntermediateField.mul_mem _ hx hy
  · apply sup_le
    · apply IntermediateField.adjoin_le_iff.mpr
      rintro _ ⟨a, rfl⟩
      exact ⟨ME.constantBaseEmbedding c (Iso.refl _) a, hj a⟩
    · rintro _ ⟨a, rfl⟩
      exact ⟨algebraMap E (CE).functionField a, j.commutes a⟩

end AnabelianGeometry.GeometricFundamentalGroup
