import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Galois.GaloisClosure

/-! # Finite fields of constants for specified rational functions

In an actual constant-field extension, finitely many rational functions use
only finitely many constants. Taking their normal closure gives a common
finite Galois field. The assertion keeps the original functions inside the
original ambient field, rather than replacing them by abstract copies.
-/

noncomputable section

namespace AnabelianGeometry.GeometricFundamentalGroup

/-- A finite collection of elements in a field generated by its original
subfield and Galois constants already belongs to a finite Galois constant
extension of that original subfield. -/
theorem exists_finiteGalois_constants_of_adjoin_eq_top
    (k K F₀ F : Type*) [Field k] [Field K] [Field F₀] [Field F]
    [Algebra k K] [IsGalois k K] [Algebra K F] [Algebra F₀ F]
    (hgen : IntermediateField.adjoin F₀ (Set.range (algebraMap K F)) = ⊤)
    (s : Finset F) :
    ∃ E : FiniteGaloisIntermediateField k K, ∀ x ∈ s,
      x ∈ IntermediateField.adjoin F₀
        ((algebraMap K F) '' (E.toIntermediateField : Set K)) := by
  classical
  have hx (x : s) : x.val ∈ IntermediateField.adjoin F₀
      (Set.range (algebraMap K F)) := by
    rw [hgen]
    exact IntermediateField.mem_top
  have hfinite (x : s) := IntermediateField.exists_finset_of_mem_adjoin (hx x)
  choose T hT hmem using hfinite
  let c : (Σ x : s, T x) → K := fun i => (hT i.1 i.2.property).choose
  have hc (i : Σ x : s, T x) : algebraMap K F (c i) = i.2.val :=
    (hT i.1 i.2.property).choose_spec
  let E := FiniteGaloisIntermediateField.adjoin k (Set.range c)
  refine ⟨E, fun x hx => ?_⟩
  have hsubset : (T ⟨x, hx⟩ : Set F) ⊆
      (algebraMap K F) '' (E.toIntermediateField : Set K) := by
    intro z hz
    let i : Σ x : s, T x := ⟨⟨x, hx⟩, ⟨z, hz⟩⟩
    exact ⟨c i, FiniteGaloisIntermediateField.subset_adjoin k (Set.range c) ⟨i, rfl⟩,
      hc i⟩
  exact IntermediateField.adjoin.mono F₀ _ _ hsubset (hmem ⟨x, hx⟩)

end AnabelianGeometry.GeometricFundamentalGroup
