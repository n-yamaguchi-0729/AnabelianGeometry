import Nyll.AnabelianGeometry.KummerTheory.CyclicPowerComparison
import Nyll.AnabelianGeometry.KummerTheory.RootFieldPowerClasses
import Nyll.AnabelianGeometry.KummerTheory.NumberFieldAbelianRadicals
import Nyll.AnabelianGeometry.KummerTheory.NumberFieldPowerSeparation
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# Uniform power comparison from root fields over number fields

We construct the relevant cyclotomic intermediate field in an algebraic
closure and descend the resulting Kummer relation with the fixed loss given
by the original field's roots-of-unity order. Equality at every exponent
then identifies the cyclic subgroups generated by these fixed powers.
The roots-of-unity ambiguity of the original generators is not removed.
-/

noncomputable section

open scoped IsMulCommutative

namespace AnabelianGeometry.KummerTheory

variable {K : Type*} [Field K] [NumberField K]

/-- Equal root fields produce a power relation over the original number
field with a bound independent of n. The cyclotomic extension used in the
proof is constructed inside the algebraic closure. -/
theorem exists_torsionOrder_power_relation_of_rootField_eq
    (n : ℕ+) (a b : Kˣ)
    (h : rootField (L := AlgebraicClosure K) n (a : K) =
      rootField (L := AlgebraicClosure K) n (b : K)) :
    ∃ k : ℤ, ∃ d : Kˣ,
      b ^ NumberField.Units.torsionOrder K =
        (a ^ k) ^ NumberField.Units.torsionOrder K * d ^ (n : ℕ) := by
  have : NeZero (n : ℕ) := ⟨n.ne_zero⟩
  let L := AlgebraicClosure K
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (n : ℕ)
  let C : IntermediateField K L := IntermediateField.adjoin K {ζ}
  have : IsCyclotomicExtension {(n : ℕ)} K C :=
    hζ.intermediateField_adjoin_isCyclotomicExtension K
  have : IsGalois K C := IsCyclotomicExtension.isGalois {(n : ℕ)} K C
  have : IsMulCommutative (C ≃ₐ[K] C) :=
    IsCyclotomicExtension.isMulCommutative {(n : ℕ)} K C
  have : IsSepClosure C L := ⟨inferInstance, inferInstance⟩
  obtain ⟨η, hη⟩ := IsCyclotomicExtension.exists_isPrimitiveRoot
    (S := {(n : ℕ)}) K C rfl n.ne_zero
  have hmu : (primitiveRoots (n : ℕ) C).Nonempty :=
    ⟨η, (mem_primitiveRoots n.pos).mpr hη⟩
  have hn : ((n : ℕ) : C) ≠ 0 := Nat.cast_ne_zero.mpr n.ne_zero
  let f : Kˣ →* Cˣ := Units.map (algebraMap K C).toMonoidHom
  have hfields : rootField (L := L) n ((f a : Cˣ) : C) =
      rootField (L := L) n ((f b : Cˣ) : C) :=
    rootField_baseChange_eq C n (a : K) (b : K) h
  obtain ⟨k, c, hc⟩ := exists_zpow_mul_power_of_rootField_eq
    (L := L) n hn hmu (f a) (f b) hfields
  have hcPow : c ^ (n : ℕ) = f (b / a ^ k) := by
    rw [map_div, map_zpow, hc]
    simp only [mul_div_cancel_left]
  have hcRoot : (c : C) ^ (n : ℕ) =
      algebraMap K C ((b / a ^ k : Kˣ) : K) := congrArg Units.val hcPow
  obtain ⟨d, hd⟩ := exists_unit_power_torsionOrder_of_abelian
    n η hη (b / a ^ k) (c : C) c.ne_zero hcRoot
  refine ⟨k, d, ?_⟩
  rw [hd, div_pow]
  simp only [← mul_div_assoc, mul_div_cancel_left]

/-- All root-field comparisons determine the cyclic subgroup generated by
the fixed roots-of-unity-order power. No exact recovery of the original
cyclic subgroup is asserted by this theorem. -/
theorem torsionOrder_power_mem_zpowers_of_forall_rootField_eq
    (a b : Kˣ)
    (h : ∀ n : ℕ+, rootField (L := AlgebraicClosure K) n (a : K) =
      rootField (L := AlgebraicClosure K) n (b : K)) :
    b ^ NumberField.Units.torsionOrder K ∈
      Subgroup.zpowers (a ^ NumberField.Units.torsionOrder K) := by
  apply numberField_mem_zpowers_of_forall_mem_sup_powers
  intro n
  obtain ⟨k, d, hd⟩ := exists_torsionOrder_power_relation_of_rootField_eq n a b (h n)
  have hp : (a ^ k) ^ NumberField.Units.torsionOrder K =
      (a ^ NumberField.Units.torsionOrder K) ^ k := by
    simp only [← zpow_natCast, ← zpow_mul, Int.mul_comm]
  apply Subgroup.mem_sup.mpr
  refine ⟨(a ^ NumberField.Units.torsionOrder K) ^ k, ?_, d ^ (n : ℕ), ⟨d, rfl⟩, ?_⟩
  · exact Subgroup.zpow_mem (Subgroup.zpowers _) (Subgroup.mem_zpowers _) k
  · rw [← hp]
    exact hd.symm

/-- The fixed-power cyclic subgroups agree for two elements with identical
full root fields at every positive exponent. -/
theorem zpowers_torsionOrder_eq_of_forall_rootField_eq
    (a b : Kˣ)
    (h : ∀ n : ℕ+, rootField (L := AlgebraicClosure K) n (a : K) =
      rootField (L := AlgebraicClosure K) n (b : K)) :
    Subgroup.zpowers (a ^ NumberField.Units.torsionOrder K) =
      Subgroup.zpowers (b ^ NumberField.Units.torsionOrder K) := by
  apply le_antisymm
  · exact Subgroup.zpowers_le.mpr
      (torsionOrder_power_mem_zpowers_of_forall_rootField_eq b a (fun n => (h n).symm))
  · exact Subgroup.zpowers_le.mpr
      (torsionOrder_power_mem_zpowers_of_forall_rootField_eq a b h)

/-- For a non-torsion element, equality of all full root fields leaves only
inversion and multiplication by a root of unity in the original field. -/
theorem exists_torsion_mul_or_inv_of_forall_rootField_eq
    (a b : Kˣ) (ha : ¬ IsOfFinOrder a)
    (h : ∀ n : ℕ+, rootField (L := AlgebraicClosure K) n (a : K) =
      rootField (L := AlgebraicClosure K) n (b : K)) :
    ∃ ζ : Kˣ, ζ ^ NumberField.Units.torsionOrder K = 1 ∧
      (b = ζ * a ∨ b = ζ * a⁻¹) := by
  exact exists_pow_eq_one_mul_or_inv_of_zpowers_pow_eq
    ⟨NumberField.Units.torsionOrder K, NumberField.Units.torsionOrder_pos K⟩
    a b ha (zpowers_torsionOrder_eq_of_forall_rootField_eq a b h)

end AnabelianGeometry.KummerTheory
