import Nyll.AnabelianGeometry.KummerTheory.RootField
import Nyll.AnabelianGeometry.KummerTheory.Ratios
import Mathlib.FieldTheory.IsAlgClosed.Basic

/-!
# Intersections of simultaneously twisted full root fields

Intersecting the composita of the full root fields of `c * x` and `c * y`
over all nonzero base-field twists `c` recovers the full root field of `y / x`.
Roots of unity are retained throughout, so the base need not contain them.
-/

namespace AnabelianGeometry.KummerTheory

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]

/-- The intermediate field generated by the roots of unity of a fixed order. -/
def rootsOfUnityField (n : ℕ) : IntermediateField K L :=
  IntermediateField.adjoin K {ξ : L | ξ ^ n = 1}

/-- Split the root field into its roots-of-unity and single-radical parts. -/
theorem rootField_eq_sup (n : ℕ) (x : K) (a : L)
    (ha : a ≠ 0) (hap : a ^ n = algebraMap K L x) :
    rootField (L := L) n x = rootsOfUnityField n ⊔ IntermediateField.adjoin K {a} := by
  rw [rootField_eq_adjoin_root_rootsOfUnity n x a ha hap,
    ← Set.singleton_union, IntermediateField.adjoin_union, sup_comm]
  rfl

/-- The compositum of two full root fields is generated by both radicals
and the common roots of unity. -/
theorem rootFields_sup_eq (n : ℕ) (x y : K) (a b : L)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (hap : a ^ n = algebraMap K L x) (hbp : b ^ n = algebraMap K L y) :
    rootField (L := L) n x ⊔ rootField (L := L) n y =
      rootsOfUnityField n ⊔ IntermediateField.adjoin K ({a, b} : Set L) := by
  rw [rootField_eq_sup n x a ha hap, rootField_eq_sup n y b hb hbp,
    ← Set.singleton_union, IntermediateField.adjoin_union,
    sup_sup_sup_comm, sup_idem]

/-- Keeping any fixed intermediate field in every simultaneous twist
preserves the attained minimum at the inverse of the first coordinate. -/
theorem iInf_sup_twistField_eq (E : IntermediateField K L) (a b : L) (n : ℕ)
    (ha : a ≠ 0) (han : a ^ n ∈ (⊥ : IntermediateField K L)) :
    (⨅ r : {r : L // r ≠ 0 ∧ r ^ n ∈ (⊥ : IntermediateField K L)},
      E ⊔ twistField K a b r.1) = E ⊔ IntermediateField.adjoin K ({b / a} : Set L) := by
  let T : {r : L // r ≠ 0 ∧ r ^ n ∈ (⊥ : IntermediateField K L)} →
      IntermediateField K L := fun r => E ⊔ twistField K a b r.1
  change iInf T = E ⊔ IntermediateField.adjoin K ({b / a} : Set L)
  apply le_antisymm
  · have hinv : (a⁻¹) ^ n ∈ (⊥ : IntermediateField K L) := by
      rw [inv_pow]
      exact (⊥ : IntermediateField K L).inv_mem han
    calc
      iInf T ≤ T ⟨a⁻¹, inv_ne_zero ha, hinv⟩ :=
        iInf_le T ⟨a⁻¹, inv_ne_zero ha, hinv⟩
      _ = _ := congrArg (E ⊔ ·) (twistField_inv_eq_adjoin_ratio K a b ha)
  · exact le_iInf fun r => sup_le_sup_left (adjoin_ratio_le_twistField K a b r.1 r.2.1) E

/-- The field of the ratio is the intersection of all simultaneously
twisted full root fields, indexed by actual nonzero base-field scalars. -/
theorem iInf_twisted_rootFields_eq [IsAlgClosed L]
    (n : ℕ) (hn : 0 < n) (x y : Kˣ) :
    (⨅ c : Kˣ, rootField (L := L) n ((c * x : Kˣ) : K) ⊔
      rootField (L := L) n ((c * y : Kˣ) : K)) =
        rootField (L := L) n ((y / x : Kˣ) : K) := by
  obtain ⟨a, hap⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap K L (x : K)) hn
  obtain ⟨b, hbp⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap K L (y : K)) hn
  have ha : a ≠ 0 := by
    intro h
    rw [h, zero_pow hn.ne'] at hap
    exact ((map_ne_zero (algebraMap K L)).mpr x.ne_zero) hap.symm
  have hb : b ≠ 0 := by
    intro h
    rw [h, zero_pow hn.ne'] at hbp
    exact ((map_ne_zero (algebraMap K L)).mpr y.ne_zero) hbp.symm
  have hratio : (b / a) ^ n = algebraMap K L ((y / x : Kˣ) : K) :=
    by simpa only [Units.val_div_eq_div_val] using ratio_pow_eq K hap hbp
  rw [rootField_eq_sup n _ (b / a) (div_ne_zero hb ha) hratio]
  have hfields (c : Kˣ) (r : L) (hr : r ≠ 0)
      (hrp : r ^ n = algebraMap K L (c : K)) :
      rootField (L := L) n ((c * x : Kˣ) : K) ⊔
        rootField (L := L) n ((c * y : Kˣ) : K) =
          rootsOfUnityField n ⊔ twistField K a b r := by
    apply rootFields_sup_eq n _ _ (r * a) (r * b) (mul_ne_zero hr ha) (mul_ne_zero hr hb)
    · rw [mul_pow, hrp, hap, ← map_mul]
      rfl
    · rw [mul_pow, hrp, hbp, ← map_mul]
      rfl
  apply le_antisymm
  · have hip : (a⁻¹) ^ n = algebraMap K L ((x⁻¹ : Kˣ) : K) := by
      rw [Units.val_inv_eq_inv_val, inv_pow, hap, map_inv₀]
    calc
      _ ≤ rootField (L := L) n ((x⁻¹ * x : Kˣ) : K) ⊔
          rootField (L := L) n ((x⁻¹ * y : Kˣ) : K) := iInf_le _ x⁻¹
      _ = rootsOfUnityField n ⊔ twistField K a b a⁻¹ := hfields x⁻¹ a⁻¹ (inv_ne_zero ha) hip
      _ = _ := congrArg (rootsOfUnityField n ⊔ ·) (twistField_inv_eq_adjoin_ratio K a b ha)
  · apply le_iInf
    intro c
    obtain ⟨r, hrp⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap K L (c : K)) hn
    have hr : r ≠ 0 := by
      intro h
      rw [h, zero_pow hn.ne'] at hrp
      exact ((map_ne_zero (algebraMap K L)).mpr c.ne_zero) hrp.symm
    rw [hfields c r hr hrp]
    exact sup_le_sup_left (adjoin_ratio_le_twistField K a b r hr) _

end AnabelianGeometry.KummerTheory
