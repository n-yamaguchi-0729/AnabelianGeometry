import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Fields generated by all roots of a Kummer equation

After choosing one nonzero root, adjoining all roots of the equation is
exactly adjoining that root and all roots of unity of the same order.
The equality is proved inside the given ambient field without assuming
that roots of unity already lie in the base.
-/

namespace AnabelianGeometry.KummerTheory

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]

/-- The field generated by all roots in the ambient field of one Kummer equation. -/
def rootField (n : ℕ) (a : K) : IntermediateField K L :=
  IntermediateField.adjoin K {s : L | s ^ n = algebraMap K L a}

/-- One nonzero root and the roots of unity generate exactly the full root field. -/
theorem rootField_eq_adjoin_root_rootsOfUnity (n : ℕ) (a : K) (r : L)
    (hr : r ≠ 0) (hpow : r ^ n = algebraMap K L a) :
    rootField (L := L) n a =
      IntermediateField.adjoin K (insert r {ξ : L | ξ ^ n = 1}) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro s hs
    have hratio : (s / r) ^ n = 1 := by
      rw [div_pow, hs, ← hpow, div_self (pow_ne_zero n hr)]
    have hm : s / r ∈ IntermediateField.adjoin K (insert r {ξ : L | ξ ^ n = 1}) :=
      IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem r hratio)
    have hrmem : r ∈ IntermediateField.adjoin K (insert r {ξ : L | ξ ^ n = 1}) :=
      IntermediateField.subset_adjoin K _ (Set.mem_insert r _)
    rw [← div_mul_cancel₀ s hr]
    exact IntermediateField.mul_mem _ hm hrmem
  · apply IntermediateField.adjoin_le_iff.mpr
    intro ξ hξ
    rcases Set.mem_insert_iff.mp hξ with heq | hroot
    · rw [heq]
      exact IntermediateField.subset_adjoin K _ hpow
    · have hprod : (r * ξ) ^ n = algebraMap K L a := by
        rw [mul_pow, hroot, mul_one, hpow]
      have hp : r * ξ ∈ rootField (L := L) n a :=
        IntermediateField.subset_adjoin K _ hprod
      have hrmem : r ∈ rootField (L := L) n a :=
        IntermediateField.subset_adjoin K _ hpow
      have heq : (r * ξ) / r = ξ := by rw [mul_comm r ξ, mul_div_cancel_right₀ _ hr]
      rw [← heq]
      exact IntermediateField.div_mem _ hp hrmem

/-- Extending the coefficient field takes the compositum with the original
root field. This comparison uses all roots and is independent of choices. -/
theorem rootField_restrictScalars (C : IntermediateField K L) (n : ℕ) (a : K) :
    (rootField (L := L) n (algebraMap K C a)).restrictScalars K =
      C ⊔ rootField (L := L) n a := by
  unfold rootField
  rw [← IsScalarTower.algebraMap_apply K C L]
  exact IntermediateField.restrictScalars_adjoin_eq_sup K C
    {s : L | s ^ n = algebraMap K L a}

/-- Equality of full root fields persists after any intermediate-field
extension of the base. -/
theorem rootField_baseChange_eq (C : IntermediateField K L) (n : ℕ) (a b : K)
    (h : rootField (L := L) n a = rootField (L := L) n b) :
    rootField (L := L) n (algebraMap K C a) =
      rootField (L := L) n (algebraMap K C b) := by
  apply IntermediateField.restrictScalars_injective K
  rw [rootField_restrictScalars, rootField_restrictScalars, h]

end AnabelianGeometry.KummerTheory
