import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Recovering a radical ratio from simultaneous twists

If `a ^ n` belongs to the base field, the intersection of the fields
`K(r * a, r * b)`, over nonzero `r` whose `n`-th power belongs to `K`, is
exactly `K(b / a)`. The proof constructs the normalizing twist `r = a⁻¹`.
This is the field-theoretic calculation used to recover cross ratios from
two fibres of a cyclic cover. It does not assert that these fields have
already been reconstructed from an étale fundamental group.

The argument works over any field, hence in particular over number fields
and their cyclotomic extensions.
-/

namespace AnabelianGeometry.KummerTheory

universe u v

variable (K : Type u) [Field K] {L : Type v} [Field L] [Algebra K L]

/-- The field generated by two elements after a common multiplicative twist. -/
def twistField (a b r : L) : IntermediateField K L :=
  IntermediateField.adjoin K ({r * a, r * b} : Set L)

/-- The ratio of two nonzero-twisted elements lies in their common field. -/
theorem ratio_mem_twistField (a b r : L) (hr : r ≠ 0) :
    b / a ∈ twistField K a b r := by
  have ha : r * a ∈ twistField K a b r :=
    IntermediateField.subset_adjoin K _ (Set.mem_insert _ _)
  have hb : r * b ∈ twistField K a b r :=
    IntermediateField.subset_adjoin K _
      (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have h := (twistField K a b r).div_mem hb ha
  rwa [mul_div_mul_left b a hr] at h

/-- The field of the ratio is contained in every nonzero simultaneous twist. -/
theorem adjoin_ratio_le_twistField (a b r : L) (hr : r ≠ 0) :
    IntermediateField.adjoin K ({b / a} : Set L) ≤ twistField K a b r := by
  rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
  exact ratio_mem_twistField K a b r hr

/-- The inverse of the first coordinate gives a twist attaining the lower bound. -/
theorem twistField_inv_eq_adjoin_ratio (a b : L) (ha : a ≠ 0) :
    twistField K a b a⁻¹ = IntermediateField.adjoin K ({b / a} : Set L) := by
  apply le_antisymm
  · rw [twistField, IntermediateField.adjoin_le_iff]
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · rw [hx, inv_mul_cancel₀ ha]
      exact IntermediateField.one_mem _
    · rw [Set.mem_singleton_iff] at hx
      rw [hx, mul_comm, ← div_eq_mul_inv]
      exact IntermediateField.subset_adjoin K _ (Set.mem_singleton _)
  · exact adjoin_ratio_le_twistField K a b a⁻¹ (inv_ne_zero ha)

/-- The intersection over all twists with `n`-th power in the base field
recovers the field generated by the radical ratio. -/
theorem iInf_twistField_eq_adjoin_ratio (a b : L) (n : ℕ)
    (ha : a ≠ 0) (han : a ^ n ∈ (⊥ : IntermediateField K L)) :
    (⨅ r : {r : L // r ≠ 0 ∧ r ^ n ∈ (⊥ : IntermediateField K L)},
      twistField K a b r.1) = IntermediateField.adjoin K ({b / a} : Set L) := by
  let T : {r : L // r ≠ 0 ∧ r ^ n ∈ (⊥ : IntermediateField K L)} →
      IntermediateField K L := fun r => twistField K a b r.1
  change iInf T = IntermediateField.adjoin K ({b / a} : Set L)
  apply le_antisymm
  · have hinv : (a⁻¹) ^ n ∈ (⊥ : IntermediateField K L) := by
      rw [inv_pow]
      exact (⊥ : IntermediateField K L).inv_mem han
    calc
      iInf T ≤ T ⟨a⁻¹, inv_ne_zero ha, hinv⟩ :=
        iInf_le T ⟨a⁻¹, inv_ne_zero ha, hinv⟩
      _ = IntermediateField.adjoin K ({b / a} : Set L) :=
        twistField_inv_eq_adjoin_ratio K a b ha
  · exact le_iInf fun r => adjoin_ratio_le_twistField K a b r.1 r.2.1

/-- The reconstructed ratio is an `n`-th root of the ratio of the original values. -/
theorem ratio_pow_eq {a b : L} {x y : K} {n : ℕ}
    (ha : a ^ n = algebraMap K L x) (hb : b ^ n = algebraMap K L y) :
    (b / a) ^ n = algebraMap K L (y / x) := by
  rw [div_pow, hb, ha, map_div₀]

/-- When the base field contains the `n`-th roots of unity, a nonzero
radical generates a field independent of the chosen root. -/
theorem adjoin_eq_of_pow_eq {a b : L} {n : ℕ}
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ^ n = b ^ n)
    (hroots : ∀ ζ : L, ζ ^ n = 1 → ζ ∈ (⊥ : IntermediateField K L)) :
    IntermediateField.adjoin K ({a} : Set L) =
      IntermediateField.adjoin K ({b} : Set L) := by
  have hle : ∀ x y : L, y ≠ 0 → x ^ n = y ^ n →
      IntermediateField.adjoin K ({x} : Set L) ≤
        IntermediateField.adjoin K ({y} : Set L) := by
    intro x y hy hxy
    rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    have hr : x / y ∈ (⊥ : IntermediateField K L) := by
      apply hroots
      rw [div_pow, hxy, div_self (pow_ne_zero n hy)]
    have hbot : (⊥ : IntermediateField K L) ≤
        IntermediateField.adjoin K ({y} : Set L) := bot_le
    have hr' : x / y ∈ IntermediateField.adjoin K ({y} : Set L) := hbot hr
    have hy' : y ∈ IntermediateField.adjoin K ({y} : Set L) :=
      IntermediateField.subset_adjoin K _ (Set.mem_singleton _)
    have hm := (IntermediateField.adjoin K ({y} : Set L)).mul_mem hr' hy'
    rwa [div_mul_cancel₀ x hy] at hm
  exact le_antisymm (hle a b hb hab) (hle b a ha hab.symm)

end AnabelianGeometry.KummerTheory
