import Nyll.AnabelianGeometry.KummerTheory.RootCocycle
import Mathlib.FieldTheory.Galois.Infinite

/-!
# Radical characters and their fixed fields

When the relevant roots of unity belong to the base field, a nonzero radical
defines a unit-valued Galois character. Its kernel fixes precisely the field
generated by that radical in an arbitrary Galois ambient extension.
-/

namespace AnabelianGeometry.KummerTheory

universe u v

variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]

/-- The Kummer character of a nonzero radical, with values in ambient units. -/
def rootCharacter (r : L) (hr : r ≠ 0) {n : ℕ} {a : K}
    (ha : r ^ n = algebraMap K L a)
    (hroots : ∀ ξ : L, ξ ^ n = 1 → ∃ b : K, algebraMap K L b = ξ) :
    (L ≃ₐ[K] L) →* Lˣ where
  toFun σ := Units.mk0 (rootRatio r σ) (rootRatio_ne_zero hr σ)
  map_one' := by
    apply Units.ext
    change r / r = 1
    exact div_self hr
  map_mul' σ τ := by
    apply Units.ext
    exact rootRatio_mul_of_roots_in_base hr ha hroots σ τ

/-- The character kernel is exactly the pointwise stabilizer of the radical field. -/
theorem rootCharacter_ker (r : L) (hr : r ≠ 0) {n : ℕ} {a : K}
    (ha : r ^ n = algebraMap K L a)
    (hroots : ∀ ξ : L, ξ ^ n = 1 → ∃ b : K, algebraMap K L b = ξ) :
    (rootCharacter r hr ha hroots).ker =
      (IntermediateField.adjoin K ({r} : Set L)).fixingSubgroup := by
  ext σ
  change rootCharacter r hr ha hroots σ = 1 ↔
    σ ∈ (IntermediateField.adjoin K ({r} : Set L)).fixingSubgroup
  rw [mem_fixingSubgroup_adjoin_iff_rootRatio_eq_one hr]
  constructor
  · intro h
    exact congrArg (fun z : Lˣ => (z : L)) h
  · intro h
    exact Units.ext h

/-- In an arbitrary Galois ambient extension, the radical field is recovered
as the fixed field of the radical character's kernel. -/
theorem fixedField_rootCharacter_ker [IsGalois K L]
    (r : L) (hr : r ≠ 0) {n : ℕ} {a : K}
    (ha : r ^ n = algebraMap K L a)
    (hroots : ∀ ξ : L, ξ ^ n = 1 → ∃ b : K, algebraMap K L b = ξ) :
    IntermediateField.fixedField (rootCharacter r hr ha hroots).ker =
      IntermediateField.adjoin K ({r} : Set L) := by
  rw [rootCharacter_ker, InfiniteGalois.fixedField_fixingSubgroup]

/-- A radical character has open kernel in the Krull topology, including
when the Galois ambient extension is infinite. -/
theorem rootCharacter_ker_isOpen [IsGalois K L]
    (r : L) (hr : r ≠ 0) {n : ℕ} {a : K}
    (ha : r ^ n = algebraMap K L a)
    (hroots : ∀ ξ : L, ξ ^ n = 1 → ∃ b : K, algebraMap K L b = ξ) :
    IsOpen ((rootCharacter r hr ha hroots).ker : Set (L ≃ₐ[K] L)) := by
  rw [rootCharacter_ker]
  have : FiniteDimensional K (IntermediateField.adjoin K ({r} : Set L)) :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral r)
  exact IntermediateField.fixingSubgroup_isOpen _

end AnabelianGeometry.KummerTheory
