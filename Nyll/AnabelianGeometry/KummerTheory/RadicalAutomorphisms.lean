import Nyll.AnabelianGeometry.KummerTheory.RootCocycle
import Nyll.AnabelianGeometry.KummerTheory.Conjugation

/-!
# Detecting automorphisms by one radical over prescribed constants

If a field is generated by a set of constants and one nonzero radical,
automorphisms agreeing on the constants are determined by their radical
ratios. In particular the ratio map is injective on the subgroup fixing
the constant field. This does not identify that subgroup with geometric
inertia; that comparison is a separate construction.
-/

namespace AnabelianGeometry.KummerTheory

universe u v

variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]

/-- Agreement on the prescribed constants and on the radical ratio determines
automorphism of the generated field. -/
theorem algEquiv_eq_of_rootRatio_eq {r : L} (hr : r ≠ 0) {S : Set L}
    (hgen : IntermediateField.adjoin K (insert r S) = ⊤)
    {σ τ : L ≃ₐ[K] L} (hS : ∀ x ∈ S, σ x = τ x)
    (h : rootRatio r σ = rootRatio r τ) : σ = τ := by
  have hroot : σ r = τ r := by
    have hm := congrArg (fun z : L => z * r) h
    change (σ r / r) * r = (τ r / r) * r at hm
    simpa only [div_mul_cancel₀ _ hr] using hm
  apply AlgEquiv.ext
  intro x
  have hx : x ∈ IntermediateField.adjoin K (insert r S) := by
    rw [hgen]
    exact IntermediateField.mem_top
  induction hx using IntermediateField.adjoin_induction K with
  | mem x hx =>
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · subst x
      exact hroot
    · exact hS x hx
  | algebraMap x => rw [σ.commutes, τ.commutes]
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | inv x _ hx => rw [map_inv₀, map_inv₀, hx]
  | mul x y _ _ hx hy => rw [map_mul, map_mul, hx, hy]

/-- Over a fixed constant field, the radical ratio faithfully detects the
remaining automorphisms. -/
theorem rootRatio_injective_on_fixingSubgroup {r : L} (hr : r ≠ 0) {S : Set L}
    (hgen : IntermediateField.adjoin K (insert r S) = ⊤) :
    Function.Injective (fun σ : (IntermediateField.adjoin K S).fixingSubgroup =>
      rootRatio r σ.val) := by
  intro σ τ h
  apply Subtype.ext
  apply algEquiv_eq_of_rootRatio_eq hr hgen ?_ h
  intro x hx
  have hx' := IntermediateField.subset_adjoin K S hx
  have hσ := (IntermediateField.mem_fixingSubgroup_iff
    (IntermediateField.adjoin K S) σ.val).mp σ.property x hx'
  have hτ := (IntermediateField.mem_fixingSubgroup_iff
    (IntermediateField.adjoin K S) τ.val).mp τ.property x hx'
  exact hσ.trans hτ.symm

/-- The cyclotomic action on roots of unity determines conjugation of radical
automorphisms fixing the constants, provided those constants are stable under
the conjugating automorphism. -/
theorem radical_conjugate_eq_pow {r : L} (hr : r ≠ 0) {S : Set L}
    (hgen : IntermediateField.adjoin K (insert r S) = ⊤)
    {n m : ℕ} {a : K} (ha : r ^ n = algebraMap K L a)
    (σ τ : L ≃ₐ[K] L)
    (hτ : ∀ x ∈ S, τ x = x)
    (hstable : ∀ x ∈ S, σ⁻¹ x ∈ S)
    (hroots : ∀ ξ : L, ξ ^ n = 1 → ξ ∈ S)
    (hσ : ∀ ξ : L, ξ ^ n = 1 → σ ξ = ξ ^ m) :
    σ * τ * σ⁻¹ = τ ^ m := by
  have hτroots : ∀ ξ : L, ξ ^ n = 1 → τ ξ = ξ :=
    fun ξ hξ => hτ ξ (hroots ξ hξ)
  have hpow : ∀ k : ℕ, ∀ x ∈ S, (τ ^ k) x = x := by
    intro k x hx
    induction k with
    | zero => rw [pow_zero]; rfl
    | succ k hk =>
      rw [pow_succ']
      change τ ((τ ^ k) x) = x
      rw [hk, hτ x hx]
  apply algEquiv_eq_of_rootRatio_eq hr hgen ?_ ?_
  · intro x hx
    rw [hpow m x hx]
    change σ (τ (σ⁻¹ x)) = x
    rw [hτ _ (hstable x hx)]
    exact σ.apply_symm_apply x
  · rw [rootRatio_conjugate_eq_pow hr ha σ τ hτroots hσ,
      rootRatio_aut_pow hr ha τ hτroots]

end AnabelianGeometry.KummerTheory
