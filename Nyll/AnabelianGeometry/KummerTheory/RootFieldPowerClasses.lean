import Nyll.AnabelianGeometry.KummerTheory.RootField
import Nyll.GaloisCohomology.Kummer.Concrete.Correspondence

/-!
# Power classes recovered from a root field

Over a field containing the relevant roots of unity, the full root field
of a unit determines its cyclic subgroup modulo powers. The statement
retains the roots-of-unity hypothesis; it does not assert descent through
an arbitrary cyclotomic extension.
-/

noncomputable section

namespace AnabelianGeometry.KummerTheory

open _root_.KummerTheory

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [IsSepClosure K L]

/-- The cyclic subgroup generated by a unit, enlarged by all ambient powers. -/
def cyclicPowerSubgroup (n : ℕ+) (a : Kˣ) : KummerSubgroup K n :=
  ⟨Subgroup.zpowers a ⊔ unitNthPowersSubgroup K n, le_sup_right⟩

/-- The full root field is the radical extension associated with the cyclic
power subgroup. -/
theorem rootField_eq_cyclicPowerRadical
    (n : ℕ+) (hn : ((n : ℕ) : K) ≠ 0)
    (hmu : (primitiveRoots (n : ℕ) K).Nonempty) (a : Kˣ) :
    rootField (L := L) n (a : K) =
      kummerRadicalExtension (K := K) (Omega := L) n (cyclicPowerSubgroup n a).val := by
  let E := rootField (L := L) n (a : K)
  have ha : a ∈ (cyclicPowerSubgroup n a).val :=
    (le_sup_left : Subgroup.zpowers a ≤
      Subgroup.zpowers a ⊔ unitNthPowersSubgroup K n) (Subgroup.mem_zpowers a)
  obtain ⟨r, -, hr⟩ := exists_kummerRootSet
    (K := K) (Omega := L) n hn (cyclicPowerSubgroup n a).val ⟨a, ha⟩
  have hr0 : r ≠ 0 := by
    intro h
    have hz := hr
    rw [h, zero_pow n.ne_zero] at hz
    exact ((map_ne_zero (algebraMap K L)).mpr a.ne_zero) hz.symm
  have hrE : r ∈ E := IntermediateField.subset_adjoin K _ hr
  have haE : a ∈ finiteKummerRadicalSubgroup (K := K) (L := E) n := by
    refine ⟨Units.mk0 (⟨r, hrE⟩ : E) ?_, ?_⟩
    · intro h
      exact hr0 (congrArg Subtype.val h)
    · apply Units.ext
      apply Subtype.ext
      exact hr
  have hDelta : (cyclicPowerSubgroup n a).val ≤
      finiteKummerRadicalSubgroup (K := K) (L := E) n := by
    apply sup_le
    · exact Subgroup.zpowers_le.mpr haE
    · intro b hb
      obtain ⟨c, hc⟩ := (mem_unitNthPowersSubgroup_iff n).mp hb
      refine ⟨Units.map (algebraMap K E).toMonoidHom c, ?_⟩
      rw [← map_pow, hc]
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro s hs
    exact IntermediateField.subset_adjoin K _ ⟨⟨a, ha⟩, hs⟩
  · apply le_trans _ (kummerRadicalExtension_finiteKummerRadicalSubgroup_le E n hmu)
    apply IntermediateField.adjoin_le_iff.mpr
    rintro s ⟨b, hb⟩
    exact IntermediateField.subset_adjoin K _ ⟨⟨b.val, hDelta b.property⟩, hb⟩

/-- The radical subgroup of the root field is exactly the cyclic subgroup
modulo ambient powers, rather than an unspecified larger subgroup. -/
theorem rootField_radicalSubgroup
    (n : ℕ+) (hn : ((n : ℕ) : K) ≠ 0)
    (hmu : (primitiveRoots (n : ℕ) K).Nonempty) (a : Kˣ) :
    finiteKummerRadicalSubgroup (K := K) (L := rootField (L := L) n (a : K)) n =
      (cyclicPowerSubgroup n a).val := by
  rw [rootField_eq_cyclicPowerRadical n hn hmu]
  exact finiteKummerRadicalSubgroup_kummerRadicalExtension_eq n hn hmu
    (cyclicPowerSubgroup n a)

/-- Equality of root fields is equivalent to equality of cyclic power
subgroups when the roots of unity belong to the base field. -/
theorem rootField_eq_iff_cyclicPowerSubgroup_eq
    (n : ℕ+) (hn : ((n : ℕ) : K) ≠ 0)
    (hmu : (primitiveRoots (n : ℕ) K).Nonempty) (a b : Kˣ) :
    rootField (L := L) n (a : K) = rootField (L := L) n (b : K) ↔
      cyclicPowerSubgroup n a = cyclicPowerSubgroup n b := by
  constructor
  · intro h
    apply Subtype.ext
    rw [← rootField_radicalSubgroup (L := L) n hn hmu a,
      ← rootField_radicalSubgroup (L := L) n hn hmu b, h]
  · intro h
    rw [rootField_eq_cyclicPowerRadical n hn hmu,
      rootField_eq_cyclicPowerRadical n hn hmu, h]

/-- Equal full root fields give an explicit multiplicative relation modulo
n-th powers when the base contains the n-th roots of unity. -/
theorem exists_zpow_mul_power_of_rootField_eq
    (n : ℕ+) (hn : ((n : ℕ) : K) ≠ 0)
    (hmu : (primitiveRoots (n : ℕ) K).Nonempty) (a b : Kˣ)
    (h : rootField (L := L) n (a : K) = rootField (L := L) n (b : K)) :
    ∃ k : ℤ, ∃ c : Kˣ, b = a ^ k * c ^ (n : ℕ) := by
  have hDelta := (rootField_eq_iff_cyclicPowerSubgroup_eq n hn hmu a b).mp h
  have hb : b ∈ (cyclicPowerSubgroup n a).val := by
    rw [hDelta]
    exact (le_sup_left : Subgroup.zpowers b ≤
      Subgroup.zpowers b ⊔ unitNthPowersSubgroup K n) (Subgroup.mem_zpowers b)
  obtain ⟨u, hu, v, hv, huv⟩ := Subgroup.mem_sup.mp hb
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hu
  obtain ⟨c, hc⟩ := (mem_unitNthPowersSubgroup_iff n).mp hv
  exact ⟨k, c, by rw [hk, hc]; exact huv.symm⟩

omit [IsSepClosure K L] in
/-- After adjoining the relevant roots of unity, equal root fields over
the original base give equal cyclic power subgroups over the extended base.
No descent of the resulting power relation is asserted here. -/
theorem cyclicPowerSubgroup_baseChange_eq_of_rootField_eq
    (C : IntermediateField K L) [IsSepClosure C L]
    (n : ℕ+) (hn : ((n : ℕ) : C) ≠ 0)
    (hmu : (primitiveRoots (n : ℕ) C).Nonempty) (a b : Kˣ)
    (h : rootField (L := L) n (a : K) = rootField (L := L) n (b : K)) :
    cyclicPowerSubgroup n (Units.map (algebraMap K C).toMonoidHom a) =
      cyclicPowerSubgroup n (Units.map (algebraMap K C).toMonoidHom b) := by
  apply (rootField_eq_iff_cyclicPowerSubgroup_eq (L := L) n hn hmu _ _).mp
  exact rootField_baseChange_eq C n (a : K) (b : K) h

end AnabelianGeometry.KummerTheory
