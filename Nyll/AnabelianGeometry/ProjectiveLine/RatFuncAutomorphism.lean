import Mathlib.FieldTheory.RatFunc.IntermediateField
import Mathlib.Algebra.Polynomial.Degree.SmallDegree
import Nyll.SchemeTheory.ProjectiveSpace.CrossRatioSeparation

/-! # Automorphisms of the rational function field

An automorphism sends the coordinate to a fractional linear expression.
The degree-one assertion follows from the degree of the field extension
generated by a rational function; invertibility excludes a constant expression.
-/

noncomputable section

namespace AnabelianGeometry.ProjectiveLine

universe u
variable {K : Type u} [Field K]

/-- The image of the coordinate under a rational-function-field automorphism
has numerator and denominator of degree at most one. -/
theorem ratFunc_algEquiv_X_degree (e : RatFunc K ≃ₐ[K] RatFunc K) :
    max (e RatFunc.X).num.natDegree (e RatFunc.X).denom.natDegree = 1 := by
  have hgen : IntermediateField.adjoin K {e RatFunc.X} = ⊤ := by
    calc
      IntermediateField.adjoin K {e RatFunc.X} =
          (IntermediateField.adjoin K {RatFunc.X}).map e.toAlgHom := by
        rw [IntermediateField.adjoin_map, Set.image_singleton]
        rfl
      _ = ⊤ := by
        rw [RatFunc.adjoin_X, ← AlgHom.fieldRange_eq_map]
        exact e.fieldRange_eq_top
  rw [← RatFunc.finrank_eq_max_natDegree]
  exact IntermediateField.finrank_eq_one_iff_eq_top.mpr hgen

/-- Every automorphism of `K(X)` is fractional linear, with nonzero determinant. -/
theorem ratFunc_algEquiv_X_fractionalLinear (e : RatFunc K ≃ₐ[K] RatFunc K) :
    ∃ a b c d : K, a * d - b * c ≠ 0 ∧
      e RatFunc.X = (RatFunc.C a * RatFunc.X + RatFunc.C b) /
        (RatFunc.C c * RatFunc.X + RatFunc.C d) := by
  have hdeg := ratFunc_algEquiv_X_degree e
  obtain ⟨a, b, hab⟩ := Polynomial.exists_eq_X_add_C_of_natDegree_le_one
    ((le_max_left _ _).trans hdeg.le)
  obtain ⟨c, d, hcd⟩ := Polynomial.exists_eq_X_add_C_of_natDegree_le_one
    ((le_max_right _ _).trans hdeg.le)
  have hn : algebraMap (Polynomial K) (RatFunc K) (e RatFunc.X).num =
      RatFunc.C a * RatFunc.X + RatFunc.C b := by
    rw [hab, map_add, map_mul, RatFunc.algebraMap_C, RatFunc.algebraMap_X,
      RatFunc.algebraMap_C]
  have hd : algebraMap (Polynomial K) (RatFunc K) (e RatFunc.X).denom =
      RatFunc.C c * RatFunc.X + RatFunc.C d := by
    rw [hcd, map_add, map_mul, RatFunc.algebraMap_C, RatFunc.algebraMap_X,
      RatFunc.algebraMap_C]
  have hden : RatFunc.C c * RatFunc.X + RatFunc.C d ≠ 0 := by
    rw [← hd]
    simpa only [map_zero] using
      (RatFunc.algebraMap_injective K).ne (RatFunc.denom_ne_zero (e RatFunc.X))
  have he : e RatFunc.X = (RatFunc.C a * RatFunc.X + RatFunc.C b) /
      (RatFunc.C c * RatFunc.X + RatFunc.C d) := by
    rw [← hn, ← hd]
    exact (RatFunc.num_div_denom _).symm
  refine ⟨a, b, c, d, ?_, he⟩
  intro hdet
  have hvec : (c, d) ≠ (0 : K × K) := by
    intro hz
    have hc : c = 0 := congrArg Prod.fst hz
    have hd' : d = 0 := congrArg Prod.snd hz
    apply hden
    rw [hc, hd', map_zero, zero_mul, zero_add]
  obtain ⟨v, hv⟩ := exists_bracket_ne_zero (c, d) hvec
  have hbr : bracket (c, d) (a, b) = 0 := by
    change c * b - d * a = 0
    linear_combination -hdet
  let q : K := bracket (a, b) v / bracket (c, d) v
  have hprop : (a, b) = q • (c, d) :=
    eq_smul_of_bracket_eq_zero (c, d) (a, b) v hv hbr
  have ha : a = q * c := congrArg Prod.fst hprop
  have hb : b = q * d := congrArg Prod.snd hprop
  have hnum : RatFunc.C a * RatFunc.X + RatFunc.C b =
      RatFunc.C q * (RatFunc.C c * RatFunc.X + RatFunc.C d) := by
    rw [ha, hb, map_mul, map_mul]
    ring
  have hconst : e RatFunc.X = RatFunc.C q := by
    rw [he, hnum, mul_div_assoc, div_self hden, mul_one]
  have hX : (RatFunc.X : RatFunc K) = RatFunc.C q :=
    e.injective (hconst.trans (e.commutes q).symm)
  apply Polynomial.X_ne_C q
  apply RatFunc.algebraMap_injective K
  simpa only [RatFunc.algebraMap_X, RatFunc.algebraMap_C] using hX

end AnabelianGeometry.ProjectiveLine
