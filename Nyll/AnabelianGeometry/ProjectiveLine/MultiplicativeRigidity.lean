import Nyll.AnabelianGeometry.ProjectiveLine.InversionRigidity
import Mathlib.GroupTheory.OrderOfElement

/-!
# Reconstruction from two cyclic multiplicative subgroups

For a unit and its complementary unit of infinite order, their cyclic
subgroups determine the original parameter. This is the algebraic, non-torsion
step; no reconstruction of these subgroups from Galois data is postulated.
-/

namespace AnabelianGeometry.ProjectiveLine

universe u

variable {K : Type u} [Field K]

/-- Every root of the exceptional quadratic is a sixth root of unity. -/
theorem pow_six_eq_one_of_sq_sub_add_one_eq_zero {x : K}
    (h : x ^ 2 - x + 1 = 0) : x ^ 6 = 1 := by
  linear_combination (x ^ 4 + x ^ 3 - x - 1) * h

/-- Equality of the cyclic subgroups generated by two complementary units
recovers both units when the two original units have infinite order. -/
theorem units_eq_of_zpowers_eq_of_complement
    {x y c d : Kˣ}
    (hc : (x : K) + (c : K) = 1) (hd : (y : K) + (d : K) = 1)
    (hx : ¬ IsOfFinOrder x) (hco : ¬ IsOfFinOrder c)
    (hxy : Subgroup.zpowers x = Subgroup.zpowers y)
    (hcd : Subgroup.zpowers c = Subgroup.zpowers d) : x = y ∧ c = d := by
  have hc' : (c : K) = 1 - (x : K) := eq_sub_of_add_eq' hc
  have hd' : (d : K) = 1 - (y : K) := eq_sub_of_add_eq' hd
  have hx1 : (x : K) ≠ 1 := by
    intro hx1
    have hc0 : (c : K) = 0 := by rw [hc', hx1, sub_self]
    exact c.ne_zero hc0
  have hchoices : (y : K) = (x : K) ∨ (y : K) = (x : K)⁻¹ := by
    rcases (Subgroup.zpowers_eq_zpowers_iff hx).mp hxy with h | h
    · exact Or.inl (congrArg (fun z : Kˣ => (z : K)) h.symm)
    · right
      simpa only [Units.val_inv_eq_inv_val] using
        congrArg (fun z : Kˣ => (z : K)) h.symm
  have hcomplement : 1 - (y : K) = 1 - (x : K) ∨
      1 - (y : K) = (1 - (x : K))⁻¹ := by
    rcases (Subgroup.zpowers_eq_zpowers_iff hco).mp hcd with h | h
    · left
      rw [← hc', ← hd']
      exact congrArg (fun z : Kˣ => (z : K)) h.symm
    · right
      rw [← hc', ← hd']
      simpa only [Units.val_inv_eq_inv_val] using
        congrArg (fun z : Kˣ => (z : K)) h.symm
  have he : (x : K) ^ 2 - (x : K) + 1 ≠ 0 := by
    intro he
    apply hx
    apply isOfFinOrder_iff_pow_eq_one.mpr
    refine ⟨6, by decide, ?_⟩
    apply Units.ext
    exact pow_six_eq_one_of_sq_sub_add_one_eq_zero he
  have hv : (y : K) = (x : K) :=
    eq_of_inversion_choices x.ne_zero hx1 he hchoices hcomplement
  refine ⟨Units.ext hv.symm, ?_⟩
  apply Units.ext
  rw [hc', hd', hv]

end AnabelianGeometry.ProjectiveLine
