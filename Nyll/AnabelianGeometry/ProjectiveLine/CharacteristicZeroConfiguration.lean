module

public import Nyll.AnabelianGeometry.ProjectiveLine.EmbeddedMultiplicativeRigidity
public import Nyll.AlgebraicCurves.FunctionFields.Constants.ConstantFieldDescentFinset
public import Mathlib.SetTheory.Cardinal.Subfield
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Multiplicative configuration reconstruction in characteristic zero

Two cyclic multiplicative subgroups recover a normalized parameter up to
an explicit quadratic exception. The same data for one chosen square root
eliminates that exception. These statements concern actual field elements;
recovering their cyclic subgroups from a fundamental group is a separate step.
Only the subfield generated by the four parameters is embedded in the complex
numbers, so the ambient field need not be countable or finitely generated.
-/

@[expose] public section

open AlgebraicCurves.FunctionFields.Proofs.Exists_constantFieldDescent_finset

namespace AnabelianGeometry.ProjectiveLine

universe u

variable {K : Type u} [Field K] [CharZero K]

/-- In characteristic zero, the parameter and complementary cyclic subgroups
leave only the quadratic exceptional locus. -/
theorem units_eq_or_sq_sub_add_one_eq_zero
    {x y c d : Kˣ}
    (hc : (x : K) + (c : K) = 1) (hd : (y : K) + (d : K) = 1)
    (hxy : Subgroup.zpowers x = Subgroup.zpowers y)
    (hcd : Subgroup.zpowers c = Subgroup.zpowers d) :
    x = y ∨ (x : K) ^ 2 - (x : K) + 1 = 0 := by
  classical
  let C : Set K := {(x : K), (y : K), (c : K), (d : K)}
  let S : Subfield K := Subfield.closure C
  have hC : C.Finite := Set.toFinite C
  have : Countable C := hC.countable.to_subtype
  have : Countable S := by
    rw [← Cardinal.mk_le_aleph0_iff]
    exact (Subfield.cardinalMk_closure_le_max C).trans
      (max_le Cardinal.mk_le_aleph0 le_rfl)
  let liftUnit (a : Kˣ) (ha : (a : K) ∈ S) : Sˣ :=
    Units.mk0 ⟨(a : K), ha⟩ (fun hz => a.ne_zero (congrArg Subtype.val hz))
  let xS : Sˣ := liftUnit x (Subfield.subset_closure (by
    simp only [C, Set.mem_insert_iff, Set.mem_singleton_iff, true_or]))
  let yS : Sˣ := liftUnit y (Subfield.subset_closure (by
    simp only [C, Set.mem_insert_iff, Set.mem_singleton_iff, true_or, or_true]))
  let cS : Sˣ := liftUnit c (Subfield.subset_closure (by
    simp only [C, Set.mem_insert_iff, Set.mem_singleton_iff, true_or, or_true]))
  let dS : Sˣ := liftUnit d (Subfield.subset_closure (by
    simp only [C, Set.mem_insert_iff, Set.mem_singleton_iff, or_true]))
  let f : Sˣ →* Kˣ := Units.map S.subtype.toMonoidHom
  have hmap (a : Kˣ) (ha : (a : K) ∈ S) : f (liftUnit a ha) = a := Units.ext rfl
  have hf : Function.Injective f := by
    intro a b hab
    apply Units.ext
    exact Subtype.ext (congrArg Units.val hab)
  have hcyclic (a b : Sˣ) (h : Subgroup.zpowers (f a) = Subgroup.zpowers (f b)) :
      Subgroup.zpowers a = Subgroup.zpowers b := by
    apply Subgroup.map_injective hf
    rw [MonoidHom.map_zpowers, MonoidHom.map_zpowers]
    exact h
  have hcS : (xS : S) + (cS : S) = 1 := Subtype.ext hc
  have hdS : (yS : S) + (dS : S) = 1 := Subtype.ext hd
  have hxyS : Subgroup.zpowers xS = Subgroup.zpowers yS :=
    hcyclic xS yS (by rw [hmap x _, hmap y _]; exact hxy)
  have hcdS : Subgroup.zpowers cS = Subgroup.zpowers dS :=
    hcyclic cS dS (by rw [hmap c _, hmap d _]; exact hcd)
  obtain ⟨e⟩ := W7XDesc.nonempty_ringHom_complex S
  rcases units_eq_or_sq_sub_add_one_eq_zero_of_embedding e hcS hdS hxyS hcdS with h | h
  · left
    have hxy' := congrArg f h
    rw [hmap x _, hmap y _] at hxy'
    exact hxy'
  · exact Or.inr (congrArg Subtype.val h)

/-- Cyclic subgroup data for a parameter and one square-root lift recovers
the parameter without an exceptional-locus restriction. -/
theorem units_eq_of_cyclic_data_and_square_roots
    {x y c d t u v w : Kˣ}
    (hc : (x : K) + (c : K) = 1) (hd : (y : K) + (d : K) = 1)
    (hv : (t : K) + (v : K) = 1) (hw : (u : K) + (w : K) = 1)
    (ht : (t : K) ^ 2 = (x : K)) (hu : (u : K) ^ 2 = (y : K))
    (hxy : Subgroup.zpowers x = Subgroup.zpowers y)
    (hcd : Subgroup.zpowers c = Subgroup.zpowers d)
    (htu : Subgroup.zpowers t = Subgroup.zpowers u)
    (hvw : Subgroup.zpowers v = Subgroup.zpowers w) : x = y := by
  rcases units_eq_or_sq_sub_add_one_eq_zero hc hd hxy hcd with h | he
  · exact h
  · have hte : (t : K) ^ 2 - (t : K) + 1 ≠ 0 :=
      sq_sub_add_one_ne_zero_of_sq_eq (by norm_num) he ht
    rcases units_eq_or_sq_sub_add_one_eq_zero hv hw htu hvw with h | he'
    · apply Units.ext
      calc
        (x : K) = (t : K) ^ 2 := ht.symm
        _ = (u : K) ^ 2 := congrArg (fun z : Kˣ => (z : K) ^ 2) h
        _ = (y : K) := hu
    · exact False.elim (hte he')

end AnabelianGeometry.ProjectiveLine
