module

public import Nyll.SchemeTheory.Divisors.Basic
public import Nyll.SchemeTheory.Sheaves.IdealSheafComap
public import Mathlib.Algebra.Regular.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Actual flat pullback of effective Cartier ideals

On affine opens the original inverse-image ideal is generated by the
image of an original local equation. The actual flat section map preserves
its regularity, supplying the Cartier property without an additional
regularity hypothesis on the pulled-back divisor.
-/

@[expose] public section

universe u

open AlgebraicGeometry CategoryTheory

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- Flat pullback preserves the effective Cartier property of the
original ideal sheaf. -/
theorem IsEffectiveCartier.comap_of_flat
    {X Y : Scheme.{u}} {I : X.IdealSheafData} (hI : I.IsEffectiveCartier)
    (f : Y ⟶ X) [Flat f] : (I.comap f).IsEffectiveCartier := by
  intro y
  obtain ⟨U, hyU, r, hr, hIr⟩ := hI (f y)
  obtain ⟨V, hV, hyV, hVU⟩ :=
    exists_isAffineOpen_mem_and_subset (X := Y) (U := f ⁻¹ᵁ U.1) hyU
  let φ : Γ(X, U.1) →+* Γ(Y, V) := (f.appLE U.1 V hVU).hom
  let : Algebra Γ(X, U.1) Γ(Y, V) := φ.toAlgebra
  have : Module.Flat Γ(X, U.1) Γ(Y, V) :=
    Scheme.Hom.flat_appLE f U.2 hV hVU
  have hregular := IsSMulRegular.of_flat (S := Γ(Y, V)) hr.left
  change IsSMulRegular Γ(Y, V) (φ r) at hregular
  refine ⟨⟨V, hV⟩, hyV, φ r,
    (Commute.isRegular_iff (Commute.all (φ r))).mpr hregular, ?_⟩
  rw [I.ideal_comap_of_le f U ⟨V, hV⟩ hVU, hIr,
    Ideal.map_span, Set.image_singleton]

end AlgebraicGeometry.Scheme.IdealSheafData
