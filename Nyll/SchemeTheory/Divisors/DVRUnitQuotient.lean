/-!
# The actual unit quotient of a discrete valuation ring

For a DVR R with fraction field K, the cokernel of R units into K units
is infinite cyclic. A chosen uniformizer gives the generator. No
Henselianity, completeness, or residue-field finiteness is required.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace IsDiscreteValuationRing

universe u

variable (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K]

/-- The actual inclusion of ring units into fraction-field units,
with their operations written additively. -/
def fractionUnitInclusion :
    AddCommGrpCat.of (Additive Rˣ) ⟶ AddCommGrpCat.of (Additive Kˣ) :=
  AddCommGrpCat.ofHom (Units.map (algebraMap R K).toMonoidHom).toAdditive

/-- The actual cokernel of the ring-unit inclusion is infinite cyclic,
generated by the class of the chosen uniformizer. -/
def fractionUnitCokernelEquiv {π : R} (hπ : Irreducible π)
    (πK : Kˣ) (hπK : (πK : K) = algebraMap R K π) :
    ℤ ≃+ (cokernel (fractionUnitInclusion R K) : AddCommGrpCat.{u}) := by
  let f := fractionUnitInclusion R K
  let q := cokernel.π f
  let c := q.hom (Additive.ofMul πK)
  let l : ℤ →+ (cokernel f : AddCommGrpCat.{u}) :=
    { toFun := fun a => a • c
      map_zero' := zero_zsmul c
      map_add' := fun a b => add_zsmul c a b }
  have hkill (v : Additive Rˣ) : q.hom (f.hom v) = 0 :=
    ConcreteCategory.congr_hom (cokernel.condition f) v
  refine AddEquiv.ofBijective l ⟨?_, ?_⟩
  · intro a b hab
    have hz : q.hom ((a - b) • Additive.ofMul πK) = 0 := by
      rw [map_zsmul]
      change (a - b) • c = 0
      rw [sub_zsmul]
      change l a + -l b = 0
      rw [hab, add_neg_cancel]
    let T := ShortComplex.mk f q (cokernel.condition f)
    have hT : T.Exact := ShortComplex.exact_cokernel f
    obtain ⟨v, hv⟩ := (ShortComplex.ab_exact_iff T).mp hT _ hz
    have he : πK ^ (a - b) =
        Units.map (algebraMap R K).toMonoidHom v.toMul :=
      (congrArg Additive.toMul hv).symm
    exact sub_eq_zero.mp
      (uniformizer_zpow_eq_mappedUnit_exponent_zero R K hπ πK hπK
        (a - b) v.toMul he)
  · intro z
    obtain ⟨x, hxq⟩ := (AddCommGrpCat.epi_iff_surjective q).mp inferInstance z
    let x₀ : Additive Kˣ := x
    have hx₀q : q.hom x₀ = z := hxq
    obtain ⟨a, v, hv⟩ :=
      exists_units_eq_smul_zpow_of_irreducible hπ x₀.toMul.ne_zero
    have hx : x₀.toMul =
        Units.map (algebraMap R K).toMonoidHom v * πK ^ a := by
      apply Units.ext
      rw [Units.val_mul, Units.coe_map, Units.val_zpow_eq_zpow_val, hπK]
      change (x₀.toMul : K) =
        (algebraMap R K) (v : R) * (algebraMap R K π) ^ a
      simpa only [Units.smul_def, Algebra.smul_def] using hv
    have hxa : x₀ = f.hom (Additive.ofMul v) + a • Additive.ofMul πK :=
      congrArg Additive.ofMul hx
    have hzv : q.hom (f.hom (Additive.ofMul v)) = 0 := hkill (Additive.ofMul v)
    have hza : q.hom (a • Additive.ofMul πK) =
        a • q.hom (Additive.ofMul πK) :=
      q.hom.map_zsmul a (Additive.ofMul πK)
    have hclass : q.hom x₀ = a • q.hom (Additive.ofMul πK) := by
      calc
        q.hom x₀ = q.hom (f.hom (Additive.ofMul v) + a • Additive.ofMul πK) :=
          congrArg q.hom hxa
        _ = q.hom (f.hom (Additive.ofMul v)) + q.hom (a • Additive.ofMul πK) :=
          q.hom.map_add _ _
        _ = 0 + a • q.hom (Additive.ofMul πK) := congrArg₂ (· + ·) hzv hza
        _ = a • q.hom (Additive.ofMul πK) := zero_add _
    exact ⟨a, hclass.symm.trans hx₀q⟩

section Naturality

variable (S L : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
  [Field L] [Algebra S L] [IsFractionRing S L]
  (f : R →+* S) (g : K →+* L)
  (h : g.comp (algebraMap R K) = (algebraMap S L).comp f)

/-- A compatible map of local rings and fraction fields induces the actual
map on the cokernels of their unit inclusions. -/
def fractionUnitCokernelMap :
    cokernel (fractionUnitInclusion R K) ⟶ cokernel (fractionUnitInclusion S L) :=
  cokernel.map (fractionUnitInclusion R K) (fractionUnitInclusion S L)
    (AddCommGrpCat.ofHom (Units.map f.toMonoidHom).toAdditive)
    (AddCommGrpCat.ofHom (Units.map g.toMonoidHom).toAdditive) (by
      apply AddCommGrpCat.hom_ext
      ext a
      apply Additive.toMul.injective
      apply Units.ext
      exact RingHom.congr_fun h (a.toMul.val))

omit [IsDomain R] [IsDiscreteValuationRing R] [IsFractionRing R K]
  [IsDomain S] [IsDiscreteValuationRing S] [IsFractionRing S L] in
/-- The induced map is compatible with the actual cokernel projections. -/
theorem fractionUnitCokernelMap_π :
    cokernel.π (fractionUnitInclusion R K) ≫
      fractionUnitCokernelMap R K S L f g h =
    AddCommGrpCat.ofHom (Units.map g.toMonoidHom).toAdditive ≫
      cokernel.π (fractionUnitInclusion S L) := by
  exact cokernel.π_desc _ _ _

/-- A map carrying the chosen uniformizer to the chosen uniformizer
preserves the integer normalization of the actual unit quotient. -/
theorem fractionUnitCokernelMap_equiv_apply
    {π : R} (hπ : Irreducible π) (πK : Kˣ)
    (hπK : (πK : K) = algebraMap R K π)
    {ρ : S} (hρ : Irreducible ρ) (ρL : Lˣ)
    (hρL : (ρL : L) = algebraMap S L ρ)
    (hgπ : Units.map g.toMonoidHom πK = ρL) (n : ℤ) :
    (fractionUnitCokernelMap R K S L f g h).hom
      (fractionUnitCokernelEquiv R K hπ πK hπK n) =
    fractionUnitCokernelEquiv S L hρ ρL hρL n := by
  change (fractionUnitCokernelMap R K S L f g h).hom
    (n • (cokernel.π (fractionUnitInclusion R K)).hom (Additive.ofMul πK)) =
    n • (cokernel.π (fractionUnitInclusion S L)).hom (Additive.ofMul ρL)
  rw [map_zsmul]
  congr 1
  have hc := ConcreteCategory.congr_hom
    (fractionUnitCokernelMap_π R K S L f g h) (Additive.ofMul πK)
  change (fractionUnitCokernelMap R K S L f g h).hom
      ((cokernel.π (fractionUnitInclusion R K)).hom (Additive.ofMul πK)) =
    (cokernel.π (fractionUnitInclusion S L)).hom
      (Additive.ofMul (Units.map g.toMonoidHom πK)) at hc
  rw [hgπ] at hc
  exact hc

end Naturality

section UnramifiedNaturality

variable (S L : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
  [Field L] [Algebra S L] [IsFractionRing S L]
  [Algebra R S] [IsLocalHom (algebraMap R S)]
  [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]
  (g : K →+* L)
  (h : g.comp (algebraMap R K) = (algebraMap S L).comp (algebraMap R S))

/-- An unramified local map of DVRs carries an irreducible element to an
irreducible element. -/
theorem algebraMap_irreducible_of_unramified_local
    {π : R} (hπ : Irreducible π) : Irreducible (algebraMap R S π) := by
  apply (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr
  rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R) (S := S),
    (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ,
    Ideal.map_span, Set.image_singleton]

/-- An unramified local map of DVRs induces an isomorphism on the actual
fraction-field unit cokernels. This follows from the existing integer
normalization and preservation of a uniformizer. -/
theorem fractionUnitCokernelMap_isIso_of_unramified :
    IsIso (fractionUnitCokernelMap R K S L (algebraMap R S) g h) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hρ : Irreducible (algebraMap R S π) :=
    algebraMap_irreducible_of_unramified_local R S hπ
  let πK : Kˣ := Units.mk0 (algebraMap R K π)
    (fun hz => hπ.ne_zero ((IsFractionRing.injective R K)
      (hz.trans (map_zero _).symm)))
  let ρL : Lˣ := Units.map g.toMonoidHom πK
  have hρL : (ρL : L) = algebraMap S L (algebraMap R S π) :=
    RingHom.congr_fun h π
  let eR := fractionUnitCokernelEquiv R K hπ πK rfl
  let eS := fractionUnitCokernelEquiv S L hρ ρL hρL
  let M := fractionUnitCokernelMap R K S L (algebraMap R S) g h
  have hn (n : ℤ) : M.hom (eR n) = eS n :=
    fractionUnitCokernelMap_equiv_apply R K S L (algebraMap R S) g h
      hπ πK rfl hρ ρL hρL rfl n
  apply (ConcreteCategory.isIso_iff_bijective M).mpr
  have hm : ConcreteCategory.hom M = fun x => eS (eR.symm x) := by
    funext x
    obtain ⟨n, rfl⟩ := eR.surjective x
    rw [hn, eR.symm_apply_apply]
  rw [hm]
  exact eS.bijective.comp eR.symm.bijective

end UnramifiedNaturality

end IsDiscreteValuationRing
