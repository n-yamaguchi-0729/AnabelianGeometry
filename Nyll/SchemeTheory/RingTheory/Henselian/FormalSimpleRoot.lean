module

public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.AdicCompletion.Completeness
public import Mathlib.RingTheory.PowerSeries.Inverse

/-! # Actual formal lifts of simple roots

The power-series ring is complete for the ideal generated by its variable.
Hensel's theorem therefore constructs a root of a monic equation from a
simple constant-term root. The second theorem applies this construction to
the actual substitution `t + T` in a polynomial with finite coefficients.

No power-series root is assumed. The coefficient pole estimate for this
nonlinear algebraic root is a subsequent theorem, not a consequence claimed
from Hensel's theorem here.
-/

@[expose] public section

noncomputable section

namespace PowerSeries

variable {F : Type*} [Field F]

/-- A simple root of the constant polynomial has a unique actual lift to
the complete power-series ring. -/
theorem existsUnique_monic_root_of_constantCoeff
    (P : Polynomial (PowerSeries F)) (hP : P.Monic) (a : F)
    (ha : (P.map constantCoeff).eval a = 0)
    (hder : (P.map constantCoeff).derivative.eval a ≠ 0) :
    ∃! A : PowerSeries F, P.eval A = 0 ∧ constantCoeff A = a := by
  have heval (Q : Polynomial (PowerSeries F)) (A : PowerSeries F) :
      constantCoeff (Q.eval A) = (Q.map constantCoeff).eval (constantCoeff A) :=
    (Polynomial.eval_map_apply constantCoeff A).symm
  have hunit (A : PowerSeries F) (hA : constantCoeff A = a) :
      IsUnit (P.derivative.eval A) := by
    rw [isUnit_iff_constantCoeff, isUnit_iff_ne_zero, heval, hA,
      ← Polynomial.derivative_map]
    exact hder
  have hmem : P.eval (C a) ∈ Ideal.span {(X : PowerSeries F)} := by
    rw [Ideal.mem_span_singleton, X_dvd_iff, heval, constantCoeff_C]
    exact ha
  obtain ⟨A, hroot, hres⟩ := HenselianRing.is_henselian
    (I := Ideal.span {(X : PowerSeries F)}) P hP (C a) hmem
      ((hunit (C a) (constantCoeff_C a)).map (Ideal.Quotient.mk _))
  have hA : constantCoeff A = a := by
    rw [Ideal.mem_span_singleton, X_dvd_iff, map_sub, constantCoeff_C,
      sub_eq_zero] at hres
    exact hres
  refine ⟨A, ⟨hroot, hA⟩, ?_⟩
  intro B hB
  apply IsLocalRing.eq_of_eval_eq_zero_of_not_isUnit_sub hB.1 hroot
  · intro hunitBA
    have hu := isUnit_iff_constantCoeff.mp hunitBA
    have hzero : constantCoeff (B - A) = 0 := by
      rw [map_sub, hB.2, hA, sub_self]
    exact hu.ne_zero hzero
  · exact hunit B hB.2

/-- Substituting `t + T` into finite polynomial data produces the unique
formal continuation of a simple root at `t`. The variable of the outer
polynomial is the algebraic coordinate; the inner variable is translated. -/
theorem existsUnique_translated_monic_root
    (P : Polynomial (Polynomial F)) (hP : P.Monic) (t a : F)
    (ha : (P.map (Polynomial.evalRingHom t)).eval a = 0)
    (hder : (P.map (Polynomial.evalRingHom t)).derivative.eval a ≠ 0) :
    let τ := Polynomial.eval₂RingHom (C : F →+* PowerSeries F) (C t + X)
    ∃! A : PowerSeries F, (P.map τ).eval A = 0 ∧ constantCoeff A = a := by
  intro τ
  have hτ : constantCoeff.comp τ = Polynomial.evalRingHom t := by
    apply Polynomial.ringHom_ext
    · intro b
      change constantCoeff (Polynomial.eval₂ C (C t + X) (Polynomial.C b)) =
        Polynomial.eval t (Polynomial.C b)
      rw [Polynomial.eval₂_C, Polynomial.eval_C, constantCoeff_C]
    · change constantCoeff (Polynomial.eval₂ C (C t + X) Polynomial.X) =
        Polynomial.eval t Polynomial.X
      rw [Polynomial.eval₂_X, Polynomial.eval_X, map_add,
        constantCoeff_C, constantCoeff_X, add_zero]
  have hPτ : (P.map τ).map constantCoeff = P.map (Polynomial.evalRingHom t) := by
    rw [Polynomial.map_map, hτ]
  apply existsUnique_monic_root_of_constantCoeff (P.map τ) (hP.map τ) a
  · rw [hPτ]
    exact ha
  · rw [hPτ]
    exact hder

end PowerSeries
