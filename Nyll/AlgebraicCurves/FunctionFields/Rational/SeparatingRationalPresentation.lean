import Nyll.AlgebraicCurves.FunctionFields.Transcendence.CurveOver
import Nyll.AlgebraicCurves.FunctionFields.Transcendence.CurveSeparatingTranscendental
import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.FieldTheory.Separable
import Mathlib.RingTheory.Finiteness.Basic

/-!
# A separating rational presentation of a curve function field

A separating transcendental element supplies an actual algebra over the rational function
field. Its scalar tower, finite dimension and separability are transported along the
isomorphism with the intermediate field generated by that element.
-/

noncomputable section

open IntermediateField

namespace AlgebraicCurve.IsCurveOver

/-- A curve function field over a perfect field admits a compatible finite separable
algebra structure over the rational function field. The algebra structure is constructed
from a separating parameter and is not required to agree with any preexisting presentation. -/
theorem exists_separating_ratFunc_algebra {K F : Type*} [Field K] [Field F] [Algebra K F]
    [PerfectField K] [Algebra.EssFiniteType K F] [IsCurveOver K F] :
    ∃ (_ : Algebra (RatFunc K) F) (_ : IsScalarTower K (RatFunc K) F)
      (_ : FiniteDimensional (RatFunc K) F), Algebra.IsSeparable (RatFunc K) F := by
  obtain ⟨t, ht, hfinite, hsep⟩ := exists_separating_transcendental (K := K) (F := F)
  have : FiniteDimensional K⟮t⟯ F := hfinite
  have : Algebra.IsSeparable K⟮t⟯ F := hsep
  let e : RatFunc K ≃ₐ[K] K⟮t⟯ := RatFunc.algEquivOfTranscendental t ht
  let a : Algebra (RatFunc K) F :=
    ((algebraMap K⟮t⟯ F).comp e.toAlgHom.toRingHom).toAlgebra
  have hsq : (algebraMap (RatFunc K) F).comp e.symm.toRingEquiv.toRingHom =
      (RingEquiv.refl F).toRingHom.comp (algebraMap K⟮t⟯ F) := by
    apply RingHom.ext
    intro x
    change algebraMap K⟮t⟯ F (e (e.symm x)) = algebraMap K⟮t⟯ F x
    rw [e.apply_symm_apply]
  have htower : IsScalarTower K (RatFunc K) F := IsScalarTower.of_algebraMap_eq fun c => by
    change algebraMap K F c = algebraMap K⟮t⟯ F (e (algebraMap K (RatFunc K) c))
    rw [e.commutes, ← IsScalarTower.algebraMap_apply]
  have hfiniteRat : FiniteDimensional (RatFunc K) F :=
    Module.Finite.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl F) hsq
  have hsepRat : Algebra.IsSeparable (RatFunc K) F :=
    Algebra.IsSeparable.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl F) hsq
  exact ⟨a, htower, hfiniteRat, hsepRat⟩

end AlgebraicCurve.IsCurveOver
