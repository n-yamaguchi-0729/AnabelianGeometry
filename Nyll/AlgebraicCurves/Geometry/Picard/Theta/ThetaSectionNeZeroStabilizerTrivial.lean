namespace StabJacSol

theorem pullbackSection_zero {X X' : Scheme.{u}} (F : X' ⟶ X) (M : X.Modules) :
    Scheme.Modules.pullbackSection F (0 : 𝟙_ X.Modules ⟶ M) = 0 := by
  have : (Scheme.Modules.pullback F).IsLeftAdjoint := ⟨_,
    ⟨Scheme.Modules.pullbackPushforwardAdjunction F⟩⟩
  have : (Scheme.Modules.pullback F).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  rw [Scheme.Modules.pullbackSection_def]
  exact (congrArg ((Scheme.Modules.pullbackUnitIso F).inv ≫ ·) (Functor.map_zero _ _ _)).trans
    comp_zero

end StabJacSol
