import Nyll.AlgebraicCurves.Geometry.Picard.Functor
import Nyll.AlgebraicCurves.Geometry.Schemes.SchemeHomOver
import Nyll.AlgebraicCurves.Geometry.Schemes.RigidifiedLineBundleOfInvertible
import Nyll.AlgebraicCurves.Geometry.Sheaves.Scheme_Modules_IsInvertible_dual
import Nyll.SchemeTheory.Modules.Invertible
import Nyll.SchemeTheory.Modules.Monoidal
import Nyll.SchemeTheory.Modules.PullbackMonoidal

/-!
# Line bundles modulo tensoring with a line bundle from the base

This presheaf requires no section of the curve. Choosing a section gives a natural
equivalence with the existing rigidified Picard presheaf by normalizing along it.
No assertion of the sheaf property is included.
-/

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry NeronModelInfra

noncomputable section

namespace AlgebraicGeometry.RelPicard.Unrigidified

variable {R : Type u} [CommRing R] {C : Scheme.{u}}
  (c : C ⟶ Spec (CommRingCat.of R))

/-- An actual invertible module on a base change of the curve. -/
def LineBundle {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) : Type (u + 1) :=
  {L : (pullback c t).Modules // Scheme.Modules.IsInvertible L}

/-- Tensoring by the pullback of a base line bundle generates the relative Picard relation. -/
def BaseTwist {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (M N : LineBundle c t) : Prop :=
  ∃ Q : T.Modules, Scheme.Modules.IsInvertible Q ∧
    Nonempty (N.1 ≅ (Scheme.Modules.pullback (pullback.snd c t)).obj Q ⊗ M.1)

/-- Relative classes are the quotient by the equivalence relation generated by base twists. -/
def Classes {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) : Type (u + 1) :=
  Quot (BaseTwist c t)

variable {c}

theorem baseTwist_of_iso {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    {M N : LineBundle c t} (e : M.1 ≅ N.1) : BaseTwist c t M N :=
  ⟨𝟙_ T.Modules, Scheme.Modules.isInvertible_unit T,
    ⟨e.symm ≪≫ (λ_ M.1).symm ≪≫
      ((Scheme.Modules.pullbackUnitIso (pullback.snd c t)).symm ⊗ᵢ Iso.refl M.1)⟩⟩

/-- Pull back the actual module, with its existing invertibility proof. -/
def pullbackAlong {T T' : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    {t' : T' ⟶ Spec (CommRingCat.of R)} (ψ : SchemeHomOver t' t)
    (M : LineBundle c t) : LineBundle c t' :=
  ⟨(Scheme.Modules.pullback (baseChangeSnd c ψ)).obj M.1,
    M.2.pullback (baseChangeSnd c ψ)⟩

theorem baseTwist_pullback {T T' : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    {t' : T' ⟶ Spec (CommRingCat.of R)} (ψ : SchemeHomOver t' t)
    {M N : LineBundle c t} (h : BaseTwist c t M N) :
    BaseTwist c t' (pullbackAlong ψ M) (pullbackAlong ψ N) := by
  obtain ⟨Q, hQ, ⟨e⟩⟩ := h
  refine ⟨(Scheme.Modules.pullback ψ.1).obj Q, hQ.pullback ψ.1, ⟨?_⟩⟩
  exact (Scheme.Modules.pullback (baseChangeSnd c ψ)).mapIso e ≪≫
    Scheme.Modules.pullbackTensorObjIso (baseChangeSnd c ψ)
      ((Scheme.Modules.pullback (pullback.snd c t)).obj Q) M.1 ≪≫
    (((Scheme.Modules.pullbackComp _ _).app Q ≪≫
      (Scheme.Modules.pullbackCongr (baseChangeSnd_snd ψ)).app Q ≪≫
      ((Scheme.Modules.pullbackComp _ _).app Q).symm) ⊗ᵢ Iso.refl _)

/-- The induced map of relative line-bundle classes. -/
def classesMap {T T' : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    {t' : T' ⟶ Spec (CommRingCat.of R)} (ψ : SchemeHomOver t' t) :
    Classes c t → Classes c t' :=
  Quot.map (pullbackAlong ψ) (fun _ _ h => baseTwist_pullback ψ h)

/-- The unrigidified relative Picard presheaf, before any sheafification. -/
def presheaf (c : C ⟶ Spec (CommRingCat.of R)) :
    (Over (Spec (CommRingCat.of R)))ᵒᵖ ⥤ Type (u + 1) where
  obj X := Classes c X.unop.hom
  map {X Y} φ := TypeCat.ofHom (classesMap
    (c := c) (⟨φ.unop.left, Over.w φ.unop⟩ : SchemeHomOver Y.unop.hom X.unop.hom))
  map_id X := TypeCat.homEquiv.injective (funext fun x => by
    induction x using Quot.ind with
    | _ M =>
      exact Quot.sound (baseTwist_of_iso
        ((Scheme.Modules.pullbackCongr (baseChangeSnd_id c X.unop.hom)).app M.1 ≪≫
          (Scheme.Modules.pullbackId (pullback c X.unop.hom)).app M.1)))
  map_comp {X Y Z} φ ψ := TypeCat.homEquiv.injective (funext fun x => by
    induction x using Quot.ind with
    | _ M =>
      exact Quot.sound (baseTwist_of_iso
        ((Scheme.Modules.pullbackCongr
          (baseChangeSnd_comp c
            (⟨φ.unop.left, Over.w φ.unop⟩ : SchemeHomOver Y.unop.hom X.unop.hom)
            (⟨ψ.unop.left, Over.w ψ.unop⟩ : SchemeHomOver Z.unop.hom Y.unop.hom)).symm).app M.1 ≪≫
          ((Scheme.Modules.pullbackComp _ _).app M.1).symm)))

variable (ε : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) c)

/-- Normalize a relative class using the dual of its restriction to the section. -/
def normalize {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    Classes c t → RigidifiedLineBundle.Classes c ε t :=
  Quot.lift (fun M : LineBundle c t =>
    Quotient.mk _ (RigidifiedLineBundle.ofInvertible (ε := ε) M.1 M.2)) (by
    intro M N h
    obtain ⟨Q, hQ, ⟨e⟩⟩ := h
    exact Quotient.sound
      ⟨((RigidifiedLineBundle.nonempty_ofInvertible_iso_of_iso (ε := ε)
          N.2 ((hQ.pullback (pullback.snd c t)).tensor M.2) e).some ≪≫
        (RigidifiedLineBundle.nonempty_ofInvertible_pullbackSnd_tensor_iso
          (ε := ε) hQ M.2).some).symm⟩)

/-- Forget rigidification, retaining the relative class of the actual underlying module. -/
def forget {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    RigidifiedLineBundle.Classes c ε t → Classes c t :=
  Quotient.lift (fun M : RigidifiedLineBundle c ε t => Quot.mk _ ⟨M.L, M.isInvertible⟩)
    (fun _ _ h => Quot.sound (baseTwist_of_iso h.some))

/-- Normalization and forgetting are inverse on actual relative classes. -/
def classesEquiv {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    Classes c t ≃ RigidifiedLineBundle.Classes c ε t where
  toFun := normalize ε t
  invFun := forget ε t
  left_inv x := by
    induction x using Quot.ind with
    | _ M =>
      apply Eq.symm
      apply Quot.sound
      refine ⟨rigCorrection ε t M.1, (M.2.pullback (rigSection c t ε)).dual.1, ⟨?_⟩⟩
      exact β_ M.1 ((Scheme.Modules.pullback (pullback.snd c t)).obj (rigCorrection ε t M.1))
  right_inv x := by
    induction x using Quotient.ind with
    | _ M =>
      exact Quotient.sound (RigidifiedLineBundle.nonempty_ofInvertible_iso_of_rigidified M)

/-- The normalization equivalence is natural in the test scheme. -/
def presheafIso :
    presheaf c ≅ relPicardPresheaf c ε :=
  NatIso.ofComponents (fun X => Equiv.toIso (classesEquiv ε X.unop.hom))
    (fun {X Y} φ => by
      apply TypeCat.homEquiv.injective
      funext x
      induction x using Quot.ind with
      | _ M =>
        exact Quotient.sound
          ⟨(RigidifiedLineBundle.nonempty_ofInvertible_pullbackAlong_iso (ε := ε)
            (⟨φ.unop.left, Over.w φ.unop⟩ : SchemeHomOver Y.unop.hom X.unop.hom) M.2).some.symm⟩)

end AlgebraicGeometry.RelPicard.Unrigidified
