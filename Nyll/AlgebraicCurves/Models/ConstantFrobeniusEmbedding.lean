module

public import Nyll.AlgebraicCurves.Models.ConstantExtension.FiniteFrobenius
public import Nyll.AlgebraicCurves.Models.ConstantExtension.ModelExtension
public import Mathlib.Algebra.Algebra.Subalgebra.Basic

/-!
# The actual finite Frobenius in a supplied ambient field

The finite constant model is generated by the original function field and
its enlarged constants. Consequently every ambient automorphism fixing
the original function field and having the prescribed constant Frobenius
label restricts to the original finite Frobenius power. No comparison of
independently chosen automorphisms is a hypothesis.
-/

@[expose] public section

universe uGeom uField₁ uField₂

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.SmoothProperCurve

namespace AlgebraicCurve.CurveModel

attribute [local instance] SemilinearAut.instMulSemiringActionSubtypeProdRingAutMemSubgroup

variable {k κ K : Type uGeom} {F : Type uField₁} [Field k] [Fintype k] [Field κ] [IsAlgClosed κ]
    [Algebra k κ] [Algebra.IsAlgebraic k κ]
    [Field K] [Algebra k K] [IsCurveOver k K] [Algebra.EssFiniteType k K]
    [Field F] [Algebra κ F] [IsCurveOver κ F]
    (M₀ : CurveModel k K) [GeometricallyIntegral M₀.toBase]
    (M : CurveModel κ F) (e : M.C ≅ pullback M₀.toBase (specMap k κ))
    (he : e.hom ≫ pullback.snd M₀.toBase (specMap k κ) = M.toBase)
    (E : Type uGeom) [Field E] [Fintype E] [Algebra k E] [Algebra E κ]
    [IsScalarTower k E κ] [Algebra.IsAlgebraic E κ]

/-- The two original finite Frobenius constructions have the same power
action on the actual finite constant function field. -/
theorem constantFiniteFrobenius_pow_eq_semilinear_smul :
    let CE := pullback M₀.toBase (specMap k E)
    let cE := pullback.snd M₀.toBase (specMap k E)
    let _ : Algebra E CE.functionField := (baseToFunctionField cE).toAlgebra
    let _ : Algebra K CE.functionField :=
      M₀.constantModelAlgebra (ofSmoothProperCurve cE) (Iso.refl _)
    ∀ (r : ℕ) (x : CE.functionField),
      ((M₀.constantFiniteFrobenius M e he E) ^ r) x =
        (M₀.constantFiniteSemilinearFrobenius M e he E) ^ r • x := by
  intro CE cE aE aK r x
  induction r with
  | zero => rw [pow_zero, pow_zero, one_smul]; rfl
  | succ r ih =>
    rw [pow_succ', pow_succ', mul_smul]
    change M₀.constantFiniteFrobenius M e he E
        (((M₀.constantFiniteFrobenius M e he E) ^ r) x) =
      M₀.constantFiniteFrobenius M e he E
        ((M₀.constantFiniteSemilinearFrobenius M e he E) ^ r • x)
    exact congrArg (M₀.constantFiniteFrobenius M e he E) ih

/-- An original ambient source lift with its actual constant Frobenius
label restricts to the original finite-model Frobenius power. Only the
two literal coefficient embeddings of the given field map are supplied. -/
theorem constantFiniteFrobenius_pow_ambient
    (Ω : Type uGeom) [Field Ω] [Algebra K Ω] [Algebra κ Ω] :
    let CE := pullback M₀.toBase (specMap k E)
    let cE := pullback.snd M₀.toBase (specMap k E)
    let _ : Algebra E CE.functionField := (baseToFunctionField cE).toAlgebra
    let _ : Algebra K CE.functionField :=
      M₀.constantModelAlgebra (ofSmoothProperCurve cE) (Iso.refl _)
    ∀ (i : CE.functionField →+* Ω)
      (_ : ∀ a : K, i (algebraMap K CE.functionField a) = algebraMap K Ω a)
      (_ : ∀ a : E, i (algebraMap E CE.functionField a) =
        algebraMap κ Ω (algebraMap E κ a))
      (ρ : Gal(Ω/K)) (r : ℕ),
      (∀ a : κ, ρ (algebraMap κ Ω a) =
        algebraMap κ Ω (((FiniteField.frobeniusAlgEquivOfAlgebraic k κ) ^ r) a)) →
      ∀ x : CE.functionField,
        ρ (i x) = i (((M₀.constantFiniteFrobenius M e he E) ^ r) x) := by
  intro CE cE aE aK i hiK hiE ρ r hρ
  let ME : CurveModel E CE.functionField := ofSmoothProperCurve cE
  let akL : Algebra k CE.functionField :=
    ((algebraMap E CE.functionField).comp (algebraMap k E)).toAlgebra
  have hkEL : IsScalarTower k E CE.functionField :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hkKL : IsScalarTower k K CE.functionField :=
    M₀.constantModel_isScalarTower ME (Iso.refl _) (Category.id_comp _)
  have hgen : Algebra.adjoin K (Set.range (algebraMap E CE.functionField)) = ⊤ :=
    (M₀.constantModel_isIntegral_and_adjoin ME (Iso.refl _) (Category.id_comp _)).2
  let φE := FiniteField.frobeniusAlgEquivOfAlgebraic k E
  let φκ := FiniteField.frobeniusAlgEquivOfAlgebraic k κ
  let ψ := M₀.constantFiniteFrobenius M e he E
  have hconst (t : ℕ) (a : E) :
      (ψ ^ t) (algebraMap E CE.functionField a) =
        algebraMap E CE.functionField ((φE ^ t) a) := by
    induction t with
    | zero => rw [pow_zero, pow_zero]; rfl
    | succ t ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih,
        M₀.constantFiniteFrobenius_constants M e he E,
        pow_succ', AlgEquiv.mul_apply]
  have hnatural (t : ℕ) (a : E) :
      algebraMap E κ ((φE ^ t) a) = (φκ ^ t) (algebraMap E κ a) := by
    induction t with
    | zero => rw [pow_zero, pow_zero]; rfl
    | succ t ih =>
      rw [pow_succ', AlgEquiv.mul_apply, pow_succ', AlgEquiv.mul_apply]
      change algebraMap E κ (((φE ^ t) a) ^ Fintype.card k) =
        ((φκ ^ t) (algebraMap E κ a)) ^ Fintype.card k
      rw [map_pow, ih]
  let iK : CE.functionField →ₐ[K] Ω := { i with commutes' := hiK }
  let f : CE.functionField →ₐ[K] Ω := ρ.toAlgHom.comp iK
  let g : CE.functionField →ₐ[K] Ω := iK.comp (ψ ^ r).toAlgHom
  have hequalizer : Algebra.adjoin K (Set.range (algebraMap E CE.functionField)) ≤
      AlgHom.equalizer f g := by
    apply Algebra.adjoin_le
    rintro _ ⟨a, rfl⟩
    change ρ (i (algebraMap E CE.functionField a)) =
      i ((ψ ^ r) (algebraMap E CE.functionField a))
    rw [hiE, hρ, hconst, hiE, hnatural]
  intro x
  exact hequalizer (hgen.symm ▸ (show x ∈ (⊤ : Subalgebra K CE.functionField) from trivial))

end AlgebraicCurve.CurveModel
