module

public import Nyll.AlgebraicCurves.Models.ConstantExtension.BaseGeneration
public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# The actual constant extension between curve models

Use the original model's specified function-field equivalence to give the
geometric field its original-field algebra structure. The actual embedding
commutes with constants, is algebraic, and is generated by the extended constants.
-/

@[expose] public section

universe u v w

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.SmoothProperCurve

namespace AlgebraicCurve.CurveModel

variable {k Ω : Type u} {F₀ : Type v} {F : Type w} [Field k] [Field Ω] [Algebra k Ω]
    [Field F₀] [Algebra k F₀] [Field F] [Algebra Ω F]
    (M₀ : CurveModel k F₀) (M : CurveModel Ω F)
    (e : M.C ≅ pullback M₀.toBase (specMap k Ω))
    (he : e.hom ≫ pullback.snd M₀.toBase (specMap k Ω) = M.toBase)

/-- The actual original-field algebra structure on the geometric function field. -/
abbrev constantModelAlgebra : Algebra F₀ F :=
  ((M.constantBaseEmbedding M₀.toBase e).comp M₀.ffEquiv.toRingHom).toAlgebra

variable [Algebra k F] [IsScalarTower k Ω F]

include he in
/-- The two actual embeddings of the original constants agree. -/
theorem constantModel_isScalarTower :
    let _ : Algebra F₀ F := M₀.constantModelAlgebra M e
    IsScalarTower k F₀ F := by
  intro baseAlg
  apply IsScalarTower.of_algebraMap_eq
  intro a
  change algebraMap k F a = M.constantBaseEmbedding M₀.toBase e
    (M₀.ffEquiv (algebraMap k F₀ a))
  rw [M₀.ffEquiv_algebraMap, M.constantBaseEmbedding_constants M₀.toBase e he]
  exact IsScalarTower.algebraMap_apply k Ω F a

omit [Algebra k F] [IsScalarTower k Ω F] in
include he in
/-- The geometric field is generated over its constants by the original model's field. -/
theorem adjoin_original_field_eq_top :
    let _ : Algebra F₀ F := M₀.constantModelAlgebra M e
    IntermediateField.adjoin Ω (Set.range (algebraMap F₀ F)) = ⊤ := by
  intro baseAlg
  have hrange : Set.range (algebraMap F₀ F) = Set.range (M.constantBaseEmbedding M₀.toBase e) := by
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨M₀.ffEquiv a, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨M₀.ffEquiv.symm a, congrArg (M.constantBaseEmbedding M₀.toBase e)
        (M₀.ffEquiv.apply_symm_apply a)⟩
  rw [hrange]
  exact M.adjoin_constantBaseEmbedding_eq_top M₀.toBase e he

include he in
/-- Algebraic constants generate an actual algebraic extension of the original function field. -/
theorem constantModel_isIntegral_and_adjoin [Algebra.IsAlgebraic k Ω] :
    let _ : Algebra F₀ F := M₀.constantModelAlgebra M e
    Algebra.IsIntegral F₀ F ∧ Algebra.adjoin F₀ (Set.range (algebraMap Ω F)) = ⊤ := by
  intro baseAlg
  have tower : IsScalarTower k F₀ F := M₀.constantModel_isScalarTower M e he
  have hΩ (a : Ω) : IsAlgebraic F₀ (algebraMap Ω F a) :=
    ((Algebra.IsAlgebraic.isAlgebraic (R := k) a).algHom
      (IsScalarTower.toAlgHom k Ω F)).tower_top (L := F₀)
  let T := algebraicClosure F₀ F
  let S : IntermediateField Ω F :=
    { T.toSubfield with
      algebraMap_mem' := fun a => mem_algebraicClosure_iff.mpr (hΩ a) }
  have hle : IntermediateField.adjoin Ω (Set.range (algebraMap F₀ F)) ≤ S := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨a, rfl⟩
    exact T.algebraMap_mem a
  rw [M₀.adjoin_original_field_eq_top M e he] at hle
  have hAlg : Algebra.IsAlgebraic F₀ F := ⟨fun x =>
    mem_algebraicClosure_iff.mp (hle (show x ∈ (⊤ : IntermediateField Ω F) from trivial))⟩
  have hInt : Algebra.IsIntegral F₀ F := inferInstance
  let A := Algebra.adjoin F₀ (Set.range (algebraMap Ω F))
  have hA : Algebra.IsAlgebraic F₀ A := Algebra.IsAlgebraic.of_injective A.val Subtype.val_injective
  let A' := Algebra.IsAlgebraic.toIntermediateField A
  let U : IntermediateField Ω F :=
    { A'.toSubfield with
      algebraMap_mem' := fun a => Algebra.subset_adjoin ⟨a, rfl⟩ }
  have hU : IntermediateField.adjoin Ω (Set.range (algebraMap F₀ F)) ≤ U := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨a, rfl⟩
    exact A.algebraMap_mem a
  rw [M₀.adjoin_original_field_eq_top M e he] at hU
  refine ⟨hInt, top_unique ?_⟩
  intro x _
  exact hU (show x ∈ (⊤ : IntermediateField Ω F) from trivial)

end AlgebraicCurve.CurveModel
