module

public import Mathlib.Algebra.CharP.Algebra
public import Mathlib.FieldTheory.Galois.Infinite
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.GroupTheory.Coset.Card
public import Mathlib.LinearAlgebra.Dimension.FreeAndStrongRankCondition
public import Nyll.GaloisCohomology.ArtinSchreier.RootCharacter
public import Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.ArtinSchreierPolynomial

/-!
# The finite cyclic extension of an arbitrary Artin–Schreier parameter

Adjoining one actual root inside a separably closed overfield gives the full
splitting field. Its Galois group embeds into the additive prime field by
the existing root-difference character. No irreducibility or degree assumption
is needed, so parameters supplied by approximation can be used directly.
-/

@[expose] public section

noncomputable section

namespace ArtinSchreierTheory

open Polynomial ValuationTheory.DiscreteValuationField

variable (p : ℕ) [Fact p.Prime]

section Generator

variable {K E : Type*} [Field K] [Field E] [Algebra K E] [CharP E p]
    [Algebra.IsIntegral K E]

/-- The root-difference character is faithful when the root generates the extension. -/
theorem rootCharacter_injective_of_adjoin_eq_top
    (a : K) (β : E) (hβ : β ^ p - β = algebraMap K E a)
    (hgen : Algebra.adjoin K {β} = ⊤) :
    Function.Injective (rootCharacter p E a β hβ) := by
  intro σ τ hστ
  apply AlgEquiv.coe_toAlgHom_injective
  apply AlgHom.ext_of_adjoin_eq_top hgen
  intro x hx
  have hxβ : x = β := Set.mem_singleton_iff.mp hx
  subst x
  simp only [AlgEquiv.coe_toAlgHom]
  have hdiff := congrArg (fun z : Multiplicative (ZMod p) =>
    (ZMod.castHom (dvd_refl p) E) z.toAdd) hστ
  rw [rootCharacter_cast, rootCharacter_cast] at hdiff
  simpa only [sub_add_cancel] using congrArg (fun z : E => z + β) hdiff

variable [FiniteDimensional K E] [IsGalois K E]

omit [Algebra.IsIntegral K E] in
/-- A finite Galois extension generated by an Artin–Schreier root has degree dividing `p`. -/
theorem finrank_dvd_prime_of_adjoin_eq_top
    (a : K) (β : E) (hβ : β ^ p - β = algebraMap K E a)
    (hgen : Algebra.adjoin K {β} = ⊤) : Module.finrank K E ∣ p := by
  have hcard := Subgroup.card_dvd_of_injective (rootCharacter p E a β hβ).toMonoidHom
    (rootCharacter_injective_of_adjoin_eq_top p a β hβ hgen)
  rw [IsGalois.card_aut_eq_finrank K E] at hcard
  simpa only [Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card] using hcard

omit [Algebra.IsIntegral K E] in
/-- A parameter with no root over the base gives degree exactly `p`. -/
theorem finrank_eq_prime_of_adjoin_eq_top_of_no_root
    (a : K) (β : E) (hβ : β ^ p - β = algebraMap K E a)
    (hgen : Algebra.adjoin K {β} = ⊤)
    (ha : ∀ t : K, t ^ p - t ≠ a) : Module.finrank K E = p := by
  rcases (Fact.out : p.Prime).eq_one_or_self_of_dvd (Module.finrank K E)
      (finrank_dvd_prime_of_adjoin_eq_top p a β hβ hgen) with hdegree | hdegree
  · obtain ⟨t, ht⟩ := (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hdegree).2 β
    exfalso
    apply ha t
    apply (algebraMap K E).injective
    rw [map_sub, map_pow, ht]
    exact hβ
  · exact hdegree

end Generator

variable (K Ω : Type*) [Field K] [Field Ω] [CharP K p]
    [Algebra K Ω] [IsSepClosed Ω]

/-- Every Artin–Schreier parameter gives an actual finite cyclic intermediate
extension generated by one root of its defining equation. -/
theorem exists_finite_cyclic_extension (a : K) :
    ∃ E : FiniteGaloisIntermediateField K Ω,
      IsCyclic Gal(E/K) ∧ ∃ β : E,
        β ^ p - β = algebraMap K E a ∧ Algebra.adjoin K {β} = ⊤ := by
  have hcharΩ : CharP Ω p := (Algebra.charP_iff K Ω p).mp inferInstance
  obtain ⟨β, hβ⟩ := exists_root p Ω (algebraMap K Ω a)
  let P : Polynomial K := artinSchreierPolynomial p a
  have hPβ : aeval β P = 0 := by
    simp only [P, artinSchreierPolynomial, map_sub, map_pow, aeval_X, aeval_C,
      hβ, sub_self]
  have hβint : IsIntegral K β :=
    ⟨P, artinSchreierPolynomial_monic p (Fact.out : p.Prime).one_lt a, hPβ⟩
  let E : IntermediateField K Ω := IntermediateField.adjoin K {β}
  have hfinite : FiniteDimensional K E := IntermediateField.adjoin.finiteDimensional hβint
  let βE : E := IntermediateField.AdjoinSimple.gen K β
  have hcharE : CharP E p := (Algebra.charP_iff K E p).mp inferInstance
  have hβE : βE ^ p - βE = algebraMap K E a := by
    apply E.val.injective
    exact hβ
  have hgen : Algebra.adjoin K {βE} = ⊤ := by
    simpa only [βE, IntermediateField.adjoin.powerBasis_gen] using
      (IntermediateField.adjoin.powerBasis hβint).adjoin_gen_eq_top
  have hsep : P.Separable := artinSchreierPolynomial_separable p a
  have hsplit : (P.map (algebraMap K E)).Splits := by
    simpa only [P, artinSchreierPolynomial, Polynomial.map_sub,
      Polynomial.map_pow, map_X, map_C] using
      artinSchreierPolynomial_splits_of_root p (algebraMap K E a) βE hβE
  have hroot : βE ∈ P.rootSet E := by
    apply (mem_rootSet_of_ne hsep.ne_zero).mpr
    simp only [P, artinSchreierPolynomial, map_sub, map_pow, aeval_X, aeval_C,
      hβE, sub_self]
  have hrootgen : Algebra.adjoin K (P.rootSet E) = ⊤ := by
    apply top_unique
    rw [← hgen]
    exact Algebra.adjoin_mono (Set.singleton_subset_iff.mpr hroot)
  have hsplitting : P.IsSplittingField K E := ⟨hsplit, hrootgen⟩
  have hGalois : IsGalois K E := IsGalois.of_separable_splitting_field hsep
  let χ : Gal(E/K) →ₜ* Multiplicative (ZMod p) := rootCharacter p E a βE hβE
  have hχ : Function.Injective χ :=
    rootCharacter_injective_of_adjoin_eq_top p a βE hβE hgen
  have hcyclic : IsCyclic Gal(E/K) := isCyclic_of_injective χ.toMonoidHom hχ
  let Ef : FiniteGaloisIntermediateField K Ω := { toIntermediateField := E }
  exact ⟨Ef, hcyclic, βE, hβE, hgen⟩

end ArtinSchreierTheory
