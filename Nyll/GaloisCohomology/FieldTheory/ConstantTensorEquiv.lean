module

public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.TensorProduct.Finite
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Tensor presentation of a finite constant compositum

If the constants generate a finite extension and its degree is the constant-field
degree, multiplication identifies its actual field with the tensor product.
This compares concrete realizations without replacing their embeddings.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

namespace FieldTheory

variable (k E K L : Type*) [Field k] [Field E] [Field K] [Field L]
    [Algebra k E] [Algebra k K] [Algebra k L]
    [Algebra E L] [Algebra K L] [IsScalarTower k E L] [IsScalarTower k K L]
    [FiniteDimensional k E] [FiniteDimensional K L]

omit [FiniteDimensional k E] [FiniteDimensional K L] in
/-- Multiplication from the tensor product onto the generated constant extension is onto. -/
theorem constantTensor_surjective
    (hgen : Algebra.adjoin K (Set.range (algebraMap E L)) = ⊤) :
    Function.Surjective ((AlgHom.liftEquiv k K E L) (IsScalarTower.toAlgHom k E L)) := by
  let f := (AlgHom.liftEquiv k K E L) (IsScalarTower.toAlgHom k E L)
  apply (AlgHom.range_eq_top f).mp
  apply top_unique
  rw [← hgen]
  apply Algebra.adjoin_le
  rintro _ ⟨a, rfl⟩
  refine ⟨1 ⊗ₜ[k] a, ?_⟩
  change (1 : K) • algebraMap E L a = algebraMap E L a
  exact one_smul K _

/-- The actual field generated by constants of the expected degree has its tensor presentation. -/
def constantTensorEquiv
    (hgen : Algebra.adjoin K (Set.range (algebraMap E L)) = ⊤)
    (hdeg : Module.finrank K L = Module.finrank k E) :
    K ⊗[k] E ≃ₐ[K] L := by
  let f := (AlgHom.liftEquiv k K E L) (IsScalarTower.toAlgHom k E L)
  have hsurj : Function.Surjective f := constantTensor_surjective k E K L hgen
  have hdim : Module.finrank K (K ⊗[k] E) = Module.finrank K L :=
    (Module.finrank_baseChange (R := K) (S := k) (M' := E)).trans hdeg.symm
  exact AlgEquiv.ofBijective f
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mpr hsurj, hsurj⟩

/-- The tensor comparison is multiplication of the two given field embeddings. -/
theorem constantTensorEquiv_tmul
    (hgen : Algebra.adjoin K (Set.range (algebraMap E L)) = ⊤)
    (hdeg : Module.finrank K L = Module.finrank k E) (x : K) (a : E) :
    constantTensorEquiv k E K L hgen hdeg (x ⊗ₜ[k] a) =
      algebraMap K L x * algebraMap E L a := by
  change x • algebraMap E L a = _
  exact Algebra.smul_def x (algebraMap E L a)

end FieldTheory
