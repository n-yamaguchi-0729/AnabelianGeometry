/-!
# Finite ray-power quotients for the ordinary idele-class topology

The normalized degree splits the full ray class group into its finite
degree-zero kernel and one infinite cyclic direction. In particular the
full ray class group is finitely generated. Adding all positive `n`-th
powers to a ray subgroup therefore gives an actual open finite-index
subgroup of the ordinary idele-class group.

These concrete subgroups are cofinal among its open finite-index
subgroups. No realization of these quotients by field extensions is
assumed or asserted here.
-/

@[expose] public section

universe u v

noncomputable section

namespace FunctionField.RayClass

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    [AlgebraicCurve.HasPrincipalDivisors k K]

/-- The canonical commutative group structure on the idele-class quotient. -/
@[instance_reducible]
def powerRayIdeleClassCommGroup : CommGroup (IdeleClassGroup k K) :=
  QuotientGroup.Quotient.commGroup (G := IdeleGroup k K) (IdeleGroup.principalSubgroup k K)

attribute [local instance] powerRayIdeleClassCommGroup

local instance : IsMulCommutative (IdeleClassGroup k K) :=
  IsMulCommutative.of_comm (fun a b => mul_comm a b)

/-- The ray quotient inherits the canonical commutative group structure. -/
noncomputable local instance powerRayQuotientCommGroup (m : Modulus k K) :
    CommGroup (RayClassGroup m) :=
  QuotientGroup.Quotient.commGroup (rayClassSubgroup m)

/-- Full-constant normalized degree on the actual ray quotient. -/
def normalizedDegree (m : Modulus k K) : RayClassGroup m →* Multiplicative ℤ :=
  QuotientGroup.lift (rayClassSubgroup m)
    (IdeleClassGroup.normalizedDegree (k := k) (K := K)) (by
      intro c hc
      rw [IdeleClassGroup.normalizedDegree_ker]
      exact rayClassSubgroup_le_degreeZero m hc)

@[simp]
theorem normalizedDegree_mk (m : Modulus k K) (c : IdeleClassGroup k K) :
    normalizedDegree m (QuotientGroup.mk' (rayClassSubgroup m) c) =
      IdeleClassGroup.normalizedDegree (k := k) (K := K) c :=
  rfl

/-- The full-constant normalization does not change the ray degree-zero subgroup. -/
theorem normalizedDegree_ker (m : Modulus k K) :
    (normalizedDegree m).ker = (degree m).ker := by
  apply Subgroup.ext
  intro r
  obtain ⟨c, rfl⟩ := QuotientGroup.mk'_surjective (rayClassSubgroup m) r
  exact IdeleClassGroup.normalizedDegree_eq_one_iff c

section FiniteConstants

variable [Finite k] [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FunctionField k K]

/-- A full ray quotient is generated by its finite degree-zero part and one degree-one class. -/
theorem rayClassGroup_fg (m : Modulus k K) : Group.FG (RayClassGroup m) := by
  have hfinite : Finite (normalizedDegree m).ker := by
    rw [normalizedDegree_ker]
    exact finite_degreeZero m
  obtain ⟨c, hc⟩ := IdeleClassGroup.exists_normalizedDegree_one (k := k) (K := K)
  let t : RayClassGroup m := QuotientGroup.mk' (rayClassSubgroup m) c
  have ht : normalizedDegree m t = Multiplicative.ofAdd 1 := hc
  have htpow (z : ℤ) : normalizedDegree m (t ^ z) = Multiplicative.ofAdd z := by
    rw [map_zpow, ht]
    apply Multiplicative.ext
    simp only [toAdd_zpow, toAdd_ofAdd, zsmul_eq_mul, mul_one, Int.cast_id]
  let f : (normalizedDegree m).ker × Multiplicative ℤ →* RayClassGroup m :=
    { toFun := fun x => x.1.1 * t ^ x.2.toAdd
      map_one' := by
        change 1 * t ^ (0 : ℤ) = 1
        rw [zpow_zero, one_mul]
      map_mul' := fun x y => by
        change (x.1.1 * y.1.1) * t ^ (x.2.toAdd + y.2.toAdd) =
          (x.1.1 * t ^ x.2.toAdd) * (y.1.1 * t ^ y.2.toAdd)
        rw [zpow_add, mul_mul_mul_comm] }
  apply Group.fg_of_surjective (f := f)
  intro r
  let z : ℤ := (normalizedDegree m r).toAdd
  have hz : r / t ^ z ∈ (normalizedDegree m).ker := by
    change normalizedDegree m (r / t ^ z) = 1
    rw [map_div, htpow]
    exact div_self' _
  exact ⟨(⟨r / t ^ z, hz⟩, Multiplicative.ofAdd z), div_mul_cancel r (t ^ z)⟩

end FiniteConstants

/-- A ray subgroup enlarged by all `n`-th powers of actual idele classes. -/
def powerRaySubgroup (m : Modulus k K) (n : ℕ) : Subgroup (IdeleClassGroup k K) :=
  rayClassSubgroup m ⊔ (powMonoidHom (α := IdeleClassGroup k K) n).range

/-- Ray powers are exactly the inverse image of powers in the full ray class group. -/
theorem powerRaySubgroup_eq_comap (m : Modulus k K) (n : ℕ) :
    powerRaySubgroup m n =
      (powMonoidHom (α := RayClassGroup m) n).range.comap
        (QuotientGroup.mk' (rayClassSubgroup m)) := by
  let q := QuotientGroup.mk' (rayClassSubgroup m)
  have hmap : ((powMonoidHom (α := IdeleClassGroup k K) n).range).map q =
      (powMonoidHom (α := RayClassGroup m) n).range := by
    apply Subgroup.ext
    intro r
    constructor
    · rintro ⟨d, ⟨c, rfl⟩, rfl⟩
      exact ⟨q c, (map_pow q c n).symm⟩
    · rintro ⟨d, rfl⟩
      obtain ⟨c, rfl⟩ := QuotientGroup.mk'_surjective (rayClassSubgroup m) d
      exact ⟨c ^ n, ⟨c, rfl⟩, map_pow q c n⟩
  rw [← hmap]
  exact (QuotientGroup.comap_map_mk' (rayClassSubgroup m)
    (powMonoidHom (α := IdeleClassGroup k K) n).range).symm

section FiniteConstants

variable [Finite k] [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FunctionField k K]

/-- Every ray-power subgroup is open in the ordinary quotient topology. -/
theorem isOpen_powerRaySubgroup (m : Modulus k K) (n : ℕ) :
    IsOpen (powerRaySubgroup m n : Set (IdeleClassGroup k K)) :=
  Subgroup.isOpen_mono le_sup_left (isOpen_rayClassSubgroup m)

/-- Positive ray-power subgroups have finite index. -/
theorem finiteIndex_powerRaySubgroup (m : Modulus k K) {n : ℕ} (hn : n ≠ 0) :
    (powerRaySubgroup m n).FiniteIndex := by
  have : Group.FG (RayClassGroup m) := rayClassGroup_fg m
  have : (powMonoidHom (α := RayClassGroup m) n).range.FiniteIndex :=
    Subgroup.finiteIndex_range_powMonoidHom_of_fg (RayClassGroup m) hn
  rw [powerRaySubgroup_eq_comap]
  infer_instance

/-- Every ordinary open finite-index subgroup contains a ray-power subgroup with
power equal to its actual index. -/
theorem exists_powerRaySubgroup_le (H : Subgroup (IdeleClassGroup k K))
    (hH : IsOpen (H : Set (IdeleClassGroup k K))) [H.FiniteIndex] :
    ∃ m : Modulus k K, H.index ≠ 0 ∧ powerRaySubgroup m H.index ≤ H := by
  obtain ⟨m, hm⟩ := exists_rayClassSubgroup_le H hH
  refine ⟨m, Subgroup.FiniteIndex.index_ne_zero, sup_le hm ?_⟩
  rintro c ⟨d, rfl⟩
  exact H.pow_index_mem d

end FiniteConstants

end FunctionField.RayClass
