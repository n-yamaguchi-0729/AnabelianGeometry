module

public import Mathlib.GroupTheory.FiniteAbelian.Basic
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Idele.Cohomology.SUnitKernel
public import Nyll.GaloisCohomology.Kummer.Concrete.KummerCorrespondenceFormula
public import Nyll.GaloisCohomology.Kummer.Concrete.RadicalPowerSaturation

/-!
# Finite Kummer extensions generated by actual function-field S-units

The finite kernel of the divisor map and the finite rank of its target imply
finite generation of actual S-units. Noether's second isomorphism theorem then
makes their radical quotient finite. The common Kummer construction supplies
the resulting finite extension; no root field or pairing is reimplemented.
-/

@[expose] public section

noncomputable section

namespace FunctionField.SUnits

open AlgebraicCurve KummerTheory

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- The S-unit subgroup enlarged by ambient powers, as required by the existing
Kummer correspondence. -/
def kummerSubgroup (n : ℕ+) (S : Finset (Place k K)) : KummerSubgroup K n :=
  ⟨units k K S ⊔ unitNthPowersSubgroup K n, le_sup_right⟩

/-- The actual root field of the S-units inside the given overfield. -/
def kummerExtension {Ω : Type*} [Field Ω] [Algebra K Ω]
    (n : ℕ+) (S : Finset (Place k K)) : IntermediateField K Ω :=
  kummerRadicalExtension n (units k K S)

variable [Finite k] [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FunctionField k K] [HasPrincipalDivisors k K]

/-- The radical quotient of actual S-units is finite. The comparison is the
existing second isomorphism theorem, rather than a second quotient construction. -/
theorem finite_restrictedRadicalQuotient (n : ℕ+) (S : Finset (Place k K)) :
    Finite (RestrictedRadicalQuotient n (kummerSubgroup n S)) := by
  let U : Subgroup Kˣ := units k K S
  let P : Subgroup Kˣ := unitNthPowersSubgroup K n
  have hfg : Group.FG U := GroupFG.iff_add_fg.mpr
    (Module.Finite.iff_addGroup_fg.mp (finite_units k K S))
  have hpowers : (powMonoidHom (α := U) (n : ℕ)).range.FiniteIndex :=
    Subgroup.finiteIndex_range_powMonoidHom_of_fg U n.ne_zero
  have hinclusion : (powMonoidHom (α := U) (n : ℕ)).range ≤ P.subgroupOf U := by
    rintro x ⟨y, rfl⟩
    exact ⟨y.val, rfl⟩
  have hindex : (P.subgroupOf U).FiniteIndex := Subgroup.finiteIndex_of_le hinclusion
  have hfinite : Finite (U ⧸ P.subgroupOf U) := inferInstance
  exact Finite.of_equiv (U ⧸ P.subgroupOf U)
    (QuotientGroup.quotientInfEquivProdNormalQuotient U P).toEquiv

/-- Adjoining every prescribed S-unit root gives a finite-dimensional extension.
The abelian Galois structure is supplied by the existing Kummer theorem for this
same radical field whenever the base contains the roots of unity. -/
theorem kummerExtension_finiteDimensional {Ω : Type*} [Field Ω] [Algebra K Ω]
    [IsSepClosure K Ω] (n : ℕ+) (hn : ((n : ℕ) : K) ≠ 0)
    (hmu : (primitiveRoots (n : ℕ) K).Nonempty) (S : Finset (Place k K)) :
    FiniteDimensional K (kummerExtension (Ω := Ω) n S) := by
  have hfinite : Finite (RestrictedRadicalQuotient n (kummerSubgroup n S)) :=
    finite_restrictedRadicalQuotient n S
  have hfield : kummerRadicalExtension (K := K) (Omega := Ω) n
      (kummerSubgroup n S).1 = kummerExtension (Ω := Ω) n S :=
    kummerRadicalExtension_sup_unitNthPowers n hn hmu (units k K S)
  rw [← hfield]
  exact kummerRadicalExtension_finiteDimensional_of_finite_quotient
    n hn hmu (kummerSubgroup n S)

end FunctionField.SUnits
