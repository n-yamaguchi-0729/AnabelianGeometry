module

public import Mathlib.Algebra.CharP.Subring
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Nyll.AlgebraicCurves.Places.Ramification.FiniteRamification
public import Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.ArtinSchreierPolynomial

/-!
# Artin–Schreier extensions are unramified away from the parameter's poles

For an actual finite extension generated by a root of `X^p - X - a`,
integrality of `a` at the base place makes the root integral there. The
constant derivative `-1` makes the minimal-polynomial derivative a unit in
the integral closure. The existing different criterion then gives
ramification index one at every place above it.
-/

@[expose] public section

noncomputable section

namespace FunctionField

open AlgebraicCurve Polynomial ValuationTheory.DiscreteValuationField

variable {k K E : Type*} [Field k] [Field K] [Field E]
    [Algebra k K] [Algebra k E] [Algebra K E] [IsScalarTower k K E]
    [FiniteDimensional K E] [Algebra.IsSeparable K E]

/-- An Artin–Schreier generator can ramify only above a pole of its parameter.
The extension and its places are the actual fields and places of the curve. -/
theorem artinSchreier_ramificationIndex_eq_one
    (p : ℕ) [Fact p.Prime] [CharP K p]
    (a : K) (β : E) (hβ : β ^ p - β = algebraMap K E a)
    (hgen : Algebra.adjoin K {β} = ⊤)
    (w : Place k E) (ha : a ∈ (w.restrict K).toValuationSubring) :
    w.ramificationIndex K = 1 := by
  let v := w.restrict K
  let A := v.toValuationSubring
  let aAE : Algebra A E := Place.valuationSubringAlgebra E v
  have hAKE : IsScalarTower A K E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hcharA : CharP A p := CharP.subring K p v.toValuationSubring.toSubring
  let aA : A := ⟨a, ha⟩
  let P : Polynomial A := artinSchreierPolynomial p aA
  have hPmonic : P.Monic :=
    artinSchreierPolynomial_monic p (Fact.out : p.Prime).one_lt aA
  have hPβ : aeval β P = 0 := by
    simp only [P, artinSchreierPolynomial, map_sub, map_pow, aeval_X, aeval_C]
    change β ^ p - β - algebraMap K E a = 0
    rw [hβ, sub_self]
  have hβint : IsIntegral A β := ⟨P, hPmonic, hPβ⟩
  let B := Place.integralClosureAt E v
  have hABE : IsScalarTower A B E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let b : B := ⟨β, hβint⟩
  have hbint : IsIntegral A b := IsIntegralClosure.isIntegral A E b
  have hPb : aeval b P = 0 := by
    apply IsIntegralClosure.algebraMap_injective B A E
    rw [map_zero, ← aeval_algebraMap_apply]
    exact hPβ
  have hPderivative : derivative P = -1 :=
    artinSchreierPolynomial_derivative p aA
  obtain ⟨Q, hQ⟩ := minpoly.isIntegrallyClosed_dvd hbint hPb
  have hprod : aeval b (derivative P) =
      aeval b (derivative (minpoly A b)) * aeval b Q := by
    rw [hQ, derivative_mul, map_add, map_mul, map_mul, minpoly.aeval, zero_mul, add_zero]
  have hunit : IsUnit (aeval b (derivative (minpoly A b))) := by
    apply isUnit_of_mul_isUnit_left
    rw [← hprod, hPderivative, map_neg, map_one]
    exact (isUnit_one : IsUnit (1 : B)).neg
  have hmin : minpoly K β = (minpoly A b).map (algebraMap A K) :=
    minpoly.isIntegrallyClosed_eq_field_fractions K E hbint
  apply w.ramificationIndex_eq_one_of_minpoly_derivative_unit β hgen
  · intro i
    rw [hmin, coeff_map]
    exact ((minpoly A b).coeff i).2
  · let j : B →+* w.toValuationSubring :=
      (algebraMap B E).codRestrict w.toValuationSubring.toSubring
        (Place.forall_mem_of_restrict_eq (rfl : w.restrict K = v))
    have hjunit : IsUnit (j (aeval b (derivative (minpoly A b)))) := hunit.map j
    obtain ⟨u, hu⟩ := hjunit
    have hjcoe (c : B) : (j c : E) = algebraMap B E c := rfl
    have hord := w.ord_coe_unit u
    rw [hu, hjcoe] at hord
    rw [hmin, derivative_map, aeval_map_algebraMap]
    change w.ord (aeval (algebraMap B E b) (derivative (minpoly A b))) = 0
    rw [aeval_algebraMap_apply]
    exact hord

end FunctionField
