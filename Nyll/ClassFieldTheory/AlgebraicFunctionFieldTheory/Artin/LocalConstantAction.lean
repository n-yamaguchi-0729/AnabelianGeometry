module

public import Mathlib.FieldTheory.Finite.GaloisField
public import Mathlib.FieldTheory.Normal.Basic
public import Mathlib.RingTheory.Finiteness.Cardinality
public import Nyll.AlgebraicCurves.Divisors.ConstantExtension.ConstantExtension
public import Nyll.AlgebraicCurves.Places.ConstantExtension.RamificationIndexForgetConstantsEqOneAdjoinRangeEqTop
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Artin.LocalResidueNormalization
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Artin.LocalSymbol
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Completion.DecompositionResidue

/-!
# Actual constant action of the local arithmetic Artin symbol

In a finite extension generated by finite constants, geometric
unramifiedness supplies the arithmetic residue action of a local uniformizer.
The residue embedding of the constant field is injective. Restricting the
actual automorphism to those constants therefore lifts the residue power law
back to the original field.
-/

@[expose] public section

universe u v w x

noncomputable section

open AlgebraicCurve

namespace FunctionField

variable {k : Type u} {C : Type v} {K : Type w} {E : Type x}
    [Field k] [Finite k] [Field C] [Field K] [Field E]
    [Algebra k C] [Algebra k K] [Algebra k E] [Algebra C E] [Algebra K E]
    [IsScalarTower k C E] [IsScalarTower k K E]
    [FiniteDimensional k C] [FiniteDimensional K E] [IsAbelianGalois K E]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [Algebra (RatFunc k) E] [IsScalarTower k (RatFunc k) E] [FunctionField k E]
    [HasPrincipalDivisors k K] [HasPrincipalDivisors k E]

/-- In a constant-generated extension, the actual local Artin symbol of an
order-one element raises each embedded constant to the size of the base
residue field. -/
theorem localArtin_uniformizer_constant_action
    (hgen : Algebra.adjoin K (Set.range (algebraMap C E)) = ⊤)
    (W : Place k E) (x : (W.restrict K).adicCompletionˣ)
    (hx : (IdeleGroup.localOrder (W.restrict K) x).toAdd = 1) (c : C) :
    localArtin (K := K) W x (algebraMap C E c) =
      algebraMap C E (c ^ Nat.card (W.restrict K).ResidueField) := by
  have hCfinite : Finite C := Module.finite_of_finite k
  let WC : Place C E := W.extendConstants C
  have hW : WC.forgetConstants (K := k) = W := Place.ext rfl
  have he : W.ramificationIndex K = 1 := by
    have h := Place.ramificationIndex_forgetConstants_eq_one_of_adjoin_range_eq_top
      (K := k) (K' := C) (F := K) (F' := E) hgen WC
    rw [hW] at h
    exact h
  let σ : IdeleGroup.decompositionGroup (K := K) W :=
    localDecompositionArtin (K := K) W x
  let ρ : Gal(C/k) := (σ.1.restrictScalars k).restrictNormal C
  let aCres : Algebra C W.ResidueField :=
    (inferInstance : Algebra C WC.ResidueField)
  let y : W.toValuationSubring := algebraMap C WC.toValuationSubring c
  have hy : IdeleGroup.decompositionValuationEquiv W σ y =
      algebraMap C WC.toValuationSubring (ρ c) := by
    apply Subtype.ext
    rw [IdeleGroup.decompositionValuationEquiv_coe]
    exact (AlgEquiv.restrictNormal_commutes (σ.1.restrictScalars k) C c).symm
  have hres := IdeleGroup.decompositionResidueAut_residue (K := K) W σ y
  rw [hy] at hres
  have hpower := localDecompositionArtin_uniformizer_residue (K := K) W he x hx
    (IsLocalRing.residue W.toValuationSubring y)
  have hcy : IsLocalRing.residue W.toValuationSubring y =
      algebraMap C W.ResidueField c :=
    (IsScalarTower.algebraMap_apply C WC.toValuationSubring WC.ResidueField c).symm
  have hcρ : IsLocalRing.residue W.toValuationSubring
      (algebraMap C WC.toValuationSubring (ρ c)) = algebraMap C W.ResidueField (ρ c) :=
    (IsScalarTower.algebraMap_apply C WC.toValuationSubring WC.ResidueField (ρ c)).symm
  have hρc : ρ c = c ^ Nat.card (W.restrict K).ResidueField := by
    apply (algebraMap C W.ResidueField).injective
    rw [map_pow]
    exact hcρ.symm.trans (hres.symm.trans (hpower.trans
      (congrArg (fun z : W.ResidueField => z ^ Nat.card (W.restrict K).ResidueField) hcy)))
  change σ.1 (algebraMap C E c) = algebraMap C E (c ^ Nat.card (W.restrict K).ResidueField)
  exact (AlgEquiv.restrictNormal_commutes (σ.1.restrictScalars k) C c).symm.trans
    (congrArg (algebraMap C E) hρc)

end FunctionField
