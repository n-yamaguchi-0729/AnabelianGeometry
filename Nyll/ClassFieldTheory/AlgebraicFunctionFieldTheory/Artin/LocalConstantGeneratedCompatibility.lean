/-!
# Local-global reciprocity for constant-generated extensions

Local arithmetic Frobenius and native global reciprocity have the same
actual action on the finite constants. Generation identifies their
uniformizer values. The proved local Frobenius power formula and the
existing norm-kernel factor extend equality to every local element.
-/

@[expose] public section

universe u v w x

noncomputable section

open AlgebraicCurve
open scoped AlgebraicCurve.Place

namespace FunctionField

variable {k : Type u} {C : Type v} {K : Type w} {E : Type x}
    [Field k] [Finite k] [Field C] [Field K] [Field E]
    [Algebra k C] [Algebra k K] [Algebra k E] [Algebra C E] [Algebra K E]
    [IsScalarTower k C E] [IsScalarTower k K E]
    [FiniteDimensional k C] [FiniteDimensional K E] [IsAbelianGalois K E]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [Algebra (RatFunc k) E] [IsScalarTower k (RatFunc k) E] [FunctionField k E]
    [HasPrincipalDivisors k K] [HasPrincipalDivisors k E]

/-- Local and global reciprocity agree in every finite abelian extension
generated by finite constants, including cyclic auxiliary fixed-field bases. -/
theorem localArtin_constantGenerated
    (hgen : Algebra.adjoin K (Set.range (algebraMap C E)) = ⊤)
    (W : Place k E) (x : (W.restrict K).adicCompletionˣ) :
    localArtin (K := K) W x =
      abelianFiniteArtin k K E (IdeleClassGroup.mk (k := k) (K := K)
        (IdeleGroup.placeIdele (W.restrict K) x)) := by
  let A := algebraicClosure k K
  have hKft : Algebra.EssFiniteType k K := essFiniteType k K
  have hAfinite : Finite A := FieldTheory.finite_algebraicClosure_of_finite_base k K
  have hAcurve : IsCurveOver A K := isCurveOver_fullConstants k K
  let vA : Place A K := (W.restrict K).extendConstants A
  have hvfinite : Module.Finite A vA.ResidueField := IsCurveOver.finiteResidue vA
  have hcard : Nat.card (W.restrict K).ResidueField = Nat.card A ^ vA.deg :=
    Module.natCard_eq_pow_finrank (K := A) (V := vA.ResidueField)
  let π : (W.restrict K).adicCompletionˣ :=
    RestrictedProduct.DiscreteValuation.chosenLocalOrderSection
      (W.restrict K).adicCompletion
      ((W.restrict K).heightOneSpectrum.valuedAdicCompletion_surjective K) 1
  have hπ : (IdeleGroup.localOrder (W.restrict K) π).toAdd = 1 :=
    RestrictedProduct.DiscreteValuation.localOrder_chosenLocalOrderSection _ _ 1
  have hdegree : (IdeleClassGroup.normalizedDegree (k := k) (K := K)
      (IdeleClassGroup.mk (k := k) (K := K)
        (IdeleGroup.placeIdele (W.restrict K) π))).toAdd = vA.deg := by
    rw [IdeleClassGroup.normalizedDegree_placeIdele, hπ, one_mul]
  have hπcompare : localArtin (K := K) W π =
      abelianFiniteArtin k K E (IdeleClassGroup.mk (k := k) (K := K)
        (IdeleGroup.placeIdele (W.restrict K) π)) := by
    apply AlgEquiv.coe_toAlgHom_injective
    apply AlgHom.ext_of_adjoin_eq_top hgen
    rintro _ ⟨c, rfl⟩
    change localArtin (K := K) W π (algebraMap C E c) = _
    rw [localArtin_uniformizer_constant_action hgen W π hπ c, hcard]
    exact (abelianFiniteArtin_constantGenerated_constant k K E hgen _ vA.deg hdegree c).symm
  let WC : Place C E := W.extendConstants C
  have hW : WC.forgetConstants (K := k) = W := Place.ext rfl
  have he : W.ramificationIndex K = 1 := by
    have h := Place.ramificationIndex_forgetConstants_eq_one_of_adjoin_range_eq_top
      (K := k) (K' := C) (F := K) (F' := E) hgen WC
    rw [hW] at h
    exact h
  let F : IdeleGroup.decompositionGroup (K := K) W :=
    unramifiedDecompositionFrobenius (K := K) W he
  have hπF : localDecompositionArtin (K := K) W π = F := by
    rw [localDecompositionArtin_eq_unramifiedFrobenius_zpow W he π, hπ, zpow_one]
  have hF : localGlobalArtinFactor W F = F.val := by
    rw [← hπF, localGlobalArtinFactor_apply_localDecompositionArtin]
    exact hπcompare.symm
  let m : ℤ := (IdeleGroup.localOrder (W.restrict K) x).toAdd
  calc
    localArtin (K := K) W x = (F ^ m).val :=
      congrArg Subtype.val (localDecompositionArtin_eq_unramifiedFrobenius_zpow W he x)
    _ = localGlobalArtinFactor W (F ^ m) := by
      rw [map_zpow, hF]
      rfl
    _ = abelianFiniteArtin k K E (IdeleClassGroup.mk (k := k) (K := K)
        (IdeleGroup.placeIdele (W.restrict K) x)) := by
      rw [← localDecompositionArtin_eq_unramifiedFrobenius_zpow W he x]
      exact localGlobalArtinFactor_apply_localDecompositionArtin W x

end FunctionField
