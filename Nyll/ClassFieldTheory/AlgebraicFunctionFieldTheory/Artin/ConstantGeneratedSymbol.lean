/-!
# Native Artin action in constant-generated extensions

The actual native finite Artin map on an extension generated by finite
constants raises those constants to the full-constant cardinality powered
by the normalized idele degree. The formula follows by evaluating the
concrete fixed-field presentation in its ambient separable closure.
-/

@[expose] public section

universe u v w x

noncomputable section

namespace FunctionField

open ClassFormation LocalClassFieldTheory KummerTheory CyclicCohomology
open scoped IsMulCommutative

variable (k : Type u) (K : Type v) (E : Type w) {C : Type x}
    [Field k] [Finite k] [Field K] [Field E] [Field C]
    [Algebra k K] [Algebra k E] [Algebra K E] [IsScalarTower k K E]
    [Algebra k C] [Algebra C E] [IsScalarTower k C E] [FiniteDimensional k C]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [FiniteDimensional K E] [IsAbelianGalois K E]
    [AlgebraicCurve.HasPrincipalDivisors k K] [AlgebraicCurve.HasPrincipalDivisors k E]

/-- Native reciprocity on a constant-generated extension has the arithmetic
power law on each actual constant for nonnegative normalized idele degree. -/
theorem abelianFiniteArtin_constantGenerated_constant
    (hgen : Algebra.adjoin K (Set.range (algebraMap C E)) = ⊤)
    (a : IdeleClassGroup k K) (n : ℕ)
    (ha : (IdeleClassGroup.normalizedDegree (k := k) (K := K) a).toAdd = n) (c : C) :
    abelianFiniteArtin k K E a (algebraMap C E c) =
      algebraMap C E (c ^ (Nat.card (algebraicClosure k K) ^ n)) := by
  let Ω := SeparableClosure K
  let akΩ : Algebra k Ω := ((algebraMap K Ω).comp (algebraMap k K)).toAlgebra
  let aRΩ : Algebra (RatFunc k) Ω :=
    ((algebraMap K Ω).comp (algebraMap (RatFunc k) K)).toAlgebra
  have hkKΩ : IsScalarTower k K Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hRKΩ : IsScalarTower (RatFunc k) K Ω :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hkRΩ : IsScalarTower k (RatFunc k) Ω :=
    IsScalarTower.of_algebraMap_eq (fun x => congrArg (algebraMap K Ω)
      (IsScalarTower.algebraMap_apply k (RatFunc k) K x))
  let A := algebraicClosure k K
  have hkAΩ : IsScalarTower k A Ω := IsScalarTower.to₁₂₄ k A K Ω
  have hKft : Algebra.EssFiniteType k K := essFiniteType k K
  have hAfinite : Finite A := FieldTheory.finite_algebraicClosure_of_finite_base k K
  let H := intrinsicFiniteAbstractBase K
  let T := finiteGaloisAbstractExtension K E
  let i : E →ₐ[K] Ω := AlgebraicNumberTheory.separableEmbeddingIntoSeparableClosure K E
  let eF := finiteGaloisBaseFixedFieldEquiv K
  let eE := finiteGaloisFixedFieldEquivOfEmbedding K E i
  have hFfinite : FiniteDimensional K (abstractFixedField K Ω H.field) :=
    abstractFixedField_finiteDimensional K Ω H.field H.finite
  have hFgal : IsGalois K (abstractFixedField K Ω H.field) := IsGalois.of_algEquiv eF
  let aFE : Algebra (abstractFixedField K Ω H.field) (abstractFixedField K Ω T.field) :=
    (IntermediateField.inclusion (abstractFixedField_le K Ω T.below)).toRingHom.toAlgebra
  have hKFE : IsScalarTower K (abstractFixedField K Ω H.field)
      (abstractFixedField K Ω T.field) :=
    IsScalarTower.of_algebraMap_eq (fun _ => Subtype.ext rfl)
  have hFdegree : Module.finrank K (abstractFixedField K Ω H.field) = 1 := by
    rw [← eF.toLinearEquiv.finrank_eq, Module.finrank_self]
  let eG : Gal((abstractFixedField K Ω T.field)/(abstractFixedField K Ω H.field)) ≃*
      Gal(E/K) :=
    (ClassFieldTheory.galoisRestrictScalarsEquivOfFinrankOne hFdegree).trans
      (AlgEquiv.autCongr eE).symm
  let D := fullConstantDegreeData k K Ω
  let HR := H.toFiniteResidueAbstractField D
  let φ : Gal(E/K) := eG
    (abstractExtensionQuotientEquivGaloisGroup K Ω H.field T.field T.below T.normal
      (T.extensionQuotientMulEquiv.symm
        (D.unramifiedFrobenius HR T.field T.below)))
  have hu := finiteGaloisAbstractExtension_constantGenerated_isUnramified k K E hgen
  have hs := normQuotientEquivOfFixedFieldPresentation_unramified
    k K E Ω H T eF eE hu a
  have he := congrArg (fun f :
      (IdeleClassGroup k K ⧸ (IdeleClassGroup.norm (k := k) (K := K) (L := E)).range) ≃*
        Abelianization Gal(E/K) => f (QuotientGroup.mk a))
    (finiteNormQuotientEquivOfEmbedding_eq_intrinsic k K E i)
  have hArtin : abelianFiniteArtin k K E a = φ ^ n := by
    apply (Abelianization.equivOfComm (H := Gal(E/K))).injective
    change Abelianization.of (abelianFiniteArtin k K E a) = Abelianization.of (φ ^ n)
    rw [abelianFiniteArtin_of]
    have hs' : finiteArtin k K E a =
        Abelianization.of (φ ^ (IdeleClassGroup.normalizedDegree (k := k) (K := K) a).toAdd) := by
      apply he.symm.trans
      dsimp only [finiteNormQuotientEquivOfEmbedding]
      with_reducible exact hs
    rw [hs', ha, zpow_natCast]
  let σ : H.field.toSubgroup := Classical.choose
    (D.normalizedDegree_surjective HR (Multiplicative.ofAdd (1 : ZHat)))
  have hσ : D.normalizedDegree HR σ = Multiplicative.ofAdd (1 : ZHat) :=
    Classical.choose_spec (D.normalizedDegree_surjective HR (Multiplicative.ofAdd (1 : ZHat)))
  have hres : (HR.residueDegree : ℕ) = 1 := by
    change ((intrinsicFiniteAbstractBase K).residueDegree D : ℕ) = 1
    rw [intrinsicFiniteAbstractBase_eq_base, FiniteAbstractField.base_residueDegree]
    rfl
  have hdeg : D.degree σ.val = Multiplicative.ofAdd (1 : ZHat) := by
    apply Multiplicative.ext
    have hd := D.residueDegree_nsmul_normalizedDegree HR σ
    rw [hres, one_nsmul, hσ] at hd
    exact hd.symm
  have hq : T.extensionQuotientMulEquiv.symm
      (D.unramifiedFrobenius HR T.field T.below) =
        QuotientGroup.mk' (extensionSubgroup H.field T.field T.below) σ := rfl
  have hφ (b : C) : φ (algebraMap C E b) = algebraMap C E (b ^ Nat.card A) := by
    apply i.injective
    have hv := ClassFieldTheory.galoisPresentation_mk_apply_val
      K E Ω H.field T.field T.below T.normal eE hFdegree σ (algebraMap C E b)
    have hsep : IsSeparable A (i (algebraMap C E b)) := by
      have hb : IsSeparable k (i (algebraMap C E b)) :=
        ((Algebra.IsSeparable.isSeparable k b).map
          (IsScalarTower.toAlgHom k C E) (algebraMap C E).injective).map
            (i.restrictScalars k) i.injective
      exact hb.tower_top A
    have hpow := (absoluteConstantDegree_eq_frobenius_iff A K Ω σ.val).mp hdeg
      ⟨i (algebraMap C E b), mem_separableClosure_iff.mpr hsep⟩
    change i (φ (algebraMap C E b)) = _
    rw [map_pow, map_pow]
    change i (eG (abstractExtensionQuotientEquivGaloisGroup K Ω H.field T.field
      T.below T.normal (T.extensionQuotientMulEquiv.symm
        (D.unramifiedFrobenius HR T.field T.below))) (algebraMap C E b)) = _
    rw [hq]
    exact hv.trans hpow
  have hφn (m : ℕ) : ∀ b : C,
      (φ ^ m) (algebraMap C E b) = algebraMap C E (b ^ (Nat.card A ^ m)) := by
    induction m with
    | zero =>
      intro b
      simp only [pow_zero, AlgEquiv.one_apply, pow_one]
    | succ m hm =>
      intro b
      rw [pow_succ', AlgEquiv.mul_apply, hm, hφ, ← pow_mul, ← pow_succ]
  rw [hArtin]
  exact hφn n c

end FunctionField
