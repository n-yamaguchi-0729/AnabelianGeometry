module

public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Completion.DecompositionResidue
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Fields.ConstantFrobeniusPlace
public import Nyll.AlgebraicCurves.Places.Residue.ResidueFieldEqCompositum
