/-!
# Residue Frobenius in actual constant extensions

The residue field is generated by the extended constants and the base residue
field. Agreement on those two subfields identifies a place-fixing constant
Frobenius power with arithmetic Frobenius of the actual residue extension.
-/

@[expose] public section

noncomputable section

namespace FunctionField.IdeleGroup

open AlgebraicCurve
open scoped AlgebraicCurve.Place

variable {k C K E : Type*} [Field k] [Finite k] [Field C] [Field K] [Field E]
    [Algebra k C] [Algebra k K] [Algebra k E] [Algebra C E] [Algebra K E]
    [IsScalarTower k C E] [IsScalarTower k K E]
    [FiniteDimensional k C] [FiniteDimensional K E] [Algebra.IsSeparable K E]
    [IsCurveOver k K]

/-- A place-fixing constant automorphism with the residue-cardinality power law induces
arithmetic Frobenius on the actual residue field. -/
theorem decompositionResidueAut_eq_frobenius_of_constant_action
    (hgen : Algebra.adjoin K (Set.range (algebraMap C E)) = ⊤) (W : Place C E)
    (σ : decompositionGroup (K := K) (W.forgetConstants (K := k)))
    (hσ : ∀ c : C, σ.val (algebraMap C E c) =
      algebraMap C E c ^ Nat.card ((W.forgetConstants (K := k)).restrict K).ResidueField) :
    ∀ x : W.ResidueField,
      decompositionResidueAut (K := K) (W.forgetConstants (K := k)) σ x =
        x ^ Nat.card ((W.forgetConstants (K := k)).restrict K).ResidueField := by
  let w := W.forgetConstants (K := k)
  let v := w.restrict K
  have : Module.Finite k v.ResidueField := IsCurveOver.finiteResidue v
  have : Finite v.ResidueField := Module.finite_of_finite k
  let : Fintype v.ResidueField := Fintype.ofFinite _
  have : Module.Finite v.ResidueField w.ResidueField :=
    Module.finite_of_finrank_pos (w.inertiaDeg_pos (F := K))
  let : Algebra C w.ResidueField := (inferInstance : Algebra C W.ResidueField)
  let a := decompositionResidueAut (K := K) w σ
  let f := FiniteField.frobeniusAlgEquivOfAlgebraic v.ResidueField w.ResidueField
  have hc : ∀ c : C, a (algebraMap C w.ResidueField c) =
      f (algebraMap C w.ResidueField c) := by
    intro c
    let y : w.toValuationSubring := algebraMap C W.toValuationSubring c
    have hy : decompositionValuationEquiv w σ y = y ^ Nat.card v.ResidueField := by
      apply Subtype.ext
      rw [decompositionValuationEquiv_coe]
      exact hσ c
    have hres := decompositionResidueAut_residue (K := K) w σ y
    rw [hy, map_pow] at hres
    have hcy : IsLocalRing.residue w.toValuationSubring y =
        algebraMap C w.ResidueField c :=
      (IsScalarTower.algebraMap_apply C W.toValuationSubring W.ResidueField c).symm
    rw [hcy] at hres
    change a (algebraMap C w.ResidueField c) =
      (algebraMap C w.ResidueField c) ^ Fintype.card v.ResidueField
    simpa only [Nat.card_eq_fintype_card] using hres
  let T : IntermediateField C w.ResidueField :=
    { a.toRingHom.eqLocusField f.toRingHom with algebraMap_mem' := hc }
  have hle : IntermediateField.adjoin C (Set.range (w.restrictResidueMap K)) ≤ T := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨y, rfl⟩
    exact (a.commutes y).trans (f.commutes y).symm
  have htop : IntermediateField.adjoin C (Set.range (w.restrictResidueMap K)) = ⊤ :=
    Place.residueField_eq_compositum_of_isConstantFieldExtension hgen W
  rw [htop] at hle
  intro x
  have hx : a x = f x := hle IntermediateField.mem_top
  change a x = x ^ Fintype.card v.ResidueField at hx
  simpa only [Nat.card_eq_fintype_card] using hx

end FunctionField.IdeleGroup

namespace FunctionField

open AlgebraicCurve
open scoped AlgebraicCurve.Place

variable (k K Ω : Type*) [Field k] [Finite k] [Field K] [Field Ω]
    [Algebra k K] [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FunctionField k K] [Algebra K Ω] [IsSepClosed Ω]

/-- The degree power of constant Frobenius, as an element of the actual
decomposition group. -/
def fullConstantDegreeFrobeniusDecomposition (n : ℕ) [NeZero n]
    (w : Place (algebraicClosure k K) (fullConstantDegreeStage k K Ω n)) :
    IdeleGroup.decompositionGroup (K := K) w :=
  ⟨fullConstantDegreeFrobenius k K Ω n ^ (w.restrict K).deg,
    pow_degree_mem_decompositionGroup_fullConstantDegreeStage k K Ω n w
      (fullConstantDegreeFrobenius k K Ω n)⟩

/-- The degree power of actual constant Frobenius induces arithmetic Frobenius
on the residue field at every place. -/
theorem fullConstantDegreeFrobeniusDecomposition_residue (n : ℕ) [NeZero n]
    (w : Place (algebraicClosure k K) (fullConstantDegreeStage k K Ω n))
    (x : w.ResidueField) :
    IdeleGroup.decompositionResidueAut (K := K) w
        (fullConstantDegreeFrobeniusDecomposition k K Ω n w) x =
      x ^ Nat.card (w.restrict K).ResidueField := by
  have : Algebra.EssFiniteType k K := essFiniteType k K
  have : Finite (algebraicClosure k K) :=
    FieldTheory.finite_algebraicClosure_of_finite_base k K
  have : IsCurveOver (algebraicClosure k K) K := isCurveOver_fullConstants k K
  let C := (finiteConstantsInClosure (algebraicClosure k K) Ω n).toIntermediateField
  let E := IntermediateField.adjoin K (C : Set Ω)
  let w' : Place (algebraicClosure k K) E := w
  let : Algebra C E := constantAlgebra (K := K) C
  have : IsScalarTower (algebraicClosure k K) C E := constantScalarTower (K := K) C
  have : IsScalarTower (algebraicClosure k K) K E :=
    IsScalarTower.of_algebraMap_eq fun c =>
      Subtype.ext (IsScalarTower.algebraMap_apply (algebraicClosure k K) K Ω c)
  have : FiniteDimensional K E := finiteDimensional_constantExtension_of_finite (K := K) C
  have : IsGalois K E := isGalois_constantExtension (K := K) C
  let W := w'.extendConstants C
  have hw : W.forgetConstants (K := algebraicClosure k K) = w' := Place.ext rfl
  let σ := fullConstantDegreeFrobeniusDecomposition k K Ω n w
  let τ : IdeleGroup.decompositionGroup (K := K)
      (W.forgetConstants (K := algebraicClosure k K)) :=
    ⟨σ.val, by rw [hw]; exact σ.property⟩
  have hτ : ∀ c : C, τ.val (algebraMap C E c) = algebraMap C E c ^
      Nat.card ((W.forgetConstants (K := algebraicClosure k K)).restrict K).ResidueField := by
    intro c
    change σ.val (algebraMap C E c) = algebraMap C E c ^
      Nat.card ((W.forgetConstants (K := algebraicClosure k K)).restrict K).ResidueField
    rw [hw]
    change (fullConstantExtensionFrobenius (k := k) C ^ (w'.restrict K).deg)
        (constantEmbedding (K := K) C c) =
      constantEmbedding (K := K) C c ^ Nat.card (w'.restrict K).ResidueField
    rw [fullConstantExtensionFrobenius_pow_constant, map_pow]
    have : Module.Finite (algebraicClosure k K) (w'.restrict K).ResidueField :=
      IsCurveOver.finiteResidue (w'.restrict K)
    rw [Module.natCard_eq_pow_finrank (K := algebraicClosure k K)
      (V := (w'.restrict K).ResidueField)]
    rfl
  have h := IdeleGroup.decompositionResidueAut_eq_frobenius_of_constant_action
    (constantExtension_adjoin_constants (K := K) C) W τ hτ x
  exact h

/-- Reduction identifies the actual decomposition group of a constant extension
with its residue Galois group. In particular, the residue Frobenius lift is unique. -/
theorem decompositionResidueAut_bijective_fullConstantDegreeStage (n : ℕ) [NeZero n]
    (w : Place (algebraicClosure k K) (fullConstantDegreeStage k K Ω n)) :
    Function.Bijective (IdeleGroup.decompositionResidueAut (K := K) w) := by
  have : Algebra.EssFiniteType k K := essFiniteType k K
  have : Finite (algebraicClosure k K) :=
    FieldTheory.finite_algebraicClosure_of_finite_base k K
  have : IsCurveOver (algebraicClosure k K) K := isCurveOver_fullConstants k K
  let v := w.restrict K
  have : Module.Finite (algebraicClosure k K) v.ResidueField := IsCurveOver.finiteResidue v
  have : Finite v.ResidueField := Module.finite_of_finite (algebraicClosure k K)
  let : Fintype v.ResidueField := Fintype.ofFinite _
  have : Module.Finite v.ResidueField w.ResidueField :=
    Module.finite_of_finrank_pos (w.inertiaDeg_pos (F := K))
  have : Finite w.ResidueField := Module.finite_of_finite v.ResidueField
  let σ := fullConstantDegreeFrobeniusDecomposition k K Ω n w
  have hσ : IdeleGroup.decompositionResidueAut (K := K) w σ =
      FiniteField.frobeniusAlgEquivOfAlgebraic v.ResidueField w.ResidueField := by
    apply AlgEquiv.ext
    intro x
    change IdeleGroup.decompositionResidueAut (K := K) w σ x =
      x ^ Fintype.card v.ResidueField
    simpa only [Nat.card_eq_fintype_card] using
      fullConstantDegreeFrobeniusDecomposition_residue k K Ω n w x
  have hs : Function.Surjective (IdeleGroup.decompositionResidueAut (K := K) w) := by
    intro τ
    obtain ⟨m, hm⟩ :=
      (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow v.ResidueField w.ResidueField).2 τ
    refine ⟨σ ^ m.val, ?_⟩
    rw [map_pow, hσ]
    exact hm
  have he : w.ramificationIndex K = 1 := ramificationIndex_constantExtension (K := K)
    (finiteConstantsInClosure (algebraicClosure k K) Ω n).toIntermediateField w
  have hcard : Nat.card (IdeleGroup.decompositionGroup (K := K) w) =
      Nat.card (w.ResidueField ≃ₐ[v.ResidueField] w.ResidueField) := by
    rw [IdeleGroup.decompositionGroup_card_eq_ramificationIndex_mul_inertiaDeg,
      he, one_mul, IsGalois.card_aut_eq_finrank]
    rfl
  exact hs.bijective_of_nat_card_le hcard.le

end FunctionField
