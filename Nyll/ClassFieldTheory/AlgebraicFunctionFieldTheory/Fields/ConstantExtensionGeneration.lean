module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Fields.ConstantExtensionGalois

/-!
# Constants generate the actual constant compositum as an algebra

The actual compositum is generated by its embedded constants as an intermediate
field. Its finiteness upgrades this to algebra generation, supplying the concrete
hypothesis of the existing unramified constant-extension theorem.
-/

@[expose] public section

noncomputable section

namespace FunctionField

private theorem adjoin_range_of_fieldRanges
    (R A B F : Type*) [Field R] [Field A] [Field B] [Field F]
    [Algebra R A] [Algebra R B] [Algebra R F] [Algebra A F] [Algebra B F]
    [IsScalarTower R A F] [IsScalarTower R B F]
    (hgen : (IsScalarTower.toAlgHom R A F).fieldRange ⊔
      (IsScalarTower.toAlgHom R B F).fieldRange = ⊤) :
    IntermediateField.adjoin A (Set.range (algebraMap B F)) = ⊤ := by
  let T := IntermediateField.adjoin A (Set.range (algebraMap B F))
  have hA : (IsScalarTower.toAlgHom R A F).fieldRange ≤ T.restrictScalars R := by
    rintro x ⟨a, rfl⟩
    exact T.algebraMap_mem a
  have hB : (IsScalarTower.toAlgHom R B F).fieldRange ≤ T.restrictScalars R := by
    rintro x ⟨b, rfl⟩
    exact IntermediateField.subset_adjoin A _ ⟨b, rfl⟩
  have h := sup_le hA hB
  rw [hgen] at h
  have ht : T.restrictScalars R = ⊤ := top_unique h
  exact (IntermediateField.restrictScalars_eq_top_iff (F := A) (K := R)).mp ht

variable {k K Ω : Type*} [Field k] [Field K] [Field Ω]
    [Algebra k K] [Algebra K Ω] [Algebra k Ω] [IsScalarTower k K Ω]
    [Finite k] (C : IntermediateField k Ω) [FiniteDimensional k C]

omit [Finite k] [FiniteDimensional k C] in
/-- Over the extended constants, the actual compositum is generated by the original field. -/
theorem constantExtension_adjoin_originalField :
    let _ : Algebra C (IntermediateField.adjoin K (C : Set Ω)) :=
      constantAlgebra (K := K) C
    IntermediateField.adjoin C
      (Set.range (algebraMap K (IntermediateField.adjoin K (C : Set Ω)))) = ⊤ := by
  intro algC
  let L := IntermediateField.adjoin K (C : Set Ω)
  have htower : IsScalarTower k C L := constantScalarTower (K := K) C
  have hC : IsScalarTower.toAlgHom k C L = constantEmbedding (K := K) C := by
    ext a
    rfl
  apply adjoin_range_of_fieldRanges k C K L
  rw [hC]
  exact constantExtension_generatorRanges C

/-- The image of the constant inclusion generates the actual compositum as an
algebra over the function field. -/
theorem constantExtension_adjoin_range :
    Algebra.adjoin K (Set.range (constantEmbedding (K := K) C)) = ⊤ := by
  let E := IntermediateField.adjoin K (C : Set Ω)
  let iC : C →ₐ[k] E := constantEmbedding (K := K) C
  have himage : E.val '' Set.range iC = (C : Set Ω) := by
    apply Set.ext
    intro x
    constructor
    · rintro ⟨y, ⟨c, rfl⟩, rfl⟩
      exact c.2
    · intro hx
      exact ⟨iC ⟨x, hx⟩, ⟨⟨x, hx⟩, rfl⟩, rfl⟩
  have hfield : IntermediateField.adjoin K (Set.range iC) = ⊤ := by
    apply IntermediateField.map_injective E.val
    rw [IntermediateField.adjoin_map, himage,
      ← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val]
  have : FiniteDimensional K E := finiteDimensional_constantExtension_of_finite (K := K) C
  exact (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
    (F := K) (S := Set.range iC)
    (fun x _ => Algebra.IsAlgebraic.isAlgebraic x)).mp hfield

/-- With the actual constant scalar structure, the constants generate the
compositum as an algebra over the original function field. -/
theorem constantExtension_adjoin_constants :
    let _ : Algebra C (IntermediateField.adjoin K (C : Set Ω)) :=
      constantAlgebra (K := K) C
    Algebra.adjoin K
      (Set.range (algebraMap C (IntermediateField.adjoin K (C : Set Ω)))) = ⊤ := by
  intro hC
  exact constantExtension_adjoin_range (K := K) C

end FunctionField
