module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.FieldTheory.SeparableClosure
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Fields.AbsoluteConstantDegree
public import Nyll.ClassFieldTheory.LocalClassFieldTheory.Finite.LocalReciprocity.ConcreteReciprocityTransport
public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.SeparableClosureEmbedding

/-!
# Constant-generated extensions for the actual degree datum

An extension generated by a finite constant field embeds into the maximal
constant extension in the separable closure. Its fixing subgroup therefore
contains the inertia of the concrete degree datum. This applies to the
cyclic auxiliary extension after changing its base to the cyclic fixed field.
-/

@[expose] public section

universe u v w x

noncomputable section

namespace FunctionField

open ClassFormation LocalClassFieldTheory

variable (k : Type u) (K : Type v) (E : Type w) {C : Type x}
    [Field k] [Finite k] [Field K] [Field E] [Field C]
    [Algebra k K] [Algebra k E] [Algebra K E] [IsScalarTower k K E]
    [Algebra k C] [Algebra C E] [IsScalarTower k C E] [FiniteDimensional k C]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [FiniteDimensional K E] [IsGalois K E]

/-- A finite Galois extension generated by finite constants is unramified
for the concrete constant-field degree datum used in native reciprocity. -/
theorem finiteGaloisAbstractExtension_constantGenerated_isUnramified
    (hgen : Algebra.adjoin K (Set.range (algebraMap C E)) = ⊤) :
    (finiteGaloisAbstractExtension K E).IsUnramified
      (fullConstantDegreeData k K (SeparableClosure K)) := by
  let Ω := SeparableClosure K
  let aΩ : Algebra k Ω := ((algebraMap K Ω).comp (algebraMap k K)).toAlgebra
  have hkKΩ : IsScalarTower k K Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let A := algebraicClosure k K
  have hkAΩ : IsScalarTower k A Ω := IsScalarTower.to₁₂₄ k A K Ω
  let j : E →ₐ[K] Ω := AlgebraicNumberTheory.separableEmbeddingIntoSeparableClosure K E
  let F : IntermediateField K Ω :=
    IntermediateField.adjoin K (separableClosure A Ω : Set Ω)
  have hgenF : (⊤ : Subalgebra K E) ≤ F.toSubalgebra.comap j := by
    rw [← hgen]
    apply Algebra.adjoin_le
    rintro _ ⟨c, rfl⟩
    apply IntermediateField.subset_adjoin K
    apply mem_separableClosure_iff.mpr
    have hc : IsSeparable k (j (algebraMap C E c)) :=
      ((Algebra.IsSeparable.isSeparable k c).map
        (IsScalarTower.toAlgHom k C E) (algebraMap C E).injective).map
          (j.restrictScalars k) j.injective
    exact hc.tower_top A
  have hE : j.fieldRange ≤ F := by
    rintro _ ⟨x, rfl⟩
    exact hgenF (show x ∈ (⊤ : Subalgebra K E) from trivial)
  let D := fullConstantDegreeData k K Ω
  let T := finiteGaloisAbstractExtension K E
  apply (T.isUnramified_iff_inertia_le D).mpr
  intro σ hσ
  have hf : σ ∈ F.fixingSubgroup := by
    rw [← fullConstantDegreeData_inertia k K Ω]
    exact hσ.2
  change σ ∈ j.fieldRange.fixingSubgroup
  exact IntermediateField.fixingSubgroup_le hE hf

end FunctionField
