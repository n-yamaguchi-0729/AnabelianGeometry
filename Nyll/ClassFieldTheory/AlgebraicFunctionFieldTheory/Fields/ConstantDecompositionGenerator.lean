module

public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.FieldTheory.Galois.Basic
public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.OrderOfElement
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Completion.Decomposition
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Fields.ConstantExtensionTower
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Fields.ConstantFrobeniusPlace

/-!
# A generator of decomposition groups in the constant tower

For the actual degree-`n` extension of the full constants, the decomposition
group at a place over a degree-`d` place is generated by the `d`th power of
arithmetic constant Frobenius. Membership follows from the action on places,
and equality follows from the exact order of Frobenius and the splitting
degree of the place.
-/

@[expose] public section

noncomputable section

namespace FunctionField

open AlgebraicCurve
open scoped AlgebraicCurve.Place

variable (k K Ω : Type*) [Field k] [Finite k] [Field K] [Field Ω]
    [Algebra k K] [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FunctionField k K] [Algebra K Ω] [IsSepClosed Ω]

/-- The decomposition group of an actual constant extension is generated by
arithmetic Frobenius raised to the degree of the place below. -/
theorem decompositionGroup_fullConstantDegreeStage_eq_zpowers (n : ℕ) [NeZero n]
    (w : Place (algebraicClosure k K) (fullConstantDegreeStage k K Ω n)) :
    IdeleGroup.decompositionGroup (K := K) w =
      Subgroup.zpowers
        ((fullConstantDegreeFrobenius k K Ω n) ^ (w.restrict K).deg) := by
  let D : Subgroup Gal((fullConstantDegreeStage k K Ω n)/K) :=
    IdeleGroup.decompositionGroup (K := K) w
  let C : Subgroup Gal((fullConstantDegreeStage k K Ω n)/K) :=
    Subgroup.zpowers
      ((fullConstantDegreeFrobenius k K Ω n) ^ (w.restrict K).deg)
  have hCD : C ≤ D := Subgroup.zpowers_le.mpr
    (pow_degree_mem_decompositionGroup_fullConstantDegreeStage k K Ω n w
      (fullConstantDegreeFrobenius k K Ω n))
  have hC : Nat.card C = n / Nat.gcd n (w.restrict K).deg := by
    change Nat.card (Subgroup.zpowers
      ((fullConstantDegreeFrobenius k K Ω n) ^ (w.restrict K).deg)) = _
    rw [Nat.card_zpowers, orderOf_pow, orderOf_fullConstantDegreeFrobenius]
  have hD : Nat.gcd n (w.restrict K).deg * Nat.card D = n := by
    rw [← decompositionGroup_index_fullConstantDegreeStage k K Ω n w]
    exact D.index_mul_card.trans
      ((IsGalois.card_aut_eq_finrank K (fullConstantDegreeStage k K Ω n)).trans
        (finrank_fullConstantDegreeStage k K Ω n))
  have hcard : Nat.card C = Nat.card D := by
    apply mul_left_cancel₀ (Nat.gcd_ne_zero_left (NeZero.ne n))
    calc
      Nat.gcd n (w.restrict K).deg * Nat.card C = n := by
        rw [hC]
        exact Nat.mul_div_cancel' (Nat.gcd_dvd_left n (w.restrict K).deg)
      _ = Nat.gcd n (w.restrict K).deg * Nat.card D := hD.symm
  exact (Subgroup.eq_of_le_of_card_ge hCD hcard.symm.le).symm

end FunctionField
