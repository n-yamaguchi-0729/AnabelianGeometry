module

public import Mathlib.Data.Finsupp.WellFounded
public import Mathlib.Order.Minimal
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.RayClass.Basic
public import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.RayClass.Basis

/-!
# The least conductor of an open idele-class subgroup

The ray subgroup of the componentwise minimum of two moduli is the subgroup
generated by their ray subgroups. This follows by splitting an actual integral
idele according to which local exponent is smaller. The well-founded order on
effective finitely supported divisors then gives a unique least admissible
modulus for every open subgroup of the idele class group.

This construction can be applied to norm subgroups once their openness is
proved; no norm-index or reciprocity statement is used here.
-/

@[expose] public section

noncomputable section

namespace FunctionField.RayClass

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- Local minimum exponents generate the join of the two actual congruence groups. -/
theorem congruenceSubgroup_inf (m n : Modulus k K) :
    congruenceSubgroup (m ⊓ n) = congruenceSubgroup m ⊔ congruenceSubgroup n := by
  classical
  apply le_antisymm
  · intro a ha
    have haInt := congruenceSubgroup_le_integralSubgroup (m ⊓ n) ha
    let b : IdeleGroup k K := ⟨fun v => if m v ≤ n v then a v else 1,
      Filter.Eventually.of_forall (fun v => by
        change (if m v ≤ n v then a v else 1) ∈ v.adicCompletionIntegers.units
        split
        · exact haInt v
        · exact (v.adicCompletionIntegers.units).one_mem)⟩
    let c : IdeleGroup k K := ⟨fun v => if m v ≤ n v then 1 else a v,
      Filter.Eventually.of_forall (fun v => by
        change (if m v ≤ n v then 1 else a v) ∈ v.adicCompletionIntegers.units
        split
        · exact (v.adicCompletionIntegers.units).one_mem
        · exact haInt v)⟩
    have hb : b ∈ congruenceSubgroup m := by
      intro v
      change (if m v ≤ n v then a v else 1) ∈ localHigherUnitGroup v (m v)
      split
      · rename_i hv
        have h := ha v
        simpa only [Finsupp.inf_apply, inf_eq_left.mpr hv] using h
      · exact (localHigherUnitGroup v (m v)).one_mem
    have hc : c ∈ congruenceSubgroup n := by
      intro v
      change (if m v ≤ n v then 1 else a v) ∈ localHigherUnitGroup v (n v)
      split
      · exact (localHigherUnitGroup v (n v)).one_mem
      · rename_i hv
        have h := ha v
        simpa only [Finsupp.inf_apply, inf_eq_right.mpr (le_of_not_ge hv)] using h
    have hmul : b * c = a := by
      apply RestrictedProduct.ext
      intro v
      change (if m v ≤ n v then a v else 1) * (if m v ≤ n v then 1 else a v) = a v
      split
      · exact mul_one _
      · exact one_mul _
    rw [← hmul]
    exact (congruenceSubgroup m ⊔ congruenceSubgroup n).mul_mem
      ((show congruenceSubgroup m ≤ congruenceSubgroup m ⊔ congruenceSubgroup n from
        le_sup_left) hb)
      ((show congruenceSubgroup n ≤ congruenceSubgroup m ⊔ congruenceSubgroup n from
        le_sup_right) hc)
  · exact sup_le (congruenceSubgroup_antitone inf_le_left)
      (congruenceSubgroup_antitone inf_le_right)

variable [AlgebraicCurve.HasPrincipalDivisors k K]

/-- Taking the minimum of moduli generates the join of their ray subgroups. -/
theorem rayClassSubgroup_inf (m n : Modulus k K) :
    rayClassSubgroup (m ⊓ n) = rayClassSubgroup m ⊔ rayClassSubgroup n := by
  change (congruenceSubgroup (m ⊓ n)).map (IdeleClassGroup.mk (k := k) (K := K)) = _
  rw [congruenceSubgroup_inf, Subgroup.map_sup]
  rfl

variable [Finite k] [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FunctionField k K]

/-- Every open idele-class subgroup admits a least effective conductor modulus. -/
theorem exists_least_conductor (H : Subgroup (IdeleClassGroup k K))
    (hH : IsOpen (H : Set (IdeleClassGroup k K))) :
    ∃ m : Modulus k K, rayClassSubgroup m ≤ H ∧
      ∀ n : Modulus k K, rayClassSubgroup n ≤ H → m ≤ n := by
  obtain ⟨m, hm⟩ := exists_minimal_of_wellFoundedLT
    (fun m : Modulus k K => rayClassSubgroup m ≤ H) (exists_rayClassSubgroup_le H hH)
  refine ⟨m, hm.1, fun n hn => ?_⟩
  have hmn : rayClassSubgroup (m ⊓ n) ≤ H := by
    rw [rayClassSubgroup_inf]
    exact sup_le hm.1 hn
  exact (hm.2 hmn inf_le_left).trans inf_le_right

/-- The conductor of an actual open subgroup of the idele class group. -/
def conductor (H : Subgroup (IdeleClassGroup k K))
    (hH : IsOpen (H : Set (IdeleClassGroup k K))) : Modulus k K :=
  (exists_least_conductor H hH).choose

theorem rayClassSubgroup_conductor_le (H : Subgroup (IdeleClassGroup k K))
    (hH : IsOpen (H : Set (IdeleClassGroup k K))) : rayClassSubgroup (conductor H hH) ≤ H :=
  (exists_least_conductor H hH).choose_spec.1

/-- A modulus is admissible exactly when it is divisible by the conductor. -/
theorem conductor_le_iff (H : Subgroup (IdeleClassGroup k K))
    (hH : IsOpen (H : Set (IdeleClassGroup k K))) (m : Modulus k K) :
    conductor H hH ≤ m ↔ rayClassSubgroup m ≤ H := by
  constructor
  · intro hm
    exact (rayClassSubgroup_antitone hm).trans (rayClassSubgroup_conductor_le H hH)
  · exact (exists_least_conductor H hH).choose_spec.2 m

/-- Enlarging an open subgroup weakens the conductor modulus. -/
theorem conductor_antitone {H J : Subgroup (IdeleClassGroup k K)}
    (hH : IsOpen (H : Set (IdeleClassGroup k K)))
    (hJ : IsOpen (J : Set (IdeleClassGroup k K))) (hHJ : H ≤ J) :
    conductor J hJ ≤ conductor H hH :=
  (conductor_le_iff J hJ _).mpr ((rayClassSubgroup_conductor_le H hH).trans hHJ)

/-- The conductor of the intersection is the componentwise maximum of the
conductors. This applies in particular to intersections of actual norm groups. -/
theorem conductor_inf (H J : Subgroup (IdeleClassGroup k K))
    (hH : IsOpen (H : Set (IdeleClassGroup k K)))
    (hJ : IsOpen (J : Set (IdeleClassGroup k K))) :
    conductor (H ⊓ J) (hH.inter hJ) = conductor H hH ⊔ conductor J hJ := by
  apply le_antisymm
  · apply (conductor_le_iff (H ⊓ J) (hH.inter hJ) _).mpr
    exact le_inf
      ((rayClassSubgroup_antitone le_sup_left).trans (rayClassSubgroup_conductor_le H hH))
      ((rayClassSubgroup_antitone le_sup_right).trans (rayClassSubgroup_conductor_le J hJ))
  · exact sup_le
      (conductor_antitone (hH.inter hJ) hH inf_le_left)
      (conductor_antitone (hH.inter hJ) hJ inf_le_right)

end FunctionField.RayClass
