/-!
# The actual local ramification generators of the global ray subgroup

The Artin image of the full ray congruence subgroup is exactly the closed
subgroup generated by the original one-place higher-unit images. The
infinite integral tail is handled using open subgroups and profinite
closed-subgroup separation; it is not replaced by a finite product.

For a reduced modulus this separates the depth-zero groups off the
boundary from the depth-one groups on it. At every actual finite abelian
extension the corresponding conductor bound is equivalent to vanishing
of the actual completed upper ramification groups at these depths.
-/

@[expose] public section

noncomputable section

universe u v w

open AlgebraicCurve LocalClassFieldTheory
open scoped AlgebraicCurve.Place

namespace FunctionField.RayClass

section AbsoluteRamification

variable {k : Type u} {K : Type v} [Field k] [Finite k] [Field K] [Algebra k K]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [HasPrincipalDivisors k K]

/-- The original one-place higher-unit image inside the absolute abelian
Galois group, before passing to any ray quotient. -/
def placeArtinUnitImage (v : Place k K) (n : ℕ) :
    Subgroup (localAbsoluteAbelianProfinite K) :=
  (localHigherUnitGroup v n).map
    (((absoluteArtin k K).toMonoidHom.comp (IdeleClassGroup.mk (k := k) (K := K))).comp
      (IdeleGroup.placeIdele v))

/-- Every prescribed local higher-unit image lies in the original global
ray Artin subgroup. The witness is its actual one-place idele. -/
theorem placeArtinUnitImage_le_artinRaySubgroup (m : Modulus k K) (v : Place k K) :
    placeArtinUnitImage v (m v) ≤ artinRaySubgroup m := by
  rintro γ ⟨x, hx, rfl⟩
  refine ⟨IdeleClassGroup.mk (IdeleGroup.placeIdele v x), ?_, rfl⟩
  refine ⟨IdeleGroup.placeIdele v x, ?_, rfl⟩
  intro w
  change IdeleGroup.component w (IdeleGroup.placeIdele v x) ∈ localHigherUnitGroup w (m w)
  by_cases hw : w = v
  · subst w
    rw [IdeleGroup.component_placeIdele_same]
    exact hx
  · rw [IdeleGroup.component_placeIdele_of_ne v w x hw]
    exact (localHigherUnitGroup w (m w)).one_mem

/-- Containment in any closed subgroup is detected by the actual local
higher-unit images. Open-subgroup separation accounts for all infinite tails. -/
theorem artinRaySubgroup_le_closed_iff (m : Modulus k K)
    (H : Subgroup (localAbsoluteAbelianProfinite K))
    (hH : IsClosed (H : Set (localAbsoluteAbelianProfinite K))) :
    artinRaySubgroup m ≤ H ↔ ∀ v : Place k K, placeArtinUnitImage v (m v) ≤ H := by
  constructor
  · intro h v
    exact (placeArtinUnitImage_le_artinRaySubgroup m v).trans h
  · intro hlocal γ hγ
    let Hclosed : ClosedSubgroup (localAbsoluteAbelianProfinite K) := ⟨H, hH⟩
    change γ ∈ (Hclosed : Subgroup (localAbsoluteAbelianProfinite K))
    rw [ProCGroups.ProC.closedSubgroup_eq_sInf_open Hclosed]
    apply Subgroup.mem_sInf.mpr
    intro J hJ
    let pre : Subgroup (IdeleClassGroup k K) := J.comap (absoluteArtin k K).toMonoidHom
    have hpre : IsOpen (pre : Set (IdeleClassGroup k K)) :=
      hJ.1.preimage (absoluteArtin k K).continuous_toFun
    have hray : rayClassSubgroup m ≤ pre := by
      apply (rayClassSubgroup_le_iff m pre hpre).mpr
      intro v x hx
      exact hJ.2 (hlocal v ⟨x, hx, rfl⟩)
    obtain ⟨c, hc, rfl⟩ := hγ
    exact hray hc

/-- The global ray Artin subgroup is exactly the closed subgroup generated
by its original one-place ramification images. -/
theorem artinRaySubgroup_eq_topologicalClosure_iSup (m : Modulus k K) :
    artinRaySubgroup m =
      (⨆ v : Place k K, placeArtinUnitImage v (m v)).topologicalClosure := by
  apply le_antisymm
  · apply (artinRaySubgroup_le_closed_iff m _
      (Subgroup.isClosed_topologicalClosure _)).mpr
    intro v
    exact (le_iSup (fun w : Place k K => placeArtinUnitImage w (m w)) v).trans
      (Subgroup.le_topologicalClosure _)
  · apply Subgroup.topologicalClosure_minimal
    · apply iSup_le
      intro v
      exact placeArtinUnitImage_le_artinRaySubgroup m v
    · exact isClosed_artinRaySubgroup m

/-- For the reduced boundary modulus the exact global generators are
ordinary units in the interior and principal units on the boundary. -/
theorem artinRaySubgroup_reduced_generators (m : Modulus k K) (hm : ∀ v, m v ≤ 1) :
    artinRaySubgroup m =
      ((⨆ (v : Place k K) (_ : m v = 0), placeArtinUnitImage v 0) ⊔
        (⨆ (v : Place k K) (_ : m v = 1), placeArtinUnitImage v 1)).topologicalClosure := by
  rw [artinRaySubgroup_eq_topologicalClosure_iSup]
  congr 1
  apply le_antisymm
  · apply iSup_le
    intro v
    by_cases hv : m v = 0
    · rw [hv]
      exact ((le_iSup (fun _ : m v = 0 => placeArtinUnitImage v 0) hv).trans
        (le_iSup (fun w : Place k K =>
          ⨆ (_ : m w = 0), placeArtinUnitImage w 0) v)).trans le_sup_left
    · have hvone : m v = 1 := by
        have hbound := hm v
        omega
      rw [hvone]
      exact ((le_iSup (fun _ : m v = 1 => placeArtinUnitImage v 1) hvone).trans
        (le_iSup (fun w : Place k K =>
          ⨆ (_ : m w = 1), placeArtinUnitImage w 1) v)).trans le_sup_right
  · apply sup_le
    · apply iSup_le
      intro v
      apply iSup_le
      intro hv
      rw [← hv]
      exact le_iSup (fun w : Place k K => placeArtinUnitImage w (m w)) v
    · apply iSup_le
      intro v
      apply iSup_le
      intro hv
      rw [← hv]
      exact le_iSup (fun w : Place k K => placeArtinUnitImage w (m w)) v

end AbsoluteRamification

section FiniteRamification

variable {k : Type u} {K : Type v} [Field k] [Finite k] [Field K] [Algebra k K]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [HasPrincipalDivisors k K]

variable {L : Type w} [Field L] [Algebra k L] [Algebra K L] [IsScalarTower k K L]
    [FiniteDimensional K L] [IsAbelianGalois K L] [HasPrincipalDivisors k L]

/-- The actual completed conductor bound is exactly vanishing of the
completed upper ramification group at the given integer depth. -/
theorem localConductorExponent_le_iff_upperRamification_eq_bot
    (w : Place k L) (n : ℕ) :
    let _ : ValuativeRel (w.restrict K).adicCompletion :=
      placeCompletionValuativeRel (w.restrict K)
    have _ : IsNonarchimedeanLocalField (w.restrict K).adicCompletion :=
      placeCompletion_isNonarchimedeanLocalField (w.restrict K)
    localConductorExponent (w.restrict K).adicCompletion w.adicCompletion ≤ n ↔
      RamificationTheory.LocalField.localUpperRamificationGroup
        (w.restrict K).adicCompletion w.adicCompletion (n : ℝ) = ⊥ := by
  intro hrelation hlocal
  have hconductor := localConductorExponent_le_iff_localArtin (K := K) w n
  have hfiltered := localDecompositionArtin_higherUnits_completion (K := K) w n
  dsimp only at hconductor hfiltered
  let e := IdeleGroup.decompositionCompletionEquiv (K := K) w
  constructor
  · intro h
    apply le_antisymm
    · intro σ hσ
      rw [← hfiltered] at hσ
      obtain ⟨τ, ⟨x, hx, rfl⟩, rfl⟩ := hσ
      have hxone : localDecompositionArtin (K := K) w x = 1 :=
        Subtype.ext (hconductor.mp h x hx)
      apply Subgroup.mem_bot.mpr
      exact (congrArg e hxone).trans (map_one e)
    · exact bot_le
  · intro h
    apply hconductor.mpr
    intro x hx
    have hximage : e (localDecompositionArtin (K := K) w x) ∈
        RamificationTheory.LocalField.localUpperRamificationGroup
          (w.restrict K).adicCompletion w.adicCompletion (n : ℝ) := by
      rw [← hfiltered]
      exact ⟨localDecompositionArtin (K := K) w x, ⟨x, hx, rfl⟩, rfl⟩
    rw [h] at hximage
    have hxone : localDecompositionArtin (K := K) w x = 1 :=
      e.injective ((Subgroup.mem_bot.mp hximage).trans (map_one e).symm)
    exact congrArg Subtype.val hxone

variable [Algebra (RatFunc k) L] [IsScalarTower k (RatFunc k) L] [FunctionField k L]

/-- A global ray bound kills exactly the actual completed upper
ramification groups at all prescribed original-place depths. -/
theorem extensionConductor_le_iff_upperRamification_eq_bot (m : Modulus k K) :
    extensionConductor (k := k) (K := K) (L := L) ≤ m ↔
      ∀ w : Place k L,
        let _ : ValuativeRel (w.restrict K).adicCompletion :=
          placeCompletionValuativeRel (w.restrict K)
        have _ : IsNonarchimedeanLocalField (w.restrict K).adicCompletion :=
          placeCompletion_isNonarchimedeanLocalField (w.restrict K)
        RamificationTheory.LocalField.localUpperRamificationGroup
          (w.restrict K).adicCompletion w.adicCompletion (m (w.restrict K) : ℝ) = ⊥ := by
  rw [extensionConductor_le_iff_localConductor]
  constructor
  · intro h w hrelation hlocal
    have hw := h w
    have hcriterion := localConductorExponent_le_iff_upperRamification_eq_bot
      (K := K) w (m (w.restrict K))
    dsimp only at hw hcriterion
    exact hcriterion.mp hw
  · intro h w hrelation hlocal
    have hw := h w
    have hcriterion := localConductorExponent_le_iff_upperRamification_eq_bot
      (K := K) w (m (w.restrict K))
    dsimp only at hw hcriterion
    exact hcriterion.mpr hw

end FiniteRamification

end FunctionField.RayClass
