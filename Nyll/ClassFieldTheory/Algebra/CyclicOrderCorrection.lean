module

public import Mathlib.Data.Nat.Factorial.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Lean.Elab.Tactic.Omega

/-!
# Correcting a cyclic element while retaining a prescribed order divisor

A coset modulo the subgroup generated by the `s`th power of a cyclic
generator contains an element whose order is divisible by `m` when the
generator has order `m * s!`. Choose the representative exponent in `1..s`;
that exponent divides `s!`. This supplies the finite arithmetic correction
used with constant Frobenius and a decomposition-group lift.
-/

@[expose] public section

namespace ClassFieldTheory

/-- A cyclic coset modulo the `s`th powers has a representative whose order
retains the factor `m` in a group of order `m * s!`. -/
theorem exists_zpowers_mul_orderOf_dvd {G : Type*} [Group G]
    (g : G) (m s : ℕ) (hs : 0 < s) (hg : orderOf g = m * s.factorial)
    (x : G) (hx : x ∈ Subgroup.zpowers g) :
    ∃ η : G, η ∈ Subgroup.zpowers (g ^ s) ∧ m ∣ orderOf (η * x) := by
  obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  let t : ℕ := ((a - 1) % (s : ℤ) + 1).toNat
  let q : ℤ := -((a - 1) / (s : ℤ))
  have hsZ : (0 : ℤ) < s := Int.natCast_pos.mpr hs
  have hr0 : 0 ≤ (a - 1) % (s : ℤ) :=
    Int.emod_nonneg (a - 1) (ne_of_gt hsZ)
  have hrs : (a - 1) % (s : ℤ) < s := Int.emod_lt_of_pos (a - 1) hsZ
  have ht : (t : ℤ) = (a - 1) % (s : ℤ) + 1 :=
    Int.toNat_of_nonneg (by omega)
  have htpos : 0 < t := by omega
  have htle : t ≤ s := by omega
  have hfactor : t ∣ s.factorial := Nat.dvd_factorial htpos htle
  have horder : t ∣ orderOf g := by
    rw [hg]
    exact dvd_mul_of_dvd_right hfactor m
  have hbalance : (s : ℤ) * q + a = t := by
    have hdivision := Int.emod_add_mul_ediv (a - 1) (s : ℤ)
    change (s : ℤ) * (-((a - 1) / (s : ℤ))) + a = t
    rw [mul_neg, ht]
    omega
  refine ⟨(g ^ s) ^ q, Subgroup.mem_zpowers_iff.mpr ⟨q, rfl⟩, ?_⟩
  have hcorrect : (g ^ s) ^ q * g ^ a = g ^ t := by
    calc
      (g ^ s) ^ q * g ^ a = g ^ ((s : ℤ) * q + a) := by
        rw [zpow_add, zpow_mul, zpow_natCast]
      _ = g ^ t := by rw [hbalance, zpow_natCast]
  rw [hcorrect, orderOf_pow_of_dvd (Nat.ne_of_gt htpos) horder,
    hg, Nat.mul_div_assoc m hfactor]
  exact dvd_mul_right m (s.factorial / t)

/-- Two jointly faithful actions detect a cyclic subgroup through the second
action alone when its generator's second order is divisible by the first. -/
theorem injOn_zpowers_of_jointly_injective_orderOf_dvd
    {G H J : Type*} [Group G] [Group H] [Group J]
    (f : G →* H) (p : G →* J) (hjoint : Function.Injective (f.prod p))
    (x : G) (horder : orderOf (f x) ∣ orderOf (p x)) :
    Set.InjOn p (Subgroup.zpowers x) := by
  have hp : orderOf (p x) = orderOf x := by
    have h := orderOf_injective (f.prod p) hjoint x
    change orderOf (f x, p x) = orderOf x at h
    rw [Prod.orderOf_mk, Nat.lcm_eq_right horder] at h
    exact h
  intro a ha b hb hab
  obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
  obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb
  rw [map_zpow, map_zpow, zpow_eq_zpow_iff_modEq, hp] at hab
  exact zpow_eq_zpow_iff_modEq.mpr hab

end ClassFieldTheory
