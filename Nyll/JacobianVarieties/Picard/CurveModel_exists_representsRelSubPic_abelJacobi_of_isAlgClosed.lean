variable {K : Type u} [Field K] {F : Type v} [Field F] [Algebra K F]

/-- The function field of the curve model is essentially of finite type. -/
theorem essFiniteType_of_curveModel (M : CurveModel K F) : Algebra.EssFiniteType K F := by
  let : Algebra K M.C.functionField := M.functionFieldAlgebra
  have : Algebra.EssFiniteType K M.C.functionField := AlgebraicCurve.essFiniteType_functionField
    M.toBase
  exact (Algebra.EssFiniteType.iff_of_algEquiv M.ffAlgEquiv).mpr ‹_›

/-- The difference of two closed-field places has degree zero. -/
theorem single_sub_single_mem_degZero [IsAlgClosed K] [IsCurveOver K F] (v w : Place K F) :
    Finsupp.single v (1 : ℤ) - Finsupp.single w 1 ∈ Divisor.degZero (K := K) (F := F) := by
  rw [Divisor.mem_degZero, map_sub, Divisor.degree_single, Divisor.degree_single,
    IsCurveOver.deg_eq_one_of_isAlgClosed, IsCurveOver.deg_eq_one_of_isAlgClosed]
  simp only [Nat.cast_one, one_mul, sub_self]

end P2mJacK

