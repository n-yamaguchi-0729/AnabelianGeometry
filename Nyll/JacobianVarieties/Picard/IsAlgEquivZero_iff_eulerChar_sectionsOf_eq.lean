    inferInstance
  have : SmoothOfRelativeDimension 1 (pullback.snd a (𝟙 (Spec (CommRingCat.of k)))) :=
    SmoothOfRelativeDimension.pullback_snd 1 a (𝟙 (Spec (CommRingCat.of k)))
  have : IsIntegral (pullback a (𝟙 (Spec (CommRingCat.of k)))) :=
    GeometricallyIntegral.geometrically_isIntegral (f := a) (𝟙 (Spec (CommRingCat.of k)))
