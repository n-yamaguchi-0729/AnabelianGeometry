  have : IsIso (pullback.fst a (𝟙 (Spec (CommRingCat.of k)))) := inferInstance
  let φ : pullback a (𝟙 (Spec (CommRingCat.of k))) ≅ A :=
    asIso (pullback.fst a (𝟙 (Spec (CommRingCat.of k))))
  have hφ : φ.hom ≫ a = pullback.snd a (𝟙 (Spec (CommRingCat.of k))) := by
    change pullback.fst a (𝟙 (Spec (CommRingCat.of k))) ≫ a =
      pullback.snd a (𝟙 (Spec (CommRingCat.of k)))
    exact pullback.condition.trans (Category.comp_id _)
