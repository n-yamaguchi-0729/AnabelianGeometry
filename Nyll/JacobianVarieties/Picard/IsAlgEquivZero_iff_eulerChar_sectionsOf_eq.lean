    change D.I.invModule ⊗ E.I.module = _
    rw [hDI, hE]
  refine ⟨List.ofFn fun i => (⟨P i, hP i⟩ : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) a), ⟨?_⟩⟩
  exact (ρ_ L').symm ≪≫ whiskerLeftIso L' eE.symm ≪≫ (α_ L' E.I.invModule E.I.module).symm ≪≫
