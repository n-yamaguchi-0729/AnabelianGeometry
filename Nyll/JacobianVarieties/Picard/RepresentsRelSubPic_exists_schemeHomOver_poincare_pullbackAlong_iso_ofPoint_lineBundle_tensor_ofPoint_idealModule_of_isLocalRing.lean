/-- A difference of two point divisors over a local ring defines a point of the Picard scheme. -/
theorem exists_poincare_pullback_iso_points_difference_of_isLocalRing
    {R : Type u} [CommRing R] {C : Scheme.{u}} (c : C ⟶ Spec (CommRingCat.of R))
    [IsProper c] [SmoothOfRelativeDimension 1 c] [GeometricallyIntegral c]
    (ε : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) c)
    {D : RelativePic0Designation R c} (h : RepresentsRelSubPic c ε (algEquivZeroCut c ε) D)
    {A : Type u} [CommRing A] [IsLocalRing A] (tA : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of
      R))
    (v₁ v₂ : SchemeHomOver tA c) :
    ∃ s₀ : SchemeHomOver tA D.toBase, Nonempty ((h.poincare.pullbackAlong s₀).L ≅
      (RelEffCartierDiv.ofPoint c v₁.1 v₁.2).lineBundle ⊗ (RelEffCartierDiv.ofPoint c v₂.1
        v₂.2).idealModule) :=
  Ws50OfptClassify.exists_schemeHomOver_poincare_pullbackAlong_iso_ofPoint_tensor_ofPoint c ε h tA
    v₁ v₂
end AlgebraicGeometry.RelPicard.RepresentsRelSubPic
