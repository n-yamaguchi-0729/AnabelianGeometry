    change φ.hom.base y ∈ (W₁ : Set ↥(pullback c s))
    have hq' : φ.hom.base y = ((sectionFibrePoint ε s).1).base (IsLocalRing.closedPoint k) := by
      rw [Subsingleton.elim q (IsLocalRing.closedPoint k)] at hq; exact hq.symm
