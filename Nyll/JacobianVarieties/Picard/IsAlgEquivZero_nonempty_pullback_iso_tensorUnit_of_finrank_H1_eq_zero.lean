/-- The compatible family of restrictions of a global section. -/
noncomputable def sectionFamily {Y : Scheme.{u}} (M : Y.Modules) (s : Γ(M, ⊤)) : M.sections :=
  PresheafOfModules.sectionsMk (M := M.val)
    (fun U => M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op s)
    (fun U V f => by
      change M.presheaf.map f (M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op s) =
        M.presheaf.map (homOfLE (le_top : V.unop ≤ ⊤)).op s
      rw [← CategoryTheory.ConcreteCategory.comp_apply, ← Functor.map_comp]
      congr 1)

theorem sectionFamily_val_top {Y : Scheme.{u}} (M : Y.Modules) (s : Γ(M, ⊤)) :
    (sectionFamily M s).val (op ⊤) = s := by
  change M.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op s = s
  have : (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op = 𝟙 (op ⊤) := Subsingleton.elim _ _
  rw [this, CategoryTheory.Functor.map_id]
  rfl

theorem exists_hom_unit_ne_zero {Y : Scheme.{u}} (M : Y.Modules) (s : Γ(M, ⊤)) (hs : s ≠ 0) :
    ∃ φ : (SheafOfModules.unit Y.ringCatSheaf : Y.Modules) ⟶ M,
      φ ≠ (0 : 𝟙_ Y.Modules ⟶ M) := by
  refine ⟨M.unitHomEquiv.symm (sectionFamily M s), fun hφ => hs ?_⟩
  have h1 : sectionFamily M s = M.unitHomEquiv (0 : 𝟙_ Y.Modules ⟶ M) := by
    rw [← hφ, Equiv.apply_symm_apply]
  have h2 := congrArg (fun t : M.sections => t.val (op ⊤)) h1
  simp only [sectionFamily_val_top] at h2
  rw [h2]
  rfl

end AlgebraicGeometry.RelPicard.BPrime

open AlgebraicGeometry.RelPicard.BPrime in
with_weak_namespace _root_.AlgebraicGeometry.RelPicard.IsAlgEquivZero
theorem nonempty_pullback_iso_tensorUnit_of_finrank_H1_eq_zero
    (k : Type u) [Field k] [IsAlgClosed k] {X : Scheme.{u}} (x : X ⟶ Spec (CommRingCat.of k))
    (L : X.Modules) (hL : Scheme.Modules.IsInvertible L) (h0 : IsAlgEquivZero x L)
    {Y : Scheme.{u}} (y : Y ⟶ Spec (CommRingCat.of k))
    [IsIntegral Y] [IsProper y] [SmoothOfRelativeDimension 1 y]
    (𝒲 : Y.TwoAffineOpenCover)
    (h10 : Module.finrank k
      (𝒲.sectionsOf y (SheafOfModules.unit Y.ringCatSheaf : Y.Modules)).H1 = 0)
    (i : Y ⟶ X) (hi : i ≫ x = y) :
    Nonempty ((Scheme.Modules.pullback i).obj L ≅ 𝟙_ Y.Modules) := by
  set M : Y.Modules := (Scheme.Modules.pullback i).obj L with hM
  have hM' : Scheme.Modules.IsInvertible M := hL.pullback i
  have h0' : IsAlgEquivZero y M := IsAlgEquivZero.pullback i hi h0
  have hχ := (isAlgEquivZero_iff_eulerChar_sectionsOf_eq k y M hM' 𝒲).mp h0'
  have hnt : Nontrivial (𝒲.sectionsOf y M).H0 :=
    Scheme.Modules.IsInvertible.nontrivial_H0_sectionsOf_of_le_eulerChar_sub k y M hM' 𝒲 (by
      rw [hχ, sub_self, h10]
      exact le_refl _)
  let := Scheme.TwoAffineOpenCover.moduleSectionsOfHom y M ⊤
  obtain ⟨e, -⟩ := Scheme.TwoAffineOpenCover.exists_linearEquiv_sectionsOf_H0 𝒲 y M
  have : Nontrivial Γ(M, ⊤) := e.toEquiv.nontrivial
  obtain ⟨s, hs⟩ := exists_ne (0 : Γ(M, ⊤))
  obtain ⟨φ, hφ⟩ := exists_hom_unit_ne_zero M s hs
  have : GeometricallyIrreducible y := GeometricallyIrreducible.of_irreducibleSpace_of_isAlgClosed y
  exact IsAlgEquivZero.nonempty_iso_tensorUnit_of_ne_zero y 𝒲 hM' h0' φ hφ
end JacobianVarieties.Picard.Proofs.H1ZeroUnit
