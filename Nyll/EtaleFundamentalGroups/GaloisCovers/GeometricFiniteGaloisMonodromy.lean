/-!
# Literal finite Galois restriction on the original geometric kernel

A generic point of a finite étale cover is fixed by the original generic
kernel. Cancellation of that actual generic preimmersion proves that the
kernel fixes its embedded function field. This also applies when the cover
is first constructed over a finite extension of the constants.

The actual arithmetic label shows that a source automorphism representing
an element of the geometric kernel fixes all algebraic constants. When a
finite constant function field is generated by those constants and the
original function field, literal restriction to a finite Galois cover
therefore descends continuously to the original geometric kernel.
-/

@[expose] public section

universe uGeom uField₁ uField₂

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open scoped CategoryTheory.PreGaloisCategory FintypeCatDiscrete

namespace EtaleFundamentalGroups

/-- The actual generic-point kernel fixes the embedded field of a finite
étale cover. The original generic-source square and the actual generic
preimmersion suffice; no identification of a deck group is assumed. -/
theorem fieldSourceKernel_le_fixingSubgroup_of_finiteEtale_point
    (K Ω H : Type uGeom) [Field K] [Field Ω] [Field H]
    [Algebra K Ω] [IsSepClosure K Ω] [IsSepClosed Ω] [Algebra K H]
    {X : Scheme.{uGeom}} [IsIntegral X] (j : Spec (.of K) ⟶ X)
    (W : FiniteEtale X) (η : Spec (.of H) ⟶ W.left) [IsPreimmersion η]
    (hη : η ≫ W.hom = Spec.map (CommRingCat.ofHom (algebraMap K H)) ≫ j)
    (i : H →ₐ[K] Ω) :
    (fieldSourceAbsoluteGaloisHom K Ω j).toMonoidHom.ker ≤
      i.fieldRange.fixingSubgroup := by
  let q := fieldSourceAbsoluteGaloisHom K Ω j
  let p := Spec.map (CommRingCat.ofHom i.toRingHom) ≫ η
  have hp : p ≫ W.hom = ξ K Ω ≫ j := by
    rw [Category.assoc, hη, ← Category.assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hi : i.toRingHom.comp (algebraMap K H) = algebraMap K Ω := i.comp_algebraMap
    exact congrArg (fun f : K →+* Ω => Spec.map (CommRingCat.ofHom f) ≫ j) hi
  let x := (fiberObjEquivHom (ξ K Ω ≫ j) W).symm (Over.homMk p hp)
  have hx : (fiberObjEquivHom (ξ K Ω ≫ j) W x).left = p :=
    congrArg (fun z : Over.mk (ξ K Ω ≫ j) ⟶ W.toComma => z.left)
      ((fiberObjEquivHom (ξ K Ω ≫ j) W).apply_symm_apply (Over.homMk p hp))
  intro σ hσ
  have hq : q σ = 1 := hσ
  have haction := fundamentalGroupHom_point_of_point_action j (ξ K Ω)
    (suppliedGaloisEquivFundamentalGroup K Ω σ) σ.toRingHom
    (suppliedGaloisEquivFundamentalGroup_point K Ω σ) W x
  change (fiberObjEquivHom (ξ K Ω ≫ j) W ((q σ).asIso.hom.app W x)).left = _ at haction
  rw [hq] at haction
  change (fiberObjEquivHom (ξ K Ω ≫ j) W x).left =
    Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
      (fiberObjEquivHom (ξ K Ω ≫ j) W x).left at haction
  rw [hx] at haction
  have hpoint : Spec.map (CommRingCat.ofHom (σ.toRingHom.comp i.toRingHom)) =
      Spec.map (CommRingCat.ofHom i.toRingHom) := by
    apply (cancel_mono η).mp
    rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
    exact haction.symm
  have hcoeff : σ.toRingHom.comp i.toRingHom = i.toRingHom :=
    congrArg CommRingCat.Hom.hom (Spec.map_injective hpoint)
  apply (IntermediateField.mem_fixingSubgroup_iff i.fieldRange σ).mpr
  rintro z ⟨a, rfl⟩
  exact RingHom.congr_fun hcoeff a

/-- A source automorphism in the kernel of the original arithmetic map
fixes the specified algebraic constant closure pointwise. The actual
inner correction in the arithmetic label cancels at the identity. -/
theorem fieldSource_arithmeticKernel_fixes_constants
    (k K κ Ω : Type uGeom) [Field k] [Field K] [Field κ] [Field Ω]
    [Algebra k K] [Algebra k κ] [Algebra k Ω]
    [Algebra K Ω] [Algebra κ Ω]
    [IsScalarTower k K Ω] [IsScalarTower k κ Ω]
    [IsSepClosure k κ] [IsSepClosure K Ω] [IsSepClosed Ω]
    {X : Scheme.{uGeom}} [IsIntegral X]
    (c : X ⟶ Spec (.of k)) (j : Spec (.of K) ⟶ X)
    (hbase : (ξ K Ω ≫ j) ≫ c = ξ k Ω)
    (σ : Gal(Ω/K))
    (hσ : arithmeticFundamentalGroupHom k κ c (ξ K Ω ≫ j)
      (fieldSourceAbsoluteGaloisHom K Ω j σ) = 1) :
    ∀ a : κ, σ (algebraMap κ Ω a) = algebraMap κ Ω a := by
  obtain ⟨α, hα⟩ := exists_fieldSource_arithmetic_restriction_label k K κ Ω c j hbase
  have hr : (σ.restrictScalars k).restrictNormal κ = 1 := by
    apply (MulAut.conj α).injective
    change α * (σ.restrictScalars k).restrictNormal κ * α⁻¹ = α * 1 * α⁻¹
    rw [← hα, hσ, mul_one, mul_inv_cancel]
  intro a
  have h := ((σ.restrictScalars k).restrictNormal_commutes κ a).symm
  rw [hr] at h
  exact h

/-- Literal restriction to a finite Galois cover over finite constants
descends to the original arithmetic geometric kernel. The coefficient
formula identifies the result for every original source representative. -/
theorem exists_geometricFiniteGaloisMonodromy
    (k K κ Ω E L H : Type uGeom) [Field k] [Field K] [Field κ] [Field Ω]
    [Field E] [Field L] [Field H]
    [Algebra k K] [Algebra k κ] [Algebra k Ω]
    [Algebra K Ω] [Algebra κ Ω]
    [IsScalarTower k K Ω] [IsScalarTower k κ Ω]
    [IsSepClosure k κ] [IsSepClosure K Ω] [IsSepClosed Ω]
    [Algebra E κ] [Algebra E Ω] [IsScalarTower E κ Ω]
    [Algebra K L] [Algebra E L] [Algebra L Ω]
    [IsScalarTower K L Ω] [IsScalarTower E L Ω]
    [Algebra L H] [Algebra K H] [IsScalarTower K L H]
    [FiniteDimensional K H] [FiniteDimensional L H] [IsGalois L H]
    {X : Scheme.{uGeom}} [IsIntegral X] [IsNormalIntegral X]
    (c : X ⟶ Spec (.of k))
    (j : Spec (.of K) ⟶ X) [IsDominant j] [IsPreimmersion j]
    (hbase : (ξ K Ω ≫ j) ≫ c = ξ k Ω)
    (hgen : Algebra.adjoin K (Set.range (algebraMap E L)) = ⊤)
    (W : FiniteEtale X) (η : Spec (.of H) ⟶ W.left) [IsPreimmersion η]
    (hη : η ≫ W.hom = Spec.map (CommRingCat.ofHom (algebraMap K H)) ≫ j)
    (i : H →ₐ[L] Ω) :
    let π := arithmeticFundamentalGroupHom k κ c (ξ K Ω ≫ j)
    let q := fieldSourceAbsoluteGaloisHom K Ω j
    ∃ χ : π.toMonoidHom.ker →ₜ* Gal(H/L),
      ∀ (σ : Gal(Ω/K)) (hσ : π (q σ) = 1) (a : H),
        i (χ ⟨q σ, hσ⟩ a) = σ (i a) := by
  intro π q
  let A := (π.comp q).toMonoidHom.ker
  have hfixL (σ : A) (a : L) : σ.val (algebraMap L Ω a) = algebraMap L Ω a := by
    have hκ := fieldSource_arithmeticKernel_fixes_constants k K κ Ω c j hbase
      σ.val σ.property
    let B : Subalgebra K L :=
      { carrier := {a | σ.val (algebraMap L Ω a) = algebraMap L Ω a}
        zero_mem' := by
          change σ.val (algebraMap L Ω 0) = algebraMap L Ω 0
          rw [map_zero, map_zero]
        one_mem' := by
          change σ.val (algebraMap L Ω 1) = algebraMap L Ω 1
          rw [map_one, map_one]
        add_mem' := by
          intro a b ha hb
          change σ.val (algebraMap L Ω (a + b)) = algebraMap L Ω (a + b)
          rw [map_add, map_add, ha, hb]
        mul_mem' := by
          intro a b ha hb
          change σ.val (algebraMap L Ω (a * b)) = algebraMap L Ω (a * b)
          rw [map_mul, map_mul, ha, hb]
        algebraMap_mem' := by
          intro a
          change σ.val (algebraMap L Ω (algebraMap K L a)) =
            algebraMap L Ω (algebraMap K L a)
          rw [← IsScalarTower.algebraMap_apply K L Ω, σ.val.commutes] }
    have hle : Algebra.adjoin K (Set.range (algebraMap E L)) ≤ B := by
      apply Algebra.adjoin_le
      rintro _ ⟨b, rfl⟩
      change σ.val (algebraMap L Ω (algebraMap E L b)) =
        algebraMap L Ω (algebraMap E L b)
      rw [← IsScalarTower.algebraMap_apply E L Ω,
        IsScalarTower.algebraMap_apply E κ Ω]
      exact hκ (algebraMap E κ b)
    exact hle (hgen.symm ▸ (show a ∈ (⊤ : Subalgebra K L) from trivial))
  let rΩ : A →* Gal(Ω/L) :=
    { toFun σ := { σ.val.toRingEquiv with commutes' := hfixL σ }
      map_one' := by ext a; rfl
      map_mul' σ τ := by ext a; rfl }
  let aHΩ : Algebra H Ω := i.toRingHom.toAlgebra
  have hLHΩ : IsScalarTower L H Ω :=
    IsScalarTower.of_algebraMap_eq (fun a => (i.commutes a).symm)
  let r : A →* Gal(H/L) := (AlgEquiv.restrictNormalHom H).comp rΩ
  have hrvalue (σ : A) (a : H) : i (r σ a) = σ.val (i a) :=
    AlgEquiv.restrictNormal_commutes (rΩ σ) H a
  let iK := i.restrictScalars K
  have hfinite : FiniteDimensional K iK.fieldRange :=
    FiniteDimensional.of_surjective iK.equivFieldRange.toLinearMap
      iK.equivFieldRange.surjective
  have hrker : (r.ker : Set A) =
      Subtype.val ⁻¹' (iK.fieldRange.fixingSubgroup : Set Gal(Ω/K)) := by
    ext σ
    change r σ = 1 ↔ σ.val ∈ iK.fieldRange.fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h z hz
      obtain ⟨a, rfl⟩ := hz
      exact (hrvalue σ a).symm.trans (congrArg (fun t : Gal(H/L) => i (t a)) h)
    · intro h
      ext a
      apply i.injective
      exact (hrvalue σ a).trans (h (i a) ⟨a, rfl⟩)
  have hrcontinuous : Continuous r := by
    apply ProCGroups.MonoidHom.continuous_of_isOpen_ker_to_discrete
    rw [hrker]
    exact iK.fieldRange.fixingSubgroup_isOpen.preimage continuous_subtype_val
  let f : A →ₜ* π.toMonoidHom.ker :=
    { toFun σ := ⟨q σ.val, σ.property⟩
      map_one' := Subtype.ext q.map_one
      map_mul' σ τ := Subtype.ext (q.map_mul σ.val τ.val)
      continuous_toFun := (q.continuous.comp continuous_subtype_val).subtype_mk _ }
  have hf : Function.Surjective f := by
    rintro ⟨g, hg⟩
    obtain ⟨σ, rfl⟩ := fieldSourceAbsoluteGaloisHom_surjective K Ω j g
    exact ⟨⟨σ, hg⟩, rfl⟩
  have hker : f.toMonoidHom.ker ≤ r.ker := by
    intro σ hσ
    have hq : q σ.val = 1 := congrArg Subtype.val hσ
    have hfixed := fieldSourceKernel_le_fixingSubgroup_of_finiteEtale_point
      K Ω H j W η hη iK hq
    change σ ∈ (r.ker : Set A)
    rw [hrker]
    exact hfixed
  let χ := f.toMonoidHom.liftOfSurjective hf ⟨r, hker⟩
  have hχ (σ : A) : χ (f σ) = r σ :=
    f.toMonoidHom.liftOfRightInverse_comp_apply
      (Function.surjInv hf) (Function.rightInverse_surjInv hf) ⟨r, hker⟩ σ
  have hcompact : CompactSpace A :=
    isCompact_iff_compactSpace.mp
      (ProCGroups.ContinuousMonoidHom.isClosed_ker (π.comp q)).isCompact
  have hχcontinuous : Continuous χ := by
    have hquotient : Topology.IsQuotientMap f :=
      Topology.IsQuotientMap.of_surjective_continuous hf f.continuous
    rw [hquotient.continuous_iff]
    have hcomp : χ ∘ f = r := funext hχ
    rw [hcomp]
    exact hrcontinuous
  refine ⟨⟨χ, hχcontinuous⟩, ?_⟩
  intro σ hσ a
  change i (χ (f ⟨σ, hσ⟩) a) = σ (i a)
  rw [hχ]
  exact hrvalue ⟨σ, hσ⟩ a

end EtaleFundamentalGroups
