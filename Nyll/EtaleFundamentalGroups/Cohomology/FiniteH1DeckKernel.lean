import Nyll.EtaleFundamentalGroups.Cohomology.FiniteH1PullbackIdentity

/-! # The kernel of the actual deck action on finite H¹

The subgroup laws are proved from the composition and identity laws of
the actual derived-sheaf pullback. In particular triviality propagates to
the cyclic subgroup generated by a deck transformation.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry

namespace EtaleFundamentalGroups.Cohomology

variable {S : Scheme} (A : FiniteEtale S) [ConnectedSpace A.left]
  {Ω : Type} [Field Ω] [IsSepClosed Ω]
  (geom : Spec (.of Ω) ⟶ A.left) (B : AddCommGrpCat.{0}) [Finite B]

/-- The genuine kernel of pullback on actual derived H¹. -/
def finiteH1DeckKernel : Subgroup (Aut A) where
  carrier := { σ | ∀ c, constantCohomologyPullback σ.hom.left B 1 c = c }
  one_mem' := by
    intro c
    exact constantFiniteH1Pullback_id geom B c
  mul_mem' := by
    intro σ τ hσ hτ c
    change constantCohomologyPullback (τ.hom.left ≫ σ.hom.left) B 1 c = c
    rw [constantFiniteH1Pullback_comp τ.hom.left σ.hom.left geom B c, hσ c, hτ c]
  inv_mem' := by
    intro σ hσ c
    have he : σ.hom.left ≫ σ.inv.left = 𝟙 A.left :=
      congrArg (fun f : A ⟶ A => f.left) σ.hom_inv_id
    have h := constantFiniteH1Pullback_comp σ.hom.left σ.inv.left geom B c
    rw [he, constantFiniteH1Pullback_id geom B c,
      hσ (constantCohomologyPullback σ.inv.left B 1 c)] at h
    exact h.symm

include geom

/-- All powers of a deck transformation acting trivially act trivially,
for the actual finite-coefficient derived H¹ pullback. -/
theorem constantFiniteH1Pullback_eq_self_of_mem_deck_zpowers
    (σ τ : Aut A) (hσ : ∀ c, constantCohomologyPullback σ.hom.left B 1 c = c)
    (hτ : τ ∈ Subgroup.zpowers σ) :
    ∀ c, constantCohomologyPullback τ.hom.left B 1 c = c := by
  have hle : Subgroup.zpowers σ ≤ finiteH1DeckKernel A geom B :=
    Subgroup.zpowers_le.mpr hσ
  exact hle hτ

end EtaleFundamentalGroups.Cohomology
