/-!
# The actual geometric étale stalk of a DVR is a DVR

Represent a nonzero germ on an affine étale neighborhood and localize its
sections at the prime selected by the geometric point. The resulting ring is
Noetherian, and unramifiedness identifies its maximal ideal with the ideal
generated by the base uniformizer. Krull intersection on that actual local
ring gives a unit times a power of the uniformizer. The localized germ map
transfers this factorization to the geometric stalk.

The domain property comes from the general normal-domain geometric-stalk
theorem. The unit--power factorizations identify its maximal ideal and give
the DVR structure. This argument does not presume Noetherianity of a filtered
colimit or the general theorem that every regular local ring is a domain.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory IsLocalRing

namespace EtaleFundamentalGroups.StrictHenselian

universe u

variable {R Ω : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field Ω] [IsSepClosed Ω] (φ : R →+* Ω) [IsLocalHom φ]

/-- Every nonzero germ is a unit times a power of the image of any chosen
base uniformizer. The factorization is constructed on a localized affine
étale neighborhood. -/
theorem geometricStalk_exists_unit_mul_uniformizer_pow
    (π : R) (hπ : Irreducible π)
    (a : geometricStalk (Spec.map (CommRingCat.ofHom φ))) (ha : a ≠ 0) :
    ∃ (n : ℕ) (u : (geometricStalk (Spec.map (CommRingCat.ofHom φ)))ˣ),
      (u : geometricStalk (Spec.map (CommRingCat.ofHom φ))) *
        geometricStalkStructureMap φ π ^ n = a := by
  let s : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of R) :=
    Spec.map (CommRingCat.ofHom φ)
  obtain ⟨W, t, z, hz⟩ := geometricStalk_exists_representative s a
  obtain ⟨V, v, j, hVaffine, hj⟩ := geometricStalk_exists_affine_refinement s W t
  let : IsAffine V.left := hVaffine
  let : IsAffine ((𝟭 Scheme).obj V.left) := hVaffine
  let : IsAffine
      ((Functor.fromPUnit (Spec (CommRingCat.of R))).obj V.right) := by
    change IsAffine (Spec (CommRingCat.of R))
    infer_instance
  let y : Γ(V.left, ⊤) := j.left.appTop z
  have hy : geometricStalkGerm s V v y = a := by
    have h := (Scheme.pointSmallEtale s).toPresheafFiber_w
      j v (etaleSections (Spec (CommRingCat.of R)))
    have hjStrict : (Scheme.pointSmallEtale s).fiber.map j v = t := hj
    rw [hjStrict] at h
    exact (ConcreteCategory.congr_hom h z).trans hz
  let β : R →+* Γ(V.left, ⊤) :=
    ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ V.hom.appTop).hom
  let : Algebra R Γ(V.left, ⊤) := β.toAlgebra
  have hβ : β.Etale := by
    change (V.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom).Etale
    apply RingHom.Etale.stableUnderComposition
    · exact RingHom.Etale.of_bijective
        ((ConcreteCategory.isIso_iff_bijective (Scheme.ΓSpecIso (CommRingCat.of R)).inv).mp
          inferInstance)
    · exact HasRingHomProperty.appTop (P := @Etale) V.hom inferInstance
  let : Algebra.Etale R Γ(V.left, ⊤) := hβ
  let B := Localization.AtPrime (geometricNeighborhoodPrime s V v).asIdeal
  let θ : B →+* geometricStalk s := geometricStalkLocalizedGerm s V v
  have hθ : θ.comp (algebraMap R B) = geometricStalkStructureMap φ := by
    rw [IsScalarTower.algebraMap_eq R Γ(V.left, ⊤) B, ← RingHom.comp_assoc]
    change ((geometricStalkLocalizedGerm s V v).comp
      (algebraMap Γ(V.left, ⊤) B)).comp β = _
    rw [geometricStalkLocalizedGerm_comp]
    exact geometricStalkGerm_comp_structure φ V v
  let : IsLocalHom (θ.comp (algebraMap R B)) := by
    rw [hθ]
    infer_instance
  let : IsLocalHom (algebraMap R B) := isLocalHom_of_comp (algebraMap R B) θ
  let : Module.Flat R B := Module.Flat.trans R Γ(V.left, ⊤) B
  let : IsNoetherianRing B := Algebra.EssFiniteType.isNoetherianRing R B
  have hyB : algebraMap Γ(V.left, ⊤) B y ≠ 0 := by
    intro hzero
    apply ha
    rw [← hy, ← geometricStalkLocalizedGerm_apply]
    change θ (algebraMap Γ(V.left, ⊤) B y) = 0
    rw [hzero, map_zero]
  obtain ⟨n, u, hu⟩ := exists_unit_mul_pow_of_principal_maximalIdeal (algebraMap R B π)
    (localUnramifiedOverDVR_maximalIdeal R B π hπ) (algebraMap Γ(V.left, ⊤) B y) hyB
  refine ⟨n, Units.map θ.toMonoidHom u, ?_⟩
  change θ (u : B) * geometricStalkStructureMap φ π ^ n = a
  have h := congrArg θ hu
  have hπMap : θ (algebraMap R B π) = geometricStalkStructureMap φ π :=
    DFunLike.congr_fun hθ π
  rw [map_mul, map_pow, hπMap] at h
  change θ (u : B) * geometricStalkStructureMap φ π ^ n =
    geometricStalkLocalizedGerm s V v (algebraMap Γ(V.left, ⊤) B y) at h
  rw [geometricStalkLocalizedGerm_apply, hy] at h
  exact h

/-- A base uniformizer generates the maximal ideal of the actual geometric
étale stalk. -/
theorem geometricStalk_maximalIdeal_eq_span_uniformizer (π : R) (hπ : Irreducible π) :
    maximalIdeal (geometricStalk (Spec.map (CommRingCat.ofHom φ))) =
      Ideal.span {geometricStalkStructureMap φ π} := by
  classical
  apply le_antisymm
  · intro a ha
    by_cases ha0 : a = 0
    · rw [ha0]
      exact Ideal.zero_mem _
    obtain ⟨n, u, hu⟩ := geometricStalk_exists_unit_mul_uniformizer_pow φ π hπ a ha0
    cases n with
    | zero =>
      have hau : IsUnit a := by
        rw [← hu, pow_zero, mul_one]
        exact u.isUnit
      exact False.elim (ha hau)
    | succ n =>
      apply Ideal.mem_span_singleton.mpr
      refine ⟨(u : geometricStalk (Spec.map (CommRingCat.ofHom φ))) *
        geometricStalkStructureMap φ π ^ n, ?_⟩
      rw [← hu, pow_succ]
      ring
  · apply Ideal.span_le.mpr
    intro a ha
    rw [Set.mem_singleton_iff] at ha
    subst a
    change ¬IsUnit (geometricStalkStructureMap φ π)
    intro hunit
    exact hπ.not_isUnit (IsLocalHom.map_nonunit (f := geometricStalkStructureMap φ) π hunit)

/-- The actual geometric étale stalk over a closed geometric point of a DVR
is itself a DVR. -/
instance geometricStalk_isDiscreteValuationRing :
    IsDiscreteValuationRing (geometricStalk (Spec.map (CommRingCat.ofHom φ))) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hne : geometricStalkStructureMap φ π ≠ 0 := by
    intro hzero
    apply hπ.ne_zero
    apply geometricStalkStructureMap_injective φ
    rw [hzero, map_zero]
  have hmax := geometricStalk_maximalIdeal_eq_span_uniformizer φ π hπ
  apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
  refine ⟨geometricStalkStructureMap φ π,
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hne hmax, ?_⟩
  intro a ha
  obtain ⟨n, u, hu⟩ := geometricStalk_exists_unit_mul_uniformizer_pow φ π hπ a ha
  refine ⟨n, u, ?_⟩
  rw [mul_comm]
  exact hu

end EtaleFundamentalGroups.StrictHenselian
