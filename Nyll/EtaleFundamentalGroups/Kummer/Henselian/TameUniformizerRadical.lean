import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.PurelyInseparable.Basic
import Nyll.ValuedFieldTheory.Valuation.DiscreteValuationField.FiniteExtension.Defectless
import Nyll.EtaleFundamentalGroups.Kummer.Henselian.UnitRoot
import Nyll.EtaleFundamentalGroups.Kummer.Henselian.UniformizerDecomposition
import Nyll.EtaleFundamentalGroups.Kummer.Obstructions.LocalDerivative

/-!
# A uniformizer radical for a totally tamely ramified Henselian DVF extension

Suppose that the base residue field is separably closed of characteristic zero
and that the target valuation ring is finite over the base valuation ring.
The residue extension is then finite and separable, hence trivial.  The local
Dedekind identity makes the ramification index equal to the field degree, and
characteristic zero makes this index invertible in both residue fields.
Hensel's lemma absorbs the unit in the uniformizer comparison.  The resulting
root of a base uniformizer has an Eisenstein minimal polynomial of full degree,
hence generates the target field.
-/

noncomputable section

namespace EtaleFundamentalGroups.Kummer

open Polynomial
open ValuationTheory.DiscreteValuationField
open ValuationTheory.DiscreteValuationField.ValuedExtension

universe u v w x

/-- A finite extension of Henselian valuation rings over a separably closed
characteristic-zero residue field is generated by a root of a base
uniformizer.  Finiteness and characteristic zero make the residue extension
finite separable, so separable closedness forces residue degree one.  The final
equivalence is the concrete `AdjoinRoot` standard form and sends its
distinguished root to the chosen generator. -/
theorem exists_uniformizer_radical_generator_of_moduleFinite_of_charZeroResidue
    {K : Type u} {L : Type w} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L]
    (base : HenselianDVF.{u, v} K) (target : HenselianDVF.{w, x} L)
    [base.valuation.HasExtension target.valuation]
    [Module.Finite base.valuationSubring target.valuationSubring]
    [IsScalarTower base.valuationSubring target.valuationSubring L]
    [IsSepClosed base.residueField]
    [CharZero base.residueField] :
    ∃ (ϖ : base.valuationSubring) (α : L)
        (e : AdjoinRoot
          (X ^ ramificationIndex base.toDVF target.toDVF - C (ϖ : K)) ≃ₐ[K] L),
      base.valuation.IsUniformizer (ϖ : K) ∧
        Prime ϖ ∧
          α ^ ramificationIndex base.toDVF target.toDVF =
            algebraMap K L (ϖ : K) ∧
            IntermediateField.adjoin K ({α} : Set L) = ⊤ ∧
              e (AdjoinRoot.root
                (X ^ ramificationIndex base.toDVF target.toDVF - C (ϖ : K))) = α := by
  let n := ramificationIndex base.toDVF target.toDVF
  have hDef : IsDefectless base.toDVF target.toDVF :=
    isDefectless_of_moduleFinite base.toDVF target.toDVF
  let : target.maximalIdeal.LiesOver base.maximalIdeal :=
    ⟨(maximalIdeal_comap_integerMap_eq base.toDVF target.toDVF).symm⟩
  let : FiniteDimensional base.residueField target.residueField := by
    refine FiniteDimensional.of_finrank_pos ?_
    change 0 < Module.finrank
      (base.valuationSubring ⧸ base.maximalIdeal)
      (target.valuationSubring ⧸ target.maximalIdeal)
    have h := Ideal.inertiaDeg_pos target.maximalIdeal base.valuationSubring
    rw [Ideal.inertiaDeg_eq_of_isMaximal base.maximalIdeal target.maximalIdeal] at h
    exact h
  let : CharZero target.residueField :=
    charZero_of_injective_algebraMap
      (algebraMap base.residueField target.residueField).injective
  let : Algebra.IsAlgebraic base.residueField target.residueField :=
    Algebra.IsAlgebraic.of_finite base.residueField target.residueField
  let : Algebra.IsSeparable base.residueField target.residueField :=
    Algebra.IsSeparable.of_integral _ _
  have hresidue_bijective :
      Function.Bijective (algebraMap base.residueField target.residueField) :=
    IsSepClosed.algebraMap_bijective _ _
  have hresidue_finrank :
      Module.finrank base.residueField target.residueField = 1 :=
    Module.finrank_of_bijective_algebraMap hresidue_bijective
  have hTot : IsTotallyRamified base.toDVF target.toDVF := by
    rw [IsTotallyRamified, residueDegree]
    change target.maximalIdeal.inertiaDeg base.valuationSubring = 1
    rw [Ideal.inertiaDeg_eq_of_isMaximal base.maximalIdeal target.maximalIdeal]
    exact hresidue_finrank
  have hn_degree : n = Module.finrank K L := by
    have hDef' := hDef
    rw [IsTotallyRamified] at hTot
    rw [IsDefectless, degree_eq_finrank, hTot, mul_one] at hDef'
    exact hDef'.symm
  have hn_pos : 0 < n := by
    rw [hn_degree]
    exact Module.finrank_pos
  let : IsSepClosed target.residueField :=
    Algebra.IsAlgebraic.isSepClosed
      (F := base.residueField) (E := target.residueField)
  have hIndexUnit : IsUnit (n : base.residueField) := by
    rw [isUnit_iff_ne_zero]
    exact Nat.cast_ne_zero.mpr hn_pos.ne'
  have hIndexTarget : IsUnit (n : target.residueField) := by
    simpa [n] using
      hIndexUnit.map (residueMap base.toDVF target.toDVF)
  obtain ⟨ϖ, π, u, hϖ, _hπ, hdecomp⟩ :=
    exists_uniformizers_unit_mul_target_uniformizer_pow_eq_base_uniformizer_image
      base.toDVF target.toDVF
  obtain ⟨δ, hδ⟩ :=
    exists_pow_eq_of_isUnit_of_isSepClosed_residue
      (n := n) hIndexTarget (u : target.valuationSubring) u.isUnit
  let αS : target.valuationSubring := δ * π
  let α : L := (αS : L)
  have hαS : αS ^ n = integerMap base.toDVF target.toDVF ϖ := by
    calc
      αS ^ n = δ ^ n * π ^ n := by simp [αS, mul_pow]
      _ = (u : target.valuationSubring) * π ^ n := by rw [hδ]
      _ = integerMap base.toDVF target.toDVF ϖ := hdecomp.symm
  have hαpow : α ^ n = algebraMap K L (ϖ : K) := by
    change ((αS ^ n : target.valuationSubring) : L) = algebraMap K L (ϖ : K)
    rw [hαS]
    exact integerMap_apply base.toDVF target.toDVF ϖ
  have hϖ_ne : ϖ ≠ 0 := by
    intro hzero
    apply hϖ.ne_zero
    exact congrArg Subtype.val hzero
  have hϖ_prime : Prime ϖ := by
    apply (Ideal.span_singleton_prime hϖ_ne).mp
    exact (base.toDVF.maximalIdeal_eq_span_uniformizer hϖ) ▸
      (IsLocalRing.maximalIdeal.isMaximal base.valuationSubring).isPrime
  let : IsFractionRing base.valuationSubring K :=
    base.toDVF.valuationSubring_isFractionRing
  let : IsIntegrallyClosed base.valuationSubring :=
    base.toDVF.valuationSubring_isIntegrallyClosed
  let f : K[X] := X ^ n - C (ϖ : K)
  have hf_irreducible : Irreducible f := by
    exact irreducible_X_pow_sub_C_fractionRing_of_prime
      (R := base.valuationSubring) (K := K) hϖ_prime hn_pos
  have hf_monic : f.Monic := by
    exact monic_X_pow_sub_C (ϖ : K) hn_pos.ne'
  have hf_root : Polynomial.aeval α f = 0 := by
    simp [f, hαpow]
  have hf_minpoly : f = minpoly K α :=
    minpoly.eq_of_irreducible_of_monic hf_irreducible hf_root hf_monic
  have hα_integral : IsIntegral K α := IsIntegral.of_finite K α
  have hadjoin_finrank :
      Module.finrank K (IntermediateField.adjoin K ({α} : Set L)) = n := by
    rw [IntermediateField.adjoin.finrank hα_integral, ← hf_minpoly]
    exact natDegree_X_pow_sub_C
  have hadjoin_top : IntermediateField.adjoin K ({α} : Set L) = ⊤ := by
    apply IntermediateField.eq_of_le_of_finrank_eq le_top
    simpa using hadjoin_finrank.trans hn_degree
  let e : AdjoinRoot f ≃ₐ[K] L :=
    (AdjoinRoot.algEquivOfEq K f (minpoly K α) hf_minpoly).trans
      ((IntermediateField.adjoinRootEquivAdjoin K hα_integral).trans
        ((IntermediateField.equivOfEq hadjoin_top).trans
          IntermediateField.topEquiv))
  have he_root : e (AdjoinRoot.root f) = α := by
    simp only [e, AlgEquiv.trans_apply, AdjoinRoot.algEquivOfEq_root,
      IntermediateField.adjoinRootEquivAdjoin_apply_root,
      IntermediateField.equivOfEq_apply]
    rfl
  refine ⟨ϖ, α, ?_, hϖ, hϖ_prime, ?_, hadjoin_top, ?_⟩
  · simpa [f] using e
  · simpa [n] using hαpow
  · simpa [f] using he_root

end EtaleFundamentalGroups.Kummer

end
