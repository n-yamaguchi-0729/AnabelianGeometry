module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Category.Ring.Under.Basic
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.CategoryTheory.Filtered.Connected
public import Mathlib.CategoryTheory.Limits.Constructions.Over.Connected
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# A field extension as a filtered colimit of actual intermediate fields

The finite subsets of an extension field index the intermediate fields they
generate. The transition maps and cocone maps are the literal inclusions.
For an algebraic extension these fields are finite dimensional, by the existing
`IntermediateField.finiteDimensional_adjoin` theorem. The construction uses
one universe for the rings and index, as required by finite-presentation descent.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace EtaleFundamentalGroups

variable (k L : Type u) [Field k] [Field L] [Algebra k L]

/-- The actual intermediate fields generated by finite sets of coefficients. -/
def intermediateFieldAdjoinDiagram : Finset L ⥤ Under (CommRingCat.of k) where
  obj s := CommRingCat.mkUnder (CommRingCat.of k) (IntermediateField.adjoin k (s : Set L))
  map {s t} f := (IntermediateField.inclusion
    (IntermediateField.adjoin.mono k (s : Set L) (t : Set L)
      (Finset.coe_subset.mpr f.le))).toUnder
  map_id s := by
    ext x
    rfl
  map_comp f g := by
    ext x
    rfl

/-- The coefficient inclusions into the original extension field. -/
def intermediateFieldAdjoinCocone : Cocone (intermediateFieldAdjoinDiagram k L) where
  pt := CommRingCat.mkUnder (CommRingCat.of k) L
  ι.app s := (IntermediateField.adjoin k (s : Set L)).val.toUnder
  ι.naturality s t f := by
    ext x
    rfl

/-- Every coefficient belongs to a singly generated intermediate field, and
inclusion into the extension detects equality at each stage. -/
def intermediateFieldAdjoinCoconeIsColimit :
    IsColimit (intermediateFieldAdjoinCocone k L) := by
  letI : IsConnected (Finset L) := IsFiltered.isConnected _
  apply isColimitOfReflects (Under.forget (CommRingCat.of k))
  letI : ReflectsColimit
      (intermediateFieldAdjoinDiagram k L ⋙ Under.forget (CommRingCat.of k))
      (forget CommRingCat.{u}) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  apply isColimitOfReflects (forget CommRingCat.{u})
  apply Types.FilteredColimit.isColimitOf'
  · intro x
    refine ⟨{x}, ⟨x, IntermediateField.subset_adjoin k _ (Finset.mem_singleton_self x)⟩, ?_⟩
    rfl
  · intro s x y hxy
    refine ⟨s, 𝟙 s, ?_⟩
    change x = y
    apply Subtype.ext
    exact hxy

end EtaleFundamentalGroups

end
