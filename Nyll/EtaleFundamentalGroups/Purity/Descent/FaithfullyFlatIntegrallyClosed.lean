import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Faithfully-flat descent of integral closedness

Integral closedness descends along a faithfully-flat map of domains without
any Noetherian hypothesis.  For an integral fraction `a / b` of the base,
integral closedness upstairs says that its image belongs to the target
domain.  Hence the image of `a` belongs to the principal ideal generated by
the image of `b`.  Faithful flatness contracts that extended ideal back to
the original principal ideal, so `b ∣ a` already in the base domain.
-/

noncomputable section

open scoped nonZeroDivisors

namespace EtaleFundamentalGroups

universe u v

/-- Integral closedness descends along a faithfully-flat map of domains.

This is the ideal-theoretic faithfully-flat descent proof: a fraction which
becomes an element of `B` makes its numerator belong to the extension of its
denominator ideal; `Ideal.comap_map_eq_self_of_faithfullyFlat` returns that
divisibility to `A`. -/
theorem isIntegrallyClosed_of_faithfullyFlat
    (A : Type u) (B : Type v)
    [CommRing A] [IsDomain A]
    [CommRing B] [IsDomain B]
    [Algebra A B] [Module.FaithfullyFlat A B]
    [IsIntegrallyClosed B] :
    IsIntegrallyClosed A := by
  have hAB : Function.Injective (algebraMap A B) :=
    FaithfulSMul.algebraMap_injective A B
  let g : A →+* FractionRing B :=
    (algebraMap B (FractionRing B)).comp (algebraMap A B)
  have hg : Function.Injective g :=
    (IsFractionRing.injective B (FractionRing B)).comp hAB
  let φ : FractionRing A →+* FractionRing B :=
    IsFractionRing.lift hg
  have hφ : φ.comp (algebraMap A (FractionRing A)) = g := by
    apply RingHom.ext
    intro a
    exact IsFractionRing.lift_algebraMap
      (A := A) (K := FractionRing A) (L := FractionRing B) (g := g) hg a
  apply (isIntegrallyClosed_iff (FractionRing A)).mpr
  intro z hz
  have hzMappedA : g.IsIntegralElem (φ z) := by
    rw [← hφ]
    exact RingHom.IsIntegralElem.map hz φ
  have hzMappedB : IsIntegral B (φ z) := by
    change (algebraMap B (FractionRing B)).IsIntegralElem (φ z)
    exact RingHom.IsIntegralElem.of_comp
      (f := algebraMap A B) (g := algebraMap B (FractionRing B))
      (by simpa only [g] using hzMappedA)
  obtain ⟨d, hd⟩ :=
    (isIntegrallyClosed_iff (FractionRing B)).mp
      (inferInstance : IsIntegrallyClosed B) hzMappedB
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective A z
  have hφfrac : φ z = g a / g b := by
    rw [← hab]
    simp only [map_div₀, φ, IsFractionRing.lift_algebraMap]
  have hdiv :
      algebraMap B (FractionRing B) (algebraMap A B a) /
          algebraMap B (FractionRing B) (algebraMap A B b) =
        algebraMap B (FractionRing B) d := by
    simpa only [g, RingHom.coe_comp, Function.comp_apply] using
      hφfrac.symm.trans hd.symm
  have hbA : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
  have hbB : algebraMap A B b ≠ 0 := by
    simpa only [map_zero] using hAB.ne hbA
  have hbFracB :
      algebraMap B (FractionRing B) (algebraMap A B b) ≠ 0 := by
    simpa only [map_zero] using
      (IsFractionRing.injective B (FractionRing B)).ne hbB
  have hmulFracB :
      algebraMap B (FractionRing B) (algebraMap A B a) =
        algebraMap B (FractionRing B) d *
          algebraMap B (FractionRing B) (algebraMap A B b) :=
    (div_eq_iff hbFracB).mp hdiv
  have hmulB : algebraMap A B a = d * algebraMap A B b := by
    apply IsFractionRing.injective B (FractionRing B)
    simpa only [map_mul] using hmulFracB
  let I : Ideal A := Ideal.span ({b} : Set A)
  have haMap : algebraMap A B a ∈ I.map (algebraMap A B) := by
    simp only [I, Ideal.map_span, Set.image_singleton,
      Ideal.mem_span_singleton]
    exact ⟨d, by simpa only [mul_comm] using hmulB⟩
  have haComap :
      a ∈ (I.map (algebraMap A B)).comap (algebraMap A B) := by
    change algebraMap A B a ∈ I.map (algebraMap A B)
    exact haMap
  have haI : a ∈ I := by
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B) I]
    exact haComap
  simp only [I, Ideal.mem_span_singleton] at haI
  obtain ⟨c, hac⟩ := haI
  refine ⟨c, ?_⟩
  rw [← hab]
  have hbFracA : algebraMap A (FractionRing A) b ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  apply (eq_div_iff hbFracA).mpr
  simpa only [map_mul, mul_comm] using
    congrArg (algebraMap A (FractionRing A)) hac.symm

end EtaleFundamentalGroups

end
