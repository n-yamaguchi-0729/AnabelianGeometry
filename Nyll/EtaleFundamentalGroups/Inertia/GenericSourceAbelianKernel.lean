/-!
# The supplied separable generic point and the actual generic abelian kernel

The canonical extension from the separable closure to the algebraic closure
gives an explicit isomorphism of the original generic fiber functors. The
original generic Galois maps commute with that isomorphism, so their kernels
agree literally inside the same absolute Galois group.

The existing native stalk-inertia normal-generation theorem therefore applies
to the supplied-separable-closure map used in the boundary-wild quotient.
Its abelianized kernel is the closed subgroup generated by the images of
the actual maximal-prime inertia groups of the original scheme stalks.
-/

@[expose] public section

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open CategoryTheory.PreGaloisCategory

namespace EtaleFundamentalGroups.Inertia

universe u

variable (X : Scheme.{u}) [IsIntegral X]

/-- Extension of the original generic fiber functor from the canonical
separable closure to the canonical algebraic closure. -/
def canonicalGenericFiberExtensionIso :
    fiber (ξ X.functionField (SeparableClosure X.functionField) ≫
      X.fromSpecStalk (genericPoint X)) ≅
        fiber (X.genericExtensionMorphism (AlgebraicClosure X.functionField)) :=
  (pullbackFiberIso (X.fromSpecStalk (genericPoint X))
    (ξ X.functionField (SeparableClosure X.functionField))).symm ≪≫
      Functor.isoWhiskerLeft (pullback (X.fromSpecStalk (genericPoint X)))
        (fieldFiberExtensionIso X.functionField
          (SeparableClosure X.functionField) (AlgebraicClosure X.functionField)) ≪≫
      pullbackFiberIso (X.fromSpecStalk (genericPoint X))
        (ξ X.functionField (AlgebraicClosure X.functionField))

/-- The canonical generic maps commute with the actual extension of their
geometric fiber fields, on every original absolute automorphism. -/
theorem canonicalGenericFiberExtensionIso_galois
    (σ : Gal(SeparableClosure X.functionField/X.functionField)) :
    (canonicalGenericFiberExtensionIso X).conjAut
      (fieldSourceAbsoluteGaloisHom X.functionField (SeparableClosure X.functionField)
        (X.fromSpecStalk (genericPoint X)) σ) = genericAbsoluteGaloisHom X σ := by
  let e := fieldFiberExtensionIso X.functionField
    (SeparableClosure X.functionField) (AlgebraicClosure X.functionField)
  have h := fundamentalGroupHom_conjAut (X.fromSpecStalk (genericPoint X))
    (ξ X.functionField (SeparableClosure X.functionField))
    (ξ X.functionField (AlgebraicClosure X.functionField)) e
    (suppliedGaloisEquivFundamentalGroup X.functionField
      (SeparableClosure X.functionField) σ)
  exact h

/-- Equality of the actual kernels in the same absolute Galois group.
The source-field extension changes the base point but not the kernel. -/
theorem canonicalFieldSourceAbsoluteGaloisHom_ker :
    (fieldSourceAbsoluteGaloisHom X.functionField (SeparableClosure X.functionField)
      (X.fromSpecStalk (genericPoint X))).toMonoidHom.ker =
        (genericAbsoluteGaloisHom X).toMonoidHom.ker := by
  apply Subgroup.ext
  intro σ
  change fieldSourceAbsoluteGaloisHom X.functionField (SeparableClosure X.functionField)
      (X.fromSpecStalk (genericPoint X)) σ = 1 ↔ genericAbsoluteGaloisHom X σ = 1
  constructor
  · intro h
    rw [← canonicalGenericFiberExtensionIso_galois X σ, h, map_one]
  · intro h
    apply (canonicalGenericFiberExtensionIso X).conjAut.injective
    rw [map_one, canonicalGenericFiberExtensionIso_galois X σ, h]

/-- The original absolute inertia images at a scheme point, retaining all
actual maximal primes of the normalization of that same scheme stalk. -/
def absoluteStalkInertiaImage (x : X) :
    Subgroup Gal(SeparableClosure X.functionField/X.functionField) := by
  let A := X.presheaf.stalk x
  let : Algebra A (SeparableClosure X.functionField) :=
    X.stalkExtensionAlgebra x (SeparableClosure X.functionField)
  have : IsScalarTower A X.functionField (SeparableClosure X.functionField) :=
    IsScalarTower.of_algebraMap_eq' rfl
  let : MulSemiringAction Gal(SeparableClosure X.functionField/X.functionField)
      (integralClosure A (SeparableClosure X.functionField)) :=
    IsIntegralClosure.MulSemiringAction A X.functionField (SeparableClosure X.functionField)
      (integralClosure A (SeparableClosure X.functionField))
  exact ⨆ Q : MaximalSpectrum (integralClosure A (SeparableClosure X.functionField)),
    Q.asIdeal.inertia Gal(SeparableClosure X.functionField/X.functionField)

/-- The actual stalk generator set is contained in a subgroup exactly when
that subgroup contains every actual stalk inertia image. -/
theorem stalkNormalizationInertiaGenerators_subset_iff
    (H : Subgroup Gal(SeparableClosure X.functionField/X.functionField)) :
    stalkNormalizationInertiaGenerators X ⊆
        (H : Set Gal(SeparableClosure X.functionField/X.functionField)) ↔
      ∀ x : X, absoluteStalkInertiaImage X x ≤ H := by
  constructor
  · intro h x
    let A := X.presheaf.stalk x
    let : Algebra A (SeparableClosure X.functionField) :=
      X.stalkExtensionAlgebra x (SeparableClosure X.functionField)
    have : IsScalarTower A X.functionField (SeparableClosure X.functionField) :=
      IsScalarTower.of_algebraMap_eq' rfl
    let : MulSemiringAction Gal(SeparableClosure X.functionField/X.functionField)
        (integralClosure A (SeparableClosure X.functionField)) :=
      IsIntegralClosure.MulSemiringAction A X.functionField (SeparableClosure X.functionField)
        (integralClosure A (SeparableClosure X.functionField))
    change (⨆ Q : MaximalSpectrum (integralClosure A (SeparableClosure X.functionField)),
      Q.asIdeal.inertia Gal(SeparableClosure X.functionField/X.functionField)) ≤ H
    apply iSup_le
    intro Q σ hσ
    exact h ⟨x, Q.asIdeal, Q.isMaximal, hσ⟩
  · intro h σ hσ
    obtain ⟨x, Q, hQ, hσQ⟩ := hσ
    let A := X.presheaf.stalk x
    let : Algebra A (SeparableClosure X.functionField) :=
      X.stalkExtensionAlgebra x (SeparableClosure X.functionField)
    have : IsScalarTower A X.functionField (SeparableClosure X.functionField) :=
      IsScalarTower.of_algebraMap_eq' rfl
    let : MulSemiringAction Gal(SeparableClosure X.functionField/X.functionField)
        (integralClosure A (SeparableClosure X.functionField)) :=
      IsIntegralClosure.MulSemiringAction A X.functionField (SeparableClosure X.functionField)
        (integralClosure A (SeparableClosure X.functionField))
    apply h x
    exact (le_iSup (fun q : MaximalSpectrum (integralClosure A
      (SeparableClosure X.functionField)) =>
        q.asIdeal.inertia Gal(SeparableClosure X.functionField/X.functionField)) ⟨Q, hQ⟩) hσQ

/-- A field stalk has field normalization, whose unique maximal ideal
forces every original coefficient to be fixed. -/
private theorem absoluteStalkInertiaImage_eq_bot_of_isField
    (x : X) (hA : IsField (X.presheaf.stalk x)) :
    absoluteStalkInertiaImage X x = ⊥ := by
  let A := X.presheaf.stalk x
  let : Field A := hA.toField
  let Ω := SeparableClosure X.functionField
  let : Algebra A Ω := X.stalkExtensionAlgebra x Ω
  have : IsScalarTower A X.functionField Ω := IsScalarTower.of_algebraMap_eq' rfl
  let B := integralClosure A Ω
  let : MulSemiringAction Gal(Ω/X.functionField) B :=
    IsIntegralClosure.MulSemiringAction A X.functionField Ω B
  have hfield : IsField B := IsIntegralClosure.isField
    (R := A) (A := B) (B := Ω) hA
  have : Algebra.IsAlgebraic A Ω :=
    (IsFractionRing.comap_isAlgebraic_iff (A := A) (K := X.functionField) (C := Ω)).mpr
      inferInstance
  have honto : Function.Surjective (algebraMap B Ω) := by
    intro z
    exact ⟨⟨z, Algebra.IsIntegral.isIntegral z⟩, rfl⟩
  change (⨆ Q : MaximalSpectrum B, Q.asIdeal.inertia Gal(Ω/X.functionField)) = ⊥
  apply le_antisymm
  · apply iSup_le
    intro Q σ hσ
    apply Subgroup.mem_bot.mpr
    have hQ : Q.asIdeal = ⊥ :=
      ((Ring.isField_iff_maximal_bot.mp hfield).eq_of_le Q.isMaximal.ne_top bot_le).symm
    apply AlgEquiv.ext
    intro z
    obtain ⟨b, rfl⟩ := honto z
    have hb := hσ b
    rw [hQ] at hb
    have hfix : σ • b = b := sub_eq_zero.mp (Ideal.mem_bot.mp hb)
    calc
      σ (algebraMap B Ω b) = algebraMap B Ω (σ • b) :=
        (algebraMap_galRestrict_apply A (K := X.functionField) (L := Ω) (B := B) σ b).symm
      _ = algebraMap B Ω b := congrArg (algebraMap B Ω) hfix
  · exact bot_le

/-- The generic stalk contributes no inertia. -/
theorem absoluteStalkInertiaImage_genericPoint :
    absoluteStalkInertiaImage X (genericPoint X) = ⊥ :=
  absoluteStalkInertiaImage_eq_bot_of_isField X (genericPoint X)
    (Field.toIsField X.functionField)

variable [IsNormalIntegral X]

/-- Native stalk normal generation for the supplied-separable generic map,
with the same original absolute Galois group and original stalks. -/
theorem canonicalFieldSourceAbsoluteGaloisHom_ker_stalk :
    (fieldSourceAbsoluteGaloisHom X.functionField (SeparableClosure X.functionField)
      (X.fromSpecStalk (genericPoint X))).toMonoidHom.ker =
        (Subgroup.normalClosure (stalkNormalizationInertiaGenerators X)).topologicalClosure := by
  rw [canonicalFieldSourceAbsoluteGaloisHom_ker,
    genericAbsoluteGaloisHom_ker_eq_normalClosure_affineNormalizationInertia,
    affineNormalizationInertiaGenerators_eq_stalk]

/-- After abelianization, the actual generic kernel is exactly the closed
subgroup generated by the actual original stalk-inertia images. -/
theorem canonicalFieldSourceAbsoluteGaloisHom_ker_abelian_image :
    ((fieldSourceAbsoluteGaloisHom X.functionField (SeparableClosure X.functionField)
      (X.fromSpecStalk (genericPoint X))).toMonoidHom.ker).map
        (ProCGroups.Abelian.TopologicalAbelianization.mk
          Gal(SeparableClosure X.functionField/X.functionField)) =
      (⨆ x : X, (absoluteStalkInertiaImage X x).map
        (ProCGroups.Abelian.TopologicalAbelianization.mk
          Gal(SeparableClosure X.functionField/X.functionField))).topologicalClosure := by
  let G := Gal(SeparableClosure X.functionField/X.functionField)
  let a := ProCGroups.Abelian.TopologicalAbelianization.mkₜ G
  let N : Subgroup G :=
    (Subgroup.normalClosure (stalkNormalizationInertiaGenerators X)).topologicalClosure
  let W : Subgroup (TopologicalAbelianization G) :=
    ⨆ x : X, (absoluteStalkInertiaImage X x).map a.toMonoidHom
  rw [canonicalFieldSourceAbsoluteGaloisHom_ker_stalk]
  change N.map a.toMonoidHom = W.topologicalClosure
  have hclosed : IsClosed (N : Set G) := Subgroup.isClosed_topologicalClosure _
  have himageClosed : IsClosed (N.map a.toMonoidHom : Set (TopologicalAbelianization G)) :=
    (hclosed.isCompact.image a.continuous_toFun).isClosed
  have hlocal : ∀ x : X, absoluteStalkInertiaImage X x ≤ N := by
    apply (stalkNormalizationInertiaGenerators_subset_iff X N).mp
    intro σ hσ
    exact (Subgroup.le_topologicalClosure _) (Subgroup.subset_normalClosure hσ)
  apply le_antisymm
  · have hN : N ≤ W.topologicalClosure.comap a.toMonoidHom := by
      apply Subgroup.topologicalClosure_minimal
      · apply Subgroup.normalClosure_le_normal
        apply (stalkNormalizationInertiaGenerators_subset_iff X _).mpr
        intro x σ hσ
        apply Subgroup.le_topologicalClosure W
        exact (le_iSup (fun y : X => (absoluteStalkInertiaImage X y).map a.toMonoidHom) x)
          ⟨σ, hσ, rfl⟩
      · exact (Subgroup.isClosed_topologicalClosure W).preimage a.continuous_toFun
    rintro σ ⟨g, hg, rfl⟩
    exact hN hg
  · apply Subgroup.topologicalClosure_minimal
    · apply iSup_le
      intro x
      rintro σ ⟨g, hg, rfl⟩
      exact ⟨g, hlocal x hg, rfl⟩
    · exact himageClosed

/-- On an actual smooth curve the same abelian kernel is generated by
closed-point inertia alone; the generic point has been proved trivial. -/
theorem canonicalFieldSourceAbsoluteGaloisHom_ker_closedPoint_image
    {k : Type u} [Field k] (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c] :
    ((fieldSourceAbsoluteGaloisHom X.functionField (SeparableClosure X.functionField)
      (X.fromSpecStalk (genericPoint X))).toMonoidHom.ker).map
        (ProCGroups.Abelian.TopologicalAbelianization.mk
          Gal(SeparableClosure X.functionField/X.functionField)) =
      (⨆ x : closedPoints X, (absoluteStalkInertiaImage X x.val).map
        (ProCGroups.Abelian.TopologicalAbelianization.mk
          Gal(SeparableClosure X.functionField/X.functionField))).topologicalClosure := by
  rw [canonicalFieldSourceAbsoluteGaloisHom_ker_abelian_image]
  congr 1
  apply le_antisymm
  · apply iSup_le
    intro x
    by_cases hx : x = genericPoint X
    · subst x
      rw [absoluteStalkInertiaImage_genericPoint, Subgroup.map_bot]
      exact bot_le
    · exact le_iSup
        (fun y : closedPoints X => (absoluteStalkInertiaImage X y.val).map
          (ProCGroups.Abelian.TopologicalAbelianization.mk
            Gal(SeparableClosure X.functionField/X.functionField)))
        ⟨x, mem_closedPoints_iff.mpr
          (AlgebraicCurve.isClosed_singleton_of_ne_genericPoint c x hx)⟩
  · apply iSup_le
    intro x
    exact le_iSup
      (fun y : X => (absoluteStalkInertiaImage X y).map
        (ProCGroups.Abelian.TopologicalAbelianization.mk
          Gal(SeparableClosure X.functionField/X.functionField))) x.val

end EtaleFundamentalGroups.Inertia
