/-!
# The generic kernel generated by inertia at actual normalization points

The generators here are original automorphisms fixing an actual point of
the normalization in the separable closure and inducing its identity residue
action. Their union equals the original affine ideal-inertia generator set.

One direction uses the actual residue point of a prime and normalization-chart
equivariance. For the converse, the canonical residue point at a scheme point
lifts through an affine normalization chart. Cancellation of this monomorphism
and the affine spectrum adjunction give membership in the original inertia of
the prime kernel. No chart-action or point-inertia identification is assumed.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace EtaleFundamentalGroups.Inertia

universe u

private local instance fieldSpecQuasiCompact
    {K : Type u} [Field K] {S : Scheme.{u}} (f : Spec (.of K) ⟶ S) :
    QuasiCompact f where
  isCompact_preimage U _ _ := (Set.toFinite (f ⁻¹' U)).isCompact

/-- Original inertia elements indexed by the actual points of the
normalization in the same separable closure of the function field. -/
def pointNormalizationInertiaGenerators (X : Scheme.{u}) [IsIntegral X] :
    Set Gal(SeparableClosure X.functionField/X.functionField) :=
  { σ | ∃ (y : (X.genericExtensionMorphism (SeparableClosure X.functionField)).normalization)
      (hy : normalizationEndomorphism
        (X.genericExtensionMorphism (SeparableClosure X.functionField))
        (Spec.map (CommRingCat.ofHom σ.toRingHom))
        (genericExtensionMorphism_specMap_algEquiv X (SeparableClosure X.functionField) σ) y = y),
      (normalizationEndomorphism
        (X.genericExtensionMorphism (SeparableClosure X.functionField))
        (Spec.map (CommRingCat.ofHom σ.toRingHom))
        (genericExtensionMorphism_specMap_algEquiv X
          (SeparableClosure X.functionField) σ)).residueFieldMap y =
        ((X.genericExtensionMorphism
          (SeparableClosure X.functionField)).normalization.residueFieldCongr hy).hom }

/-- The affine and actual scheme-point inertia generators are the same
elements of the original absolute Galois group, also for the infinite
separable closure. -/
theorem affineNormalizationInertiaGenerators_eq_pointNormalizationInertiaGenerators
    (X : Scheme.{u}) [IsIntegral X] :
    affineNormalizationInertiaGenerators X = pointNormalizationInertiaGenerators X := by
  ext σ
  let L : Type u := SeparableClosure X.functionField
  let f : Spec (.of L) ⟶ X := X.genericExtensionMorphism L
  let e : f.normalization ⟶ f.normalization :=
    normalizationEndomorphism f (Spec.map (CommRingCat.ofHom σ.toRingHom))
      (genericExtensionMorphism_specMap_algEquiv X L σ)
  constructor
  · intro hσ
    obtain ⟨U, hU, Q, hQ, hσQ⟩ := hσ
    have : Nonempty U.1 := hU
    let : Algebra Γ(X, U.1) L := X.affineExtensionAlgebra U.1 L
    have : IsFractionRing Γ(X, U.1) X.functionField :=
      functionField_isFractionRing_of_isAffineOpen X U.1 U.2
    have : IsScalarTower Γ(X, U.1) X.functionField L :=
      IsScalarTower.of_algebraMap_eq' rfl
    let : MulSemiringAction Gal(L/X.functionField) (integralClosure Γ(X, U.1) L) :=
      IsIntegralClosure.MulSemiringAction Γ(X, U.1) X.functionField L
        (integralClosure Γ(X, U.1) L)
    have : Q.IsPrime := hQ
    let B : Type u := integralClosure Γ(X, U.1) L
    let c : Spec (.of B) ⟶ f.normalization := genericNormalizationChart X L U.1 U.2
    let φ : B →+* Q.ResidueField := algebraMap B Q.ResidueField
    let z₀ : Spec (.of Q.ResidueField) ⟶ Spec (.of B) := Spec.map (CommRingCat.ofHom φ)
    let z : Spec (.of Q.ResidueField) ⟶ f.normalization := z₀ ≫ c
    have hσker : σ ∈ (RingHom.ker φ).inertia Gal(L/X.functionField) := by
      rw [show RingHom.ker φ = Q from Ideal.ker_algebraMap_residueField Q]
      exact hσQ
    have hfix : z₀ ≫ Spec.map (CommRingCat.ofHom
        (MulSemiringAction.toRingHom Gal(L/X.functionField) B σ)) = z₀ :=
      (mem_idealInertia_iff_fixes_affineGeometricPoint Gal(L/X.functionField) φ σ).mp hσker
    have haction : MulSemiringAction.toRingHom Gal(L/X.functionField) B σ =
        (σ.restrictScalars Γ(X, U.1)).mapIntegralClosure.toRingHom :=
      (normalizationGaloisRingHom_eq_original Γ(X, U.1) X.functionField L σ).symm
    rw [haction] at hfix
    have hchart : Spec.map (CommRingCat.ofHom
        (σ.restrictScalars Γ(X, U.1)).mapIntegralClosure.toRingHom) ≫ c = c ≫ e :=
      genericNormalizationChart_endomorphism X L U.1 U.2 σ
    have hz : z ≫ e = z := by
      change (z₀ ≫ c) ≫ e = z₀ ≫ c
      rw [Category.assoc, ← hchart, ← Category.assoc, hfix]
    let t : Spec (.of Q.ResidueField) := IsLocalRing.closedPoint Q.ResidueField
    obtain ⟨hy, hres⟩ := Scheme.Hom.residueFieldMap_eq_of_comp_eq_self e z hz t
    exact ⟨z t, hy, hres⟩
  · intro hσ
    obtain ⟨y, hy, hres⟩ := hσ
    let z : Spec (f.normalization.residueField y) ⟶ f.normalization :=
      f.normalization.fromSpecResidueField y
    have hz : z ≫ e = z :=
      Scheme.Hom.fixes_fromSpecResidueField_of_residueFieldMap_eq e y hy hres
    obtain ⟨U, hU, hxU, _⟩ := exists_isAffineOpen_mem_and_subset
      (X := X) (U := ⊤) (x := f.fromNormalization y) (by trivial)
    have hNonempty : Nonempty U := ⟨⟨f.fromNormalization y, hxU⟩⟩
    let : Algebra Γ(X, U) L := X.affineExtensionAlgebra U L
    have : IsFractionRing Γ(X, U) X.functionField :=
      functionField_isFractionRing_of_isAffineOpen X U hU
    have : IsScalarTower Γ(X, U) X.functionField L :=
      IsScalarTower.of_algebraMap_eq' rfl
    let : MulSemiringAction Gal(L/X.functionField) (integralClosure Γ(X, U) L) :=
      IsIntegralClosure.MulSemiringAction Γ(X, U) X.functionField L
        (integralClosure Γ(X, U) L)
    let B : Type u := integralClosure Γ(X, U) L
    let c : Spec (.of B) ⟶ f.normalization := genericNormalizationChart X L U hU
    let t : Spec (.of B) ⟶ Spec (.of B) := Spec.map (CommRingCat.ofHom
      (σ.restrictScalars Γ(X, U)).mapIntegralClosure.toRingHom)
    have H := isPullback_genericNormalizationChart X L U hU
    have : Mono c := H.mono_snd_of_mono
    have hrange : Set.range (z ≫ f.fromNormalization) ⊆ Set.range hU.fromSpec := by
      rintro _ ⟨s, rfl⟩
      change f.fromNormalization (f.normalization.fromSpecResidueField y s) ∈
        Set.range hU.fromSpec
      rw [Scheme.fromSpecResidueField_apply, hU.range_fromSpec]
      exact hxU
    let zbase : Spec (f.normalization.residueField y) ⟶ Spec Γ(X, U) :=
      IsOpenImmersion.lift hU.fromSpec (z ≫ f.fromNormalization) hrange
    have hbase : zbase ≫ hU.fromSpec = z ≫ f.fromNormalization :=
      IsOpenImmersion.lift_fac hU.fromSpec (z ≫ f.fromNormalization) hrange
    let z₀ : Spec (f.normalization.residueField y) ⟶ Spec (.of B) :=
      H.lift zbase z hbase
    have hz₀ : z₀ ≫ c = z := H.lift_snd zbase z hbase
    have hchart : t ≫ c = c ≫ e := genericNormalizationChart_endomorphism X L U hU σ
    have hfix : z₀ ≫ t = z₀ := by
      apply (cancel_mono c).mp
      rw [Category.assoc, hchart, ← Category.assoc, hz₀, hz]
    let φ : B →+* f.normalization.residueField y := (Spec.preimage z₀).hom
    have hφ : Spec.map (CommRingCat.ofHom φ) = z₀ := Spec.map_preimage z₀
    have haction : MulSemiringAction.toRingHom Gal(L/X.functionField) B σ =
        (σ.restrictScalars Γ(X, U)).mapIntegralClosure.toRingHom :=
      (normalizationGaloisRingHom_eq_original Γ(X, U) X.functionField L σ).symm
    have hσker : σ ∈ (RingHom.ker φ).inertia Gal(L/X.functionField) := by
      apply (mem_idealInertia_iff_fixes_affineGeometricPoint Gal(L/X.functionField) φ σ).mpr
      rw [hφ, haction]
      exact hfix
    exact ⟨⟨U, hU⟩, hNonempty, RingHom.ker φ, RingHom.ker_isPrime φ, hσker⟩

/-- The original generic-point kernel is the closed normal subgroup
generated by inertia at the actual points of the normalization in the
separable closure, with the literal point and residue-field action. -/
theorem genericAbsoluteGaloisHom_ker_eq_normalClosure_pointNormalizationInertia
    (X : Scheme.{u}) [IsIntegral X] [IsNormalIntegral X] :
    (AlgebraicGeometry.FiniteEtale.genericAbsoluteGaloisHom X).toMonoidHom.ker =
      (Subgroup.normalClosure (pointNormalizationInertiaGenerators X)).topologicalClosure := by
  rw [← affineNormalizationInertiaGenerators_eq_pointNormalizationInertiaGenerators X]
  exact genericAbsoluteGaloisHom_ker_eq_normalClosure_affineNormalizationInertia X

end EtaleFundamentalGroups.Inertia
