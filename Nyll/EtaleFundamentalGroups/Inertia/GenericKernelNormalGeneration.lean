import Nyll.EtaleFundamentalGroups.GeometricFiber.GenericKernelFiniteGalois
import Nyll.EtaleFundamentalGroups.Inertia.FiniteGaloisInertiaCriterion
import Nyll.EtaleFundamentalGroups.Normalization.AffineInertiaCriterion
import Nyll.SchemeTheory.Normalization.FiniteSeparable

/-!
# The generic-point kernel is normally generated by original inertia

The generators are the original ideal inertia groups of the literal
normalization rings on all nonempty affine charts. The existing actual
normalization-chart pullbacks and the finite Galois inertia image theorem
identify exactly which finite Galois restrictions annihilate these groups.
The actual generic-point kernel has precisely the same finite restrictions.

No Noetherian, finiteness-of-normalization, or kernel-comparison hypothesis
is imposed.

Reference: https://stacks.math.columbia.edu/tag/0BTD
-/

noncomputable section

open AlgebraicGeometry AlgebraicGeometry.FiniteEtale

namespace EtaleFundamentalGroups.Inertia

universe u

/-- The original normalization-inertia elements on all nonempty affine
charts of an integral scheme, regarded in the same absolute Galois group. -/
def affineNormalizationInertiaGenerators (X : Scheme.{u}) [IsIntegral X] :
    Set Gal(SeparableClosure X.functionField/X.functionField) :=
  { σ | ∃ (U : X.affineOpens) (hU : Nonempty U.1),
      let : Nonempty U.1 := hU
      let : Algebra Γ(X, U.1) (SeparableClosure X.functionField) :=
        X.affineExtensionAlgebra U.1 (SeparableClosure X.functionField)
      let : IsFractionRing Γ(X, U.1) X.functionField :=
        functionField_isFractionRing_of_isAffineOpen X U.1 U.2
      let : IsScalarTower Γ(X, U.1) X.functionField
          (SeparableClosure X.functionField) :=
        IsScalarTower.of_algebraMap_eq' rfl
      let : MulSemiringAction Gal(SeparableClosure X.functionField/X.functionField)
          (integralClosure Γ(X, U.1) (SeparableClosure X.functionField)) :=
        IsIntegralClosure.MulSemiringAction Γ(X, U.1) X.functionField
          (SeparableClosure X.functionField)
          (integralClosure Γ(X, U.1) (SeparableClosure X.functionField))
      ∃ Q : Ideal (integralClosure Γ(X, U.1) (SeparableClosure X.functionField)),
        Q.IsPrime ∧ σ ∈ Q.inertia Gal(SeparableClosure X.functionField/X.functionField) }

/-- A finite Galois restriction kills every original normalization inertia
exactly when its actual global normalization is etale. -/
theorem affineNormalizationInertiaGenerators_subset_fixingSubgroup_iff_etale
    (X : Scheme.{u}) [IsIntegral X] [IsNormalIntegral X]
    (E : FiniteGaloisIntermediateField X.functionField
      (SeparableClosure X.functionField)) :
    affineNormalizationInertiaGenerators X ⊆
        (E.toIntermediateField.fixingSubgroup :
          Set Gal(SeparableClosure X.functionField/X.functionField)) ↔
      Etale (X.genericExtensionMorphism E).fromNormalization := by
  constructor
  · intro h
    apply (etale_genericNormalization_iff_all_affine_inertia_eq_bot X E).mpr
    intro U hU actualAlgebra actualFraction actualTower actualAction
    let : Algebra Γ(X, U.1) (SeparableClosure X.functionField) :=
      X.affineExtensionAlgebra U.1 (SeparableClosure X.functionField)
    have : IsScalarTower Γ(X, U.1) X.functionField
        (SeparableClosure X.functionField) :=
      IsScalarTower.of_algebraMap_eq' rfl
    apply (all_normalization_inertia_le_fixingSubgroup_iff Γ(X, U.1)
      X.functionField (SeparableClosure X.functionField) E).mp
    intro Q hQ σ hσ
    exact h ⟨U, hU, Q, hQ, hσ⟩
  · intro h σ hσ
    obtain ⟨U, hU, Q, hQ, hσQ⟩ := hσ
    have : Nonempty U.1 := hU
    let : Algebra Γ(X, U.1) (SeparableClosure X.functionField) :=
      X.affineExtensionAlgebra U.1 (SeparableClosure X.functionField)
    have : IsFractionRing Γ(X, U.1) X.functionField :=
      functionField_isFractionRing_of_isAffineOpen X U.1 U.2
    have : IsScalarTower Γ(X, U.1) X.functionField
        (SeparableClosure X.functionField) :=
      IsScalarTower.of_algebraMap_eq' rfl
    have : Q.IsPrime := hQ
    have hfinite :=
      (etale_genericNormalization_iff_all_affine_inertia_eq_bot X E).mp h U
    exact (all_normalization_inertia_le_fixingSubgroup_iff Γ(X, U.1)
      X.functionField (SeparableClosure X.functionField) E).mpr hfinite Q hσQ

/-- On an arbitrary normal integral scheme, the literal generic-point
kernel is the smallest closed normal subgroup containing every original
normalization inertia group on every affine chart. -/
theorem genericAbsoluteGaloisHom_ker_eq_normalClosure_affineNormalizationInertia
    (X : Scheme.{u}) [IsIntegral X] [IsNormalIntegral X] :
    (genericAbsoluteGaloisHom X).toMonoidHom.ker =
      (Subgroup.normalClosure (affineNormalizationInertiaGenerators X)).topologicalClosure := by
  rw [genericAbsoluteGaloisHom_ker_eq_iInf_etale_finiteGalois,
    topologicalClosure_normalClosure_eq_iInf_finiteGalois]
  apply le_antisymm
  · apply le_iInf
    intro E
    apply le_iInf
    intro hE σ hσ
    have hEtale :=
      (affineNormalizationInertiaGenerators_subset_fixingSubgroup_iff_etale X E).mp hE
    exact Subgroup.mem_iInf.mp (Subgroup.mem_iInf.mp hσ E) hEtale
  · apply le_iInf
    intro E
    apply le_iInf
    intro hEtale σ hσ
    have hE :=
      (affineNormalizationInertiaGenerators_subset_fixingSubgroup_iff_etale X E).mpr hEtale
    exact Subgroup.mem_iInf.mp (Subgroup.mem_iInf.mp hσ E) hE

end EtaleFundamentalGroups.Inertia
