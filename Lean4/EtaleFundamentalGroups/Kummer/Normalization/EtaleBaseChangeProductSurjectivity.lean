import EtaleFundamentalGroups.Kummer.Normalization.EtaleBaseChangeInertiaCardinality

/-!
# From generic composita to integral etale base changes

A selected generic tensor component is already generated by the two
function fields.  For an etale map of domains, its image is also generated
by the smaller etale algebra and the old function field: that image is a
finite-dimensional domain over the old field, hence a field and therefore
contains the whole new fraction field.
-/

noncomputable section

open scoped TensorProduct

namespace EtaleFundamentalGroups

universe u

/-- Surjectivity of the product map on fraction fields descends to the
product map formed with the original etale algebra. -/
theorem etaleBaseChangeProductMap_surjective_of_fractionFieldProductMap_surjective
    {A C F KC L M : Type u}
    [CommRing A] [IsDomain A]
    [CommRing C] [IsDomain C] [Algebra A C] [Algebra.Etale A C]
    [Field F] [Algebra A F] [IsFractionRing A F]
    [Field KC] [Algebra C KC] [IsFractionRing C KC]
    [Algebra A KC] [IsScalarTower A C KC]
    [Algebra F KC] [IsScalarTower A F KC]
    [Field L] [Algebra F L] [Algebra A L] [IsScalarTower A F L]
    [Field M] [Algebra KC M] [Algebra C M]
    [Algebra L M] [Algebra F M] [Algebra A M]
    [IsScalarTower C KC M] [IsScalarTower F KC M]
    [IsScalarTower F L M] [IsScalarTower A C M]
    [IsScalarTower A L M]
    (hgeneric : Function.Surjective
      (Algebra.TensorProduct.productMap
        (IsScalarTower.toAlgHom F KC M)
        (IsScalarTower.toAlgHom F L M))) :
    Function.Surjective
      (etaleBaseChangeProductMap (A := A) (C := C) (L := L) (M := M)) := by
  classical
  let T := C ⊗[A] L
  let : Algebra L T := Algebra.TensorProduct.rightAlgebra
  let commL : (L ⊗[A] C) ≃ₐ[L] T :=
    Algebra.TensorProduct.commRight A L C
  let : Algebra.Etale L T := Algebra.Etale.of_equiv commL
  let : Module.Finite L T :=
    Algebra.FormallyUnramified.finite_of_free L T
  let productC : T →ₐ[C] M :=
    etaleBaseChangeProductMap (A := A) (C := C) (L := L) (M := M)
  let productL : T →ₐ[L] M :=
    { toRingHom := productC.toRingHom
      commutes' := by
        intro l
        change productC (1 ⊗ₜ[A] l) = algebraMap L M l
        change algebraMap C M 1 * algebraMap L M l =
          algebraMap L M l
        simp }
  let R : Subalgebra L M := productL.range
  let : Module.Finite L R := Module.Finite.range productL.toLinearMap
  let : Field R := fieldOfFiniteDimensional L R
  let g : C →+* R :=
    productL.rangeRestrict.toRingHom.comp
      (Algebra.TensorProduct.includeLeftRingHom
        (R := A) (A := C) (B := L))
  have hg_val (c : C) : ((g c : R) : M) = algebraMap C M c := by
    change productC (c ⊗ₜ[A] 1) = algebraMap C M c
    change algebraMap C M c * algebraMap L M 1 = algebraMap C M c
    simp
  have hg : Function.Injective g := by
    intro x y hxy
    have hv := congrArg (fun z : R ↦ (z : M)) hxy
    rw [hg_val, hg_val] at hv
    have hv' : algebraMap KC M (algebraMap C KC x) =
        algebraMap KC M (algebraMap C KC y) := by
      simpa only [IsScalarTower.algebraMap_apply C KC M] using hv
    exact (FaithfulSMul.algebraMap_injective C KC)
      ((FaithfulSMul.algebraMap_injective KC M) hv')
  let kLift : KC →+* R := IsFractionRing.lift hg
  let valHom : R →+* M := R.val
  have hkHom : valHom.comp kLift = algebraMap KC M := by
    apply IsFractionRing.ringHom_ext (A := C)
    intro c
    simp only [RingHom.comp_apply, kLift,
      IsFractionRing.lift_algebraMap, valHom]
    calc
      ((g c : R) : M) = algebraMap C M c := hg_val c
      _ = algebraMap KC M (algebraMap C KC c) :=
        IsScalarTower.algebraMap_apply C KC M c
  let kAlg : KC →ₐ[F] R :=
    { toRingHom := kLift
      commutes' := by
        intro x
        apply R.val.injective
        calc
          R.val.toRingHom (kLift (algebraMap F KC x)) =
              (valHom.comp kLift) (algebraMap F KC x) := rfl
          _ = algebraMap KC M (algebraMap F KC x) :=
            RingHom.congr_fun hkHom _
          _ = algebraMap F M x :=
            (IsScalarTower.algebraMap_apply F KC M x).symm
          _ = R.val.toRingHom (algebraMap F R x) := by
            calc
              algebraMap F M x =
                  algebraMap L M (algebraMap F L x) :=
                IsScalarTower.algebraMap_apply F L M x
              _ = R.val.toRingHom
                  (algebraMap L R (algebraMap F L x)) := by
                symm
                exact R.val.commutes (algebraMap F L x)
              _ = R.val.toRingHom (algebraMap F R x) := by
                rw [IsScalarTower.algebraMap_apply F L R] }
  let lAlg : L →ₐ[F] R := IsScalarTower.toAlgHom F L R
  let productR : KC ⊗[F] L →ₐ[F] R :=
    Algebra.TensorProduct.productMap kAlg lAlg
  let valAlg : R →ₐ[F] M := R.val.restrictScalars F
  have hfactor : valAlg.comp productR =
      Algebra.TensorProduct.productMap
        (IsScalarTower.toAlgHom F KC M)
        (IsScalarTower.toAlgHom F L M) := by
    apply Algebra.TensorProduct.ext'
    intro a b
    change R.val (kLift a * algebraMap L R b) =
      algebraMap KC M a * algebraMap L M b
    rw [map_mul]
    have hka : R.val (kLift a) = algebraMap KC M a := by
      change valHom (kLift a) = algebraMap KC M a
      exact RingHom.congr_fun hkHom a
    rw [hka]
    rw [R.val.commutes]
  intro m
  obtain ⟨x, hx⟩ := hgeneric m
  let y : R := productR x
  obtain ⟨z, hz⟩ := y.2
  refine ⟨z, ?_⟩
  have hz' : productC z = (y : M) := hz
  calc
    etaleBaseChangeProductMap z = productC z := rfl
    _ = (y : M) := hz'
    _ = valAlg (productR x) := rfl
    _ = _ := (DFunLike.congr_fun hfactor x).trans hx

end EtaleFundamentalGroups
