import EtaleFundamentalGroups.GeometricFiber.GenericPointFixedSubfield
import EtaleFundamentalGroups.GeometricFiber.GenericPointSurjective
import GaloisCohomology.Kummer.Concrete.SeparableKummerH1
import GaloisCohomology.Kummer.Concrete.RootCharacters
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Actual root fields of characters of the generic fundamental group

The separable field Kummer equivalence supplies a function and a root for each
finite Kummer character of the scheme fundamental group. Its generic kernel
fixes the actual field generated by that root, so that field is the literal
generic fiber of an actual finite etale cover of the original scheme.
-/

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory
open scoped IntermediateField
open ClassFieldTower.Martinet.Shafarevich KummerTheory

namespace EtaleFundamentalGroups.Kummer

/-- A character of the actual scheme fundamental group is represented by an
actual Kummer root whose generated field extends to a finite etale cover.
The exponent need only be nonzero in the function field. -/
theorem exists_finiteEtale_genericKummerRoot
    (X : Scheme.{u}) [IsIntegral X] [IsNormalIntegral X]
    (n : ℕ+) [NeZero ((n : ℕ) : X.functionField)]
    (hmu : (primitiveRoots (n : ℕ) X.functionField).Nonempty)
    (χ : Aut (FiniteEtale.fiber
      (X.genericExtensionMorphism (AlgebraicClosure X.functionField))) →ₜ*
        DiscreteNthRootsSubgroup (SeparableClosure X.functionField) (n : ℕ)) :
    ∃ (a : X.functionFieldˣ) (β : (SeparableClosure X.functionField)ˣ),
      β ^ (n : ℕ) = Units.map
        (algebraMap X.functionField (SeparableClosure X.functionField)).toMonoidHom a ∧
      (∀ σ : Gal(SeparableClosure X.functionField / X.functionField),
        (χ (FiniteEtale.genericAbsoluteGaloisHom X σ) :
          (SeparableClosure X.functionField)ˣ) = rootQuotient β σ) ∧
      ∃ (Y : Scheme.{u}) (f : Y ⟶ X), IsFinite f ∧ Etale f ∧
        ∃ e : Limits.pullback f (X.fromSpecStalk (genericPoint X)) ≅
            Spec (.of (X.functionField⟮(β : SeparableClosure X.functionField)⟯)),
          e.hom ≫ Spec.map (CommRingCat.ofHom
            (algebraMap X.functionField
              (X.functionField⟮(β : SeparableClosure X.functionField)⟯))) =
                Limits.pullback.snd f (X.fromSpecStalk (genericPoint X)) := by
  let κ := separableKummerContinuousNthRootsCharacterEquiv X.functionField n hmu
  obtain ⟨q, hq⟩ := κ.surjective (χ.comp (FiniteEtale.genericAbsoluteGaloisHom X))
  obtain ⟨a, ha⟩ := QuotientGroup.mk_surjective q
  subst q
  have haRoot : a ∈ finiteKummerRadicalSubgroup
      (K := X.functionField) (L := SeparableClosure X.functionField) n := by
    rw [finiteKummerRadicalSubgroup_separableClosure_eq_top X.functionField n]
    exact Subgroup.mem_top a
  obtain ⟨β, hβ⟩ := (mem_finiteKummerRadicalSubgroup_iff n).mp haRoot
  have hχ (σ : Gal(SeparableClosure X.functionField / X.functionField)) :
      (χ (FiniteEtale.genericAbsoluteGaloisHom X σ) :
        (SeparableClosure X.functionField)ˣ) = rootQuotient β σ := by
    have heval := separableKummerContinuousNthRootsCharacterEquiv_apply_of_pow_eq
      X.functionField n hmu a β hβ σ
    have hcomp := congrArg
      (fun ψ : Gal(SeparableClosure X.functionField / X.functionField) →ₜ*
        DiscreteNthRootsSubgroup (SeparableClosure X.functionField) (n : ℕ) =>
          ((ψ σ : DiscreteNthRootsSubgroup
            (SeparableClosure X.functionField) (n : ℕ)) :
              (SeparableClosure X.functionField)ˣ)) hq
    exact hcomp.symm.trans heval
  let L : IntermediateField X.functionField (SeparableClosure X.functionField) :=
    X.functionField⟮(β : SeparableClosure X.functionField)⟯
  have : FiniteDimensional X.functionField L :=
    IntermediateField.adjoin.finiteDimensional
      (Algebra.IsIntegral.isIntegral (β : SeparableClosure X.functionField))
  have hfix : (FiniteEtale.genericAbsoluteGaloisHom X).toMonoidHom.ker ≤
      L.fixingSubgroup := by
    apply (IntermediateField.le_iff_le
      (FiniteEtale.genericAbsoluteGaloisHom X).toMonoidHom.ker L).mp
    apply IntermediateField.adjoin_simple_le_iff.mpr
    apply (IntermediateField.mem_fixedField_iff _ _).mpr
    intro σ hσ
    have hg : FiniteEtale.genericAbsoluteGaloisHom X σ = 1 :=
      MonoidHom.mem_ker.mp hσ
    have hquot : rootQuotient β σ = 1 := by
      rw [← hχ σ, hg, map_one]
      rfl
    have hβfix := (rootQuotient_eq_one_iff β σ).mp hquot
    exact congrArg (fun b : (SeparableClosure X.functionField)ˣ =>
      (b : SeparableClosure X.functionField)) hβfix
  exact ⟨a, β, hβ, hχ,
    (FiniteEtale.genericKernel_le_fixingSubgroup_iff_exists_finiteEtale_genericFiber
      X L).mp hfix⟩

end EtaleFundamentalGroups.Kummer
