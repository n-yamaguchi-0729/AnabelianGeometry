import ProCGroups.Presentations.Profinite
import Mathlib.CategoryTheory.Action.Continuous
import Mathlib.CategoryTheory.Action.Concrete
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.Topology.Algebra.ClopenNhdofOne
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.Topology.Category.FinTopCat

/-!
# Detecting closed normal closures by finite continuous actions

An element belongs to the closed normal subgroup generated by a set exactly
when every finite continuous action on which the generators act trivially
also makes that element act trivially.
-/

noncomputable section

universe u w

open CategoryTheory
open scoped FintypeCatDiscrete

namespace ProCGroups.Presentations

private lemma isClosed_ker_toPermHom
    {G : Type u} {A : Type w}
    [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [TopologicalSpace A] [DiscreteTopology A]
    [MulAction G A] [ContinuousSMul G A] :
    IsClosed ((MulAction.toPermHom G A).ker : Set G) := by
  rw [show ((MulAction.toPermHom G A).ker : Set G) =
      ⋂ x : A, (MulAction.stabilizer G x : Set G) by
    ext g
    simp only [SetLike.mem_coe, MonoidHom.mem_ker, Set.mem_iInter,
      MulAction.mem_stabilizer_iff]
    constructor
    · intro hg x
      exact DFunLike.congr_fun hg x
    · intro hg
      exact Equiv.ext hg]
  exact isClosed_iInter fun x =>
    (MulAction.stabilizer G x).isClosed_of_isOpen
      (stabilizer_isOpen G x)

variable {G : Type u} [Group G] [TopologicalSpace G]
variable [IsTopologicalGroup G] [CompactSpace G]
variable [TotallyDisconnectedSpace G]

/--
Membership in the closed normal closure of `R` is detected by finite
continuous `G`-actions: if every element of `R` fixes every point, then so
does `g`.
-/
theorem Subgroup.mem_closedNormalClosure_iff_fixedBy_finite_continuous_actions
    (R : Set G) (g : G) :
    g ∈ Subgroup.closedNormalClosure R ↔
      ∀ (X : ContAction FintypeCat.{w} G),
        (∀ r ∈ R, ∀ x : X.obj.V, r • x = x) →
          ∀ x : X.obj.V, g • x = x := by
  constructor
  · intro hg X hR x
    let : ContinuousSMul G X.obj.V := X.2
    let ρ := MulAction.toPermHom G X.obj.V
    have hRker : R ⊆ ρ.ker := by
      intro r hr
      change ρ r = 1
      apply Equiv.ext
      exact hR r hr
    have hle : Subgroup.closedNormalClosure R ≤ ρ.ker :=
      closedNormalClosure_le_closed_normal
        (isClosed_ker_toPermHom (G := G) (A := X.obj.V)) hRker
    have hgker : g ∈ ρ.ker := hle hg
    change ρ g = 1 at hgker
    exact DFunLike.congr_fun hgker x
  · intro hfix
    by_contra hg
    let N : ClosedSubgroup G :=
      { toSubgroup := Subgroup.closedNormalClosure R
        isClosed' := closedNormalClosure_isClosed R }
    have hg' :
        g ∉ sInf {U : Subgroup G |
          IsOpen (U : Set G) ∧ N.toSubgroup ≤ U} := by
      rwa [← ProfiniteGrp.closedSubgroup_eq_sInf_open N]
    rw [Subgroup.mem_sInf] at hg'
    push Not at hg'
    obtain ⟨U, ⟨hUopen, hNU⟩, hgU⟩ := hg'
    let : Finite (G ⧸ U) :=
      Subgroup.quotient_finite_of_isOpen U hUopen
    let hex := Finite.exists_equiv_fin (G ⧸ U)
    let n : ℕ := hex.choose
    let qEquiv : (G ⧸ U) ≃ Fin n :=
      Classical.choice hex.choose_spec
    let A := ULift.{w} (Fin n)
    let e : A ≃ (G ⧸ U) := Equiv.ulift.trans qEquiv.symm
    let : MulAction G A := e.mulAction G
    let : TopologicalSpace A := ⊥
    let : DiscreteTopology A := ⟨rfl⟩
    have stabilizer_eq (i : A) :
        MulAction.stabilizer G i =
          MulAction.stabilizer G (e i) := by
      ext a
      simp only [MulAction.mem_stabilizer_iff, Equiv.smul_def,
        Equiv.symm_apply_eq]
    let Y : ContAction FintypeCat.{w} G := by
      refine ⟨Action.FintypeCat.ofMulAction G (FintypeCat.of A), ?_⟩
      exact (by
        rw [continuousSMul_iff_stabilizer_isOpen]
        intro i
        rw [stabilizer_eq i]
        obtain ⟨a, ha⟩ :=
          MulAction.exists_smul_eq G
            (((1 : G) : G ⧸ U)) (e i)
        rw [← ha, MulAction.stabilizer_smul_eq_stabilizer_map_conj,
          MulAction.stabilizer_quotient, Subgroup.coe_map]
        change IsOpen ((fun x : G => a * x * a⁻¹) '' (U : Set G))
        simpa only [Set.image_image] using
          isOpenMap_mul_right a⁻¹ _
            (isOpenMap_mul_left a _ hUopen)
        : ContinuousSMul G A)
    have hNker :
        Subgroup.closedNormalClosure R ≤
          (MulAction.toPermHom G (G ⧸ U)).ker := by
      rw [← Subgroup.normalCore_eq_ker U]
      exact Subgroup.normal_le_normalCore.mpr hNU
    have hRfix : ∀ r ∈ R, ∀ x : Y.obj.V, r • x = x := by
      change ∀ r ∈ R, ∀ x : A, r • x = x
      intro r hr x
      apply e.injective
      rw [Equiv.smul_def, e.apply_symm_apply]
      have hrN : r ∈ Subgroup.closedNormalClosure R :=
        subset_closedNormalClosure R hr
      have hrker := hNker hrN
      change MulAction.toPermHom G (G ⧸ U) r = 1 at hrker
      exact DFunLike.congr_fun hrker (e x)
    have hgfix := hfix Y hRfix
    change ∀ x : A, g • x = x at hgfix
    have hgker : g ∈ (MulAction.toPermHom G (G ⧸ U)).ker := by
      change MulAction.toPermHom G (G ⧸ U) g = 1
      apply Equiv.ext
      intro q
      change g • q = q
      let x : A := e.symm q
      have hx := hgfix x
      have heq := congrArg e hx
      simpa only [Equiv.smul_def, e.apply_symm_apply, x] using heq
    apply hgU
    exact U.normalCore_le (by
      rwa [Subgroup.normalCore_eq_ker U])

end ProCGroups.Presentations
