import Mathlib.FieldTheory.Galois.GaloisClosure
import Mathlib.FieldTheory.IsSepClosed
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Finite Galois radicals inside the prescribed separable closure

The finite field is the normal closure of the field generated by an actual
root. A separate integral-closure owner constructs the integral radical from
its equation, without mixing the ambient separable closure or prime
localization into that construction.

Reference: Stacks Project, Tag 0BUB.
https://stacks.math.columbia.edu/tag/0BUB
-/

noncomputable section

namespace EtaleFundamentalGroups.Inertia

universe u v

/-- An actual prime-to-characteristic radical lies in a concrete finite
Galois subextension of the prescribed separable closure. -/
theorem exists_finiteGalois_radical
    (K : Type u) (Ω : Type v) [Field K] [Field Ω]
    [Algebra K Ω] [IsSepClosure K Ω]
    (n : ℕ) (hn : (n : K) ≠ 0) (a : K) :
    ∃ (E : FiniteGaloisIntermediateField K Ω) (β : E),
      β ^ n = algebraMap K E a := by
  have hnΩ : (n : Ω) ≠ 0 := by
    rw [← map_natCast (algebraMap K Ω), map_ne_zero_iff _ (algebraMap K Ω).injective]
    exact hn
  have : NeZero (n : Ω) := ⟨hnΩ⟩
  have : IsSepClosed Ω := IsSepClosure.sep_closed K
  obtain ⟨α, hα⟩ := IsSepClosed.exists_pow_nat_eq (algebraMap K Ω a) n
  let E : FiniteGaloisIntermediateField K Ω :=
    FiniteGaloisIntermediateField.adjoin K ({α} : Set Ω)
  let β : E := ⟨α, FiniteGaloisIntermediateField.subset_adjoin K ({α} : Set Ω)
    (Set.mem_singleton α)⟩
  refine ⟨E, β, ?_⟩
  apply Subtype.ext
  exact hα

/-- A concrete radical over the base ring belongs to its literal integral
closure, and its power equation survives there. This supplier needs no
fraction field, prime, or residue-field structure. -/
theorem exists_integralClosure_radical_of_pow_eq
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    (n : ℕ) (hn : 0 < n) (a : A) (β : B)
    (hβ : β ^ n = algebraMap A B a) :
    ∃ γ : integralClosure A B,
      (γ : B) = β ∧ γ ^ n = algebraMap A (integralClosure A B) a := by
  have hβintegral : IsIntegral A β :=
    IsIntegral.of_pow hn (hβ.symm ▸ isIntegral_algebraMap)
  let γ : integralClosure A B := ⟨β, hβintegral⟩
  exact ⟨γ, rfl, Subtype.ext hβ⟩

end EtaleFundamentalGroups.Inertia

end
