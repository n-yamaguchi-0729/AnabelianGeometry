import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
import Mathlib.AlgebraicGeometry.Morphisms.Affine
import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
import Mathlib.AlgebraicGeometry.Morphisms.QuasiSeparated
import Mathlib.AlgebraicGeometry.Morphisms.Separated
import Mathlib.AlgebraicGeometry.Pullbacks
import Mathlib.CategoryTheory.Adjunction.Limits
import Mathlib.CategoryTheory.Comma.Over.Basic
import Mathlib.CategoryTheory.Comma.Over.Pullback
import Mathlib.CategoryTheory.Limits.Constructions.Over.Connected
import Mathlib.CategoryTheory.Limits.Opposites
import EtaleFundamentalGroups.GenericTensor.FilteredColimit.IntermediateFieldDiagram

/-!
# Constant-field base changes as an inverse limit

For any field extension, the base change of a scheme is the inverse limit of
its base changes by the intermediate fields generated by finite coefficient
sets. The transition maps are affine, and the stages inherit quasi-compactness
and quasi-separatedness from the original scheme. For algebraic extensions,
these intermediate fields are finite-dimensional.
-/

noncomputable section
universe u
open CategoryTheory Limits Opposite AlgebraicGeometry
namespace EtaleFundamentalGroups
variable (k L : Type u) [Field k] [Field L] [Algebra k L]

private def coefficientSpecFunctor :
    (Under (CommRingCat.of k))ᵒᵖ ⥤ Over (Spec (CommRingCat.of k)) :=
  (Over.opEquivOpUnder (CommRingCat.of k)).inverse ⋙ Over.post Scheme.Spec

/-- The actual constant-field base changes, together with their projections to X. -/
def constantFieldInverseLimitOverDiagram (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) : (Finset L)ᵒᵖ ⥤ Over X :=
  (intermediateFieldAdjoinDiagram k L).op ⋙ coefficientSpecFunctor k ⋙ Over.pullback f

/-- The native L point and maps to every finite-coefficient stage over X. -/
def constantFieldInverseLimitOverCone (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    Cone (constantFieldInverseLimitOverDiagram k L X f) :=
  (coefficientSpecFunctor k ⋙ Over.pullback f).mapCone
    (intermediateFieldAdjoinCocone k L).op

/-- Base change to L is the inverse limit in the category over X. -/
def constantFieldInverseLimitOverConeIsLimit (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    IsLimit (constantFieldInverseLimitOverCone k L X f) := by
  let : PreservesLimit (intermediateFieldAdjoinDiagram k L).op (coefficientSpecFunctor k) :=
    inferInstanceAs (PreservesLimit (intermediateFieldAdjoinDiagram k L).op
      ((Over.opEquivOpUnder (CommRingCat.of k)).inverse ⋙ Over.post Scheme.Spec))
  exact isLimitOfPreserves (coefficientSpecFunctor k ⋙ Over.pullback f)
    (intermediateFieldAdjoinCoconeIsColimit k L).op

/-- The underlying actual constant-field base changes indexed by finite coefficients. -/
def constantFieldInverseLimitDiagram (X : Scheme.{u}) (f : X ⟶ Spec (CommRingCat.of k)) :
    (Finset L)ᵒᵖ ⥤ Scheme.{u} :=
  constantFieldInverseLimitOverDiagram k L X f ⋙ Over.forget X

/-- The constant-field stages carry their canonical compatible projections to `X`. -/
def constantFieldInverseLimitProjection (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    constantFieldInverseLimitDiagram k L X f ⟶ (Functor.const (Finset L)ᵒᵖ).obj X :=
  ((Over.forgetCocone X).whisker (constantFieldInverseLimitOverDiagram k L X f)).ι
/-- The underlying native cone whose point is base change to L. -/
def constantFieldInverseLimitCone (X : Scheme.{u}) (f : X ⟶ Spec (CommRingCat.of k)) :
    Cone (constantFieldInverseLimitDiagram k L X f) :=
  (Over.forget X).mapCone (constantFieldInverseLimitOverCone k L X f)

/-- Every component of the inverse-limit cone is a morphism over `X`. -/
theorem constantFieldInverseLimitCone_π_projection (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    (constantFieldInverseLimitCone k L X f).π ≫ constantFieldInverseLimitProjection k L X f =
      (Functor.const (Finset L)ᵒᵖ).map
        (pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k L))) f) := by
  apply NatTrans.ext
  funext s
  exact Over.w ((constantFieldInverseLimitOverCone k L X f).π.app s)
/-- Constant-field base change to L is the actual inverse limit of its stages. -/
def constantFieldInverseLimitConeIsLimit (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    IsLimit (constantFieldInverseLimitCone k L X f) := by
  let : IsConnected (Finset L)ᵒᵖ := IsCofiltered.isConnected _
  exact isLimitOfPreserves (Over.forget X) (constantFieldInverseLimitOverConeIsLimit k L X f)

/-- Every stage is the literal pullback by its finitely generated intermediate field. -/
theorem constantFieldInverseLimitOverDiagram_obj_left (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) (s : (Finset L)ᵒᵖ) :
    ((constantFieldInverseLimitOverDiagram k L X f).obj s).left =
      pullback (Spec.map (CommRingCat.ofHom
        (algebraMap k (IntermediateField.adjoin k (s.unop : Set L))))) f := by
  rfl

/-- The stage projection to X is the literal second pullback projection. -/
theorem constantFieldInverseLimitOverDiagram_obj_hom (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) (s : (Finset L)ᵒᵖ) :
    ((constantFieldInverseLimitOverDiagram k L X f).obj s).hom =
      pullback.snd (Spec.map (CommRingCat.ofHom
        (algebraMap k (IntermediateField.adjoin k (s.unop : Set L))))) f := by
  rfl

/-- The cone point is the literal pullback by L. -/
theorem constantFieldInverseLimitOverCone_pt_left (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    (constantFieldInverseLimitOverCone k L X f).pt.left =
      pullback (Spec.map (CommRingCat.ofHom (algebraMap k L))) f := by
  rfl

/-- The cone point projection to X is the literal second pullback projection. -/
theorem constantFieldInverseLimitOverCone_pt_hom (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) :
    (constantFieldInverseLimitOverCone k L X f).pt.hom =
      pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k L))) f := by
  rfl

/-- The constant-field inverse system has affine transition maps. -/
theorem constantFieldInverseLimitDiagram_map_isAffineHom (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k))
    {i j : (Finset L)ᵒᵖ} (g : i ⟶ j) :
    IsAffineHom ((constantFieldInverseLimitDiagram k L X f).map g) := by
  let D := constantFieldInverseLimitOverDiagram k L X f
  have hi : IsAffineHom (D.obj i).hom := by
    change IsAffineHom ((constantFieldInverseLimitOverDiagram k L X f).obj i).hom
    rw [constantFieldInverseLimitOverDiagram_obj_hom]
    exact MorphismProperty.pullback_snd
      (P := (show MorphismProperty Scheme.{u} from @IsAffineHom)) _ _ inferInstance
  have hj : IsAffineHom (D.obj j).hom := by
    change IsAffineHom ((constantFieldInverseLimitOverDiagram k L X f).obj j).hom
    rw [constantFieldInverseLimitOverDiagram_obj_hom]
    exact MorphismProperty.pullback_snd
      (P := (show MorphismProperty Scheme.{u} from @IsAffineHom)) _ _ inferInstance
  have : IsAffineHom ((D.map g).left ≫ (D.obj j).hom) := by
    rw [Over.w]
    exact hi
  change IsAffineHom (D.map g).left
  exact IsAffineHom.of_comp _ (D.obj j).hom

/-- Constant-field stages of a quasi-compact scheme are quasi-compact. -/
theorem constantFieldInverseLimitDiagram_obj_compactSpace (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) [CompactSpace X]
    (s : (Finset L)ᵒᵖ) :
    CompactSpace ((constantFieldInverseLimitDiagram k L X f).obj s) := by
  change CompactSpace ((constantFieldInverseLimitOverDiagram k L X f).obj s).left
  rw [constantFieldInverseLimitOverDiagram_obj_left]
  let g := Spec.map (CommRingCat.ofHom
    (algebraMap k (IntermediateField.adjoin k (s.unop : Set L))))
  let : IsAffineHom (pullback.snd g f) :=
    MorphismProperty.pullback_snd
      (P := (show MorphismProperty Scheme.{u} from @IsAffineHom)) g f inferInstance
  exact QuasiCompact.compactSpace_of_compactSpace (pullback.snd g f)

/-- Constant-field stages of a quasi-separated scheme are quasi-separated. -/
theorem constantFieldInverseLimitDiagram_obj_quasiSeparatedSpace (X : Scheme.{u})
    (f : X ⟶ Spec (CommRingCat.of k)) [QuasiSeparatedSpace X]
    (s : (Finset L)ᵒᵖ) :
    QuasiSeparatedSpace ((constantFieldInverseLimitDiagram k L X f).obj s) := by
  change QuasiSeparatedSpace ((constantFieldInverseLimitOverDiagram k L X f).obj s).left
  rw [constantFieldInverseLimitOverDiagram_obj_left]
  let g := Spec.map (CommRingCat.ofHom
    (algebraMap k (IntermediateField.adjoin k (s.unop : Set L))))
  let : IsAffineHom (pullback.snd g f) :=
    MorphismProperty.pullback_snd
      (P := (show MorphismProperty Scheme.{u} from @IsAffineHom)) g f inferInstance
  exact quasiSeparatedSpace_of_quasiSeparated (pullback.snd g f)

/-- The cone maps preserve the coefficient projection along the literal field inclusion. -/
theorem constantFieldInverseLimitCone_π_app_fst
    (X : Scheme.{u}) (f : X ⟶ Spec (CommRingCat.of k)) (s : Finset L) :
    (constantFieldInverseLimitCone k L X f).π.app (op s) ≫
        pullback.fst (Spec.map (CommRingCat.ofHom
          (algebraMap k (IntermediateField.adjoin k (s : Set L))))) f =
      pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k L))) f ≫
        Spec.map (CommRingCat.ofHom
          (IntermediateField.adjoin k (s : Set L)).val.toRingHom) := by
  exact pullback.lift_fst _ _ _

end EtaleFundamentalGroups
