import Mathlib.Algebra.Module.Torsion.Basic

/-!
# The first relation module of a finite list of generators

For elements `f i : R`, this file packages the elementary degree-one
Koszul relation module

`{x | f i • x j = f j • x i} / {i ↦ f i • m}`.

Its key property is that it is annihilated by the ideal generated by the
`f i`.  This is the finite-generator calculation used when clearing
denominators in formal gluing.
-/

noncomputable section

namespace EtaleFundamentalGroups

universe u v w

variable {R : Type u} [CommRing R]
variable {ι : Type v}
variable (f : ι → R)
variable (M : Type w) [AddCommGroup M] [Module R M]

/-- Tuples satisfying the degree-one Koszul relations for `f`. -/
def generatorRelationCycles : Submodule R (ι → M) where
  carrier := {x | ∀ i j, f i • x j = f j • x i}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy i j
    simp only [Pi.add_apply, smul_add, hx i j, hy i j]
  smul_mem' := by
    intro r x hx i j
    calc
      f i • (r • x j) = r • (f i • x j) := smul_comm _ _ _
      _ = r • (f j • x i) := congrArg (r • ·) (hx i j)
      _ = f j • (r • x i) := (smul_comm _ _ _).symm

/-- The diagonal boundary `m ↦ (f i • m)ᵢ`, with codomain restricted to
the relation cycles. -/
def generatorRelationBoundary :
    M →ₗ[R] generatorRelationCycles f M where
  toFun m := ⟨fun i ↦ f i • m, by
    intro i j
    rw [← mul_smul, mul_comm, mul_smul]⟩
  map_add' x y := by
    ext i
    simp
  map_smul' r x := by
    ext i
    exact smul_comm _ _ _

/-- The first generator-relation module. -/
abbrev GeneratorRelationHOne :=
  generatorRelationCycles f M ⧸ LinearMap.range (generatorRelationBoundary f M)

/-- The ideal generated by `f` annihilates the first relation module. -/
theorem generatorRelationHOne_isTorsionBySet :
    Module.IsTorsionBySet R (GeneratorRelationHOne f M)
      (Ideal.span (Set.range f)) := by
  rw [← Module.isTorsionBySet_iff_is_torsion_by_span]
  intro q r
  obtain ⟨i, hi⟩ := r.2
  change r.1 • q = 0
  rw [← hi]
  induction q using Quotient.inductionOn' with
  | _ x =>
      rw [Submodule.Quotient.mk''_eq_mk,
        ← Submodule.Quotient.mk_smul,
        Submodule.Quotient.mk_eq_zero]
      refine ⟨x.1 i, ?_⟩
      apply Subtype.ext
      funext j
      exact (x.2 i j).symm

end EtaleFundamentalGroups

end
