theorem _root_.AlgebraicGeometry.SmoothProperCurve.exists_twoAffineOpenCover_of_section
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    {C : Scheme.{u}} (c : C ⟶ Spec (CommRingCat.of R)) [IsProper c]
    [SmoothOfRelativeDimension 1 c] [GeometricallyIntegral c]
    (ε : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) c) :
    ∃ 𝒱 : C.TwoAffineOpenCover,
      Set.range ε.1.base ⊆ (𝒱.U0 : Set C) ∧ (𝒱.U1 : Set C) = (Set.range ε.1.base)ᶜ := by
  obtain ⟨m, hm, s, hs⟩ := exists_section_invModule_pow_ker_disjoint R c ε
  obtain ⟨U, V, hcov, hU, f, g, hUVf, hUVg, hfg, -, htrU, htrV⟩ :=
    exists_twoChartPoleDatum_of_section_invModule R c ε m hm s hs
  have hUaff : IsAffineOpen U :=
    (Scheme.Opens.isAffineOpen_and_finite_aeval_of_twoChart c U V f g hcov hUVg hfg htrU).1
  have hVaff : IsAffineOpen V :=
    (Scheme.Opens.isAffineOpen_and_finite_aeval_of_twoChart_right c U V f g hcov hUVf hfg htrV).1
  refine ⟨{ U0 := V, U1 := U, isAffineOpen_U0 := hVaff, isAffineOpen_U1 := hUaff,
            sup_eq_top := by rw [sup_comm]; exact hcov,
            isAffineOpen_inf := by rw [inf_comm, hUVf]; exact hUaff.basicOpen f }, ?_, ?_⟩
  · rintro x hx
    have hxU : x ∉ U := fun h => (hU x).mp h hx
    have hxUV : x ∈ U ⊔ V := by rw [hcov]; exact trivial
    rcases (TopologicalSpace.Opens.mem_sup.mp hxUV) with h | h
    · exact absurd h hxU
    · exact h
  · ext x
    simp only [SetLike.mem_coe, Set.mem_compl_iff]
    exact hU x
end AlgebraicCurves.Geometry.Curves.Proofs.SmoothProperCurve_exists_twoAffineOpenCover_of_section
