open IntermediateField Algebra

theorem _root_.AlgebraicCurve.isCurveOver_iff_exists_transcendental_finiteDimensional {K : Type*}
  {F : Type*} [Field K] [Field F] [Algebra K F]
    [PerfectField K] [Algebra.EssFiniteType K F] :
    AlgebraicCurve.IsCurveOver K F ↔ ∃ t : F, Transcendental K t ∧ FiniteDimensional K⟮t⟯ F ∧
      Algebra.IsSeparable K⟮t⟯ F := by
  constructor
  · intro h
    exact AlgebraicCurve.IsCurveOver.exists_separating_transcendental
  · rintro ⟨t, htr, hfd, hsep⟩
    exact AlgebraicCurve.isCurveOver_of_transcendental htr hfd hsep
end AlgebraicCurves.FunctionFields.Proofs.IsCurveOverIffExists
